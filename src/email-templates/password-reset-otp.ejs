<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Password Reset Code</title>
</head>

<body
    style="
        margin: 0;
        padding: 0;
        background-color: #f3f6fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1d2939;
    "
>
    <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        role="presentation"
        style="background-color: #f3f6fb; padding: 30px 15px;"
    >
        <tr>
            <td align="center">

                <table
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    role="presentation"
                    style="
                        max-width: 580px;
                        background-color: #ffffff;
                        border-radius: 14px;
                        overflow: hidden;
                        box-shadow: 0 8px 25px rgba(16, 24, 40, 0.08);
                    "
                >
                    <!-- Header -->
                    <tr>
                        <td
                            style="
                                background-color: #101828;
                                padding: 28px 35px;
                                text-align: center;
                            "
                        >
                            <h1
                                style="
                                    margin: 0;
                                    color: #ffffff;
                                    font-size: 25px;
                                "
                            >
                                Watch Team
                            </h1>

                            <p
                                style="
                                    margin: 7px 0 0;
                                    color: #d0d5dd;
                                    font-size: 14px;
                                "
                            >
                                Password Reset Verification
                            </p>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td
                            style="
                                padding: 38px 35px;
                                text-align: center;
                            "
                        >
                            <h2
                                style="
                                    margin: 0 0 18px;
                                    font-size: 22px;
                                    color: #101828;
                                "
                            >
                                Reset your password
                            </h2>

                            <p
                                style="
                                    margin: 0 0 10px;
                                    font-size: 16px;
                                    line-height: 1.6;
                                "
                            >
                                Hello
                                <strong>
                                    <%= recipientName || "Watch Team User" %>
                                </strong>,
                            </p>

                            <p
                                style="
                                    margin: 0 auto 25px;
                                    max-width: 440px;
                                    font-size: 15px;
                                    line-height: 1.7;
                                    color: #475467;
                                "
                            >
                                Use the verification code below to continue
                                resetting your Watch Team password.
                            </p>

                            <div
                                style="
                                    display: inline-block;
                                    min-width: 220px;
                                    padding: 20px 28px;
                                    background-color: #f2f4f7;
                                    border: 1px solid #d0d5dd;
                                    border-radius: 12px;
                                    font-size: 34px;
                                    font-weight: bold;
                                    letter-spacing: 10px;
                                    color: #175cd3;
                                "
                            >
                                <%= otp %>
                            </div>

                            <p
                                style="
                                    margin: 24px 0 8px;
                                    color: #475467;
                                    font-size: 14px;
                                "
                            >
                                This code expires in
                                <strong>
                                    <%= expiresInMinutes %> minutes
                                </strong>.
                            </p>

                            <div
                                style="
                                    margin-top: 27px;
                                    padding: 16px;
                                    background-color: #fff6ed;
                                    border: 1px solid #fedf89;
                                    border-radius: 8px;
                                    text-align: left;
                                "
                            >
                                <p
                                    style="
                                        margin: 0;
                                        color: #93370d;
                                        font-size: 13px;
                                        line-height: 1.6;
                                    "
                                >
                                    Never share this code with anyone.
                                    Watch Team administrators will never ask
                                    you to provide your verification code.
                                </p>
                            </div>

                            <p
                                style="
                                    margin: 27px 0 0;
                                    color: #667085;
                                    font-size: 13px;
                                    line-height: 1.6;
                                "
                            >
                                If you did not request a password reset,
                                you can safely ignore this email.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td
                            style="
                                padding: 22px 35px;
                                background-color: #f9fafb;
                                border-top: 1px solid #eaecf0;
                                text-align: center;
                            "
                        >
                            <p
                                style="
                                    margin: 0 0 6px;
                                    color: #667085;
                                    font-size: 13px;
                                "
                            >
                                This is an automated security message from
                                Watch Team.
                            </p>

                            <p
                                style="
                                    margin: 0;
                                    color: #98a2b3;
                                    font-size: 12px;
                                "
                            >
                                © <%= currentYear %> Watch Team.
                                All rights reserved.
                            </p>

                            <p
                                style="
                                    margin: 8px 0 0;
                                    font-size: 12px;
                                "
                            >
                                <a
                                    href="mailto:<%= supportEmail %>"
                                    style="
                                        color: #175cd3;
                                        text-decoration: none;
                                    "
                                >
                                    <%= supportEmail %>
                                </a>
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>