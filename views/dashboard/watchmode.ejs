<%- include("../includes/header", { user: userInfo }); -%>

<div class="main-content app-content">
  <div class="container-fluid">

    <div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h1 class="page-title fw-medium fs-18 mb-2">WatchMode</h1>
        <nav>
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="javascript:void(0);">Operations</a></li>
            <li class="breadcrumb-item active" aria-current="page">Live Video Feeds</li>
          </ol>
        </nav>
      </div>
    </div>

    <div class="card custom-card">
      <div class="card-header">
        <div>
          <h5 class="card-title mb-1">
            <i class="ri-video-line me-1 text-primary"></i> WatchMode Video Feeds
          </h5>
          <small class="text-muted">
            Videos submitted by guards without requiring post-site check-in.
          </small>
        </div>
      </div>

      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover align-middle text-nowrap">
            <thead>
              <tr>
                <th>Guard Name</th>
                <th>Time & Date</th>
                <th>Note</th>
                <th>Status</th>
                <th class="text-end">View</th>
              </tr>
            </thead>

            <tbody>
              <% if (watchModes && watchModes.length > 0) { %>
                <% watchModes.forEach(function(item, index){ %>
                  <tr>
                    <td><%= item.guardName || "Guard" %></td>

                    <td>
                      <%= item.createdAt ? new Date(item.createdAt).toLocaleString() : "N/A" %>
                    </td>

                    <td>
                      <%= item.note ? item.note.substring(0, 70) : "No note" %>
                    </td>

                    <td>
                      <% if (item.status === "Reviewed") { %>
                        <span class="badge bg-success">Reviewed</span>
                      <% } else { %>
                        <span class="badge bg-warning">Submitted</span>
                      <% } %>
                    </td>

                    <td class="text-end">
                      <button
                        type="button"
                        class="btn btn-sm btn-light watchmode-view-btn"
                        data-index="<%= index %>">
                        <i class="ri-eye-line"></i>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-5 text-muted">
                    <i class="ri-video-line" style="font-size:45px;"></i>
                    <h6 class="mt-2">No WatchMode Videos Found</h6>
                    <p class="mb-0">Videos submitted from the mobile app will appear here.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<div class="modal fade" id="watchModeVideoModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="watchModeModalTitle">WatchMode Video</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <video
          id="watchModeVideoPlayer"
          controls
          style="width:100%; max-height:500px; background:#000;">
        </video>

        <div class="mt-3">
          <strong>Guard:</strong> <span id="watchModeGuardName"></span><br>
          <strong>Date:</strong> <span id="watchModeDate"></span><br>
          <strong>Note:</strong>
          <p id="watchModeNote" class="mb-0 text-muted"></p>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  window.watchModeData = <%- JSON.stringify(watchModes || []) %>;

  document.addEventListener("DOMContentLoaded", function () {
    const modalEl = document.getElementById("watchModeVideoModal");
    const video = document.getElementById("watchModeVideoPlayer");

    document.querySelectorAll(".watchmode-view-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const index = this.getAttribute("data-index");
        const item = window.watchModeData[index];

        document.getElementById("watchModeModalTitle").innerText = "WatchMode Video";
        document.getElementById("watchModeGuardName").innerText = item.guardName || "Guard";
        document.getElementById("watchModeDate").innerText =
          item.createdAt ? new Date(item.createdAt).toLocaleString() : "N/A";
        document.getElementById("watchModeNote").innerText = item.note || "No note added.";

        video.src = item.videoUrl;
        video.load();

        new bootstrap.Modal(modalEl).show();
      });
    });

    modalEl.addEventListener("hidden.bs.modal", function () {
      video.pause();
      video.removeAttribute("src");
      video.load();
    });
  });
</script>

