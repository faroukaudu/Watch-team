<%- include("../includes/header", {user:userInfo}); -%>

<!-- Toastify CSS -->
<link rel="stylesheet" href="../../public/assets/libs/toastify-js/src/toastify.css">

<!-- Prism CSS -->
<link rel="stylesheet" href="../../public/assets/libs/prismjs/themes/prism-coy.min.css">

<% if (success) { %>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toastEl = document.getElementById('solid-successToast');
        const toast = new bootstrap.Toast(toastEl);
        toast.show();
    });
</script>
<% } %>

<% if (upgradeMessage) { %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        Swal.fire({
            icon: "info",
            title: "Plan Limit Reached",
            text: <%- JSON.stringify(upgradeMessage) %>,
            showCancelButton: true,
            confirmButtonText: "Upgrade Plan",
            cancelButtonText: "Cancel",
            allowOutsideClick: false
        }).then(function (result) {
            if (result.isConfirmed) {
                window.location.href = "/pricing";
            }
        });
    });
</script>
<% } %>


    <!-- Start::app-content -->
    <div class="main-content app-content">
        <div class="container-fluid">

            <!-- Start::page-header -->
            <div class="d-flex align-items-center justify-content-between my-3 page-header-breadcrumb flex-wrap gap-2">
                <div>
                    <div>
                        <h1 class="page-title fw-medium fs-18 mb-2">Back Office User</h1>
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/dashboard">
                                    Dashboard
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Back Office User</li>
                        </ol>
                    </div>
                </div>
                <!-- <p>oidne</p> -->

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2 flex-wrap">

                        <% if (maxBackOfficeUsers === -1) { %>
                            <span class="badge bg-success-transparent fs-12 px-3 py-2">
                                Back Office Users:
                                <strong><%= allUsers.length %> / Unlimited</strong>
                            </span>
                        <% } else { %>
                            <span class="badge <%= backOfficeLimitReached ? 'bg-danger-transparent' : 'bg-primary-transparent' %> fs-12 px-3 py-2">
                                Back Office Users:
                                <strong>
                                    <%= allUsers.length %> / <%= maxBackOfficeUsers %>
                                </strong>
                                &nbsp;—&nbsp;
                                <%= backOfficeUsersLeft %> remaining
                            </span>
                        <% } %>

                        <div class="position-relative">
                            <% if (backOfficeLimitReached) { %>
                                <button
                                    type="button"
                                    id="backOfficeUpgradeButton"
                                    class="small-space btn btn-secondary btn-wave"
                                >
                                    New User <i class="ri-user-add-fill ms-1"></i>
                                </button>
                            <% } else { %>
                                <a
                                    href="/new-bo-user"
                                    class="small-space btn btn-secondary btn-wave"
                                >
                                    New User <i class="ri-user-add-fill ms-1"></i>
                                </a>
                            <% } %>
                            <!-- <button class="btn btn-outline-primary btn-wave" type="button"
                                id="dropdownMenuClickableInside" data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                aria-expanded="false">
                                Filter By <i class="ri-filter-line ms-1"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuClickableInside">
                                <li><a class="dropdown-item" href="javascript:void(0);">Active</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Inactive</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Archive</a></li>

                            </ul> -->
                        </div>
                        <!-- <div class="dropdown ">
                            <a aria-label="anchor" href="javascript:void(0);"
                                class="btn btn-primary  btn-icon btn-sm text-muted" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                <i class="fe fe-more-vertical"></i>
                            </a>
                            <ul class="dropdown-menu" role="menu">
                                <li class=""><a class="dropdown-item" href="javascript:void(0);"><i
                                            class="ti ti-upload"></i> &nbsp; import</a></li>
                                <li class=""><a class="dropdown-item" href="javascript:void(0);"><i
                                            class="far fa-file-excel"></i> &nbsp; Export Excel</a></li>
                                <li class=""><a class="dropdown-item" href="javascript:void(0);"><i
                                            class="far fa-file-pdf"></i> &nbsp; &nbsp;Export PDF</a>
                                </li>

                            </ul>
                        </div> -->
                        <!-- <button class="btn btn-secondary btn-icon btn-wave" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Download">
                                <i class="ti ti-download"></i>
                            </button>
                            <button class="btn btn-success btn-icon btn-wave" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Share">
                                <i class="ti ti-share-3"></i>
                            </button> -->
                    </div>
                </div>
            </div>
            <div class="toast-container position-fixed top-0 end-0 p-3">
                    <div id="solid-successToast" class="toast colored-toast bg-success text-fixed-white" role="alert" aria-live="assertive"
                        aria-atomic="true">
                        <div class="toast-header bg-success text-fixed-white">
                            <img class="bd-placeholder-img rounded me-2" src="../assets/images/brand-logos/toggle-dark.png" alt="...">
                            <em class="me-auto">New Backoffice User Added!</em>
                            <button type="button" class="btn-close" data-bs-dismiss="toast"
                                aria-label="Close"></button>
                        </div>
                        <!-- <div class="toast-body">
                            Client Added Successfully...
                        </div> -->
                    </div>

                </div>
            <!-- End::page-header -->

            <!-- Start:: row-1 -->
            <div class="row">

                <!-- MAP -->

                <!-- MAP END -->
                <!-- Latest Activity -->
                <div class="col-xxl-12 col-lg-12 col-sm-6">
                    <div class="card custom-card">
                        <div class="card-header  justify-content-between">
                            <div class="card-title" style="font-size: large;">
                                Back Office Users
                            </div>
                            <!-- <a href="javascript:void(0);" class="fs-12 text-muted fw-medium bg-light rounded p-1" > View All<i class="ti ti-arrow-narrow-right ms-1"></i> </a> -->
                        </div>
                        <div class="table-responsive">
                            <table class="table text-nowrap">
                                <thead>
                                    <tr>
                                        <th scope="col"><input class="form-check-input" type="checkbox"
                                                id="checkboxNoLabel" value="" aria-label="..."></th>
                                        <th scope="col" style="font-weight: 700; font-size: 16px;">Contact Name</th>

                                        <th scope="col" style="font-weight: 700; font-size: 16px;">Email</th>
                                        <th scope="col" style="font-weight: 700; font-size: 16px;">Access Level</th>
                                        <th scope="col" style="font-weight: 700; font-size: 16px;">Last Login</th>
                                        <th scope="col" style="font-weight: 700; font-size: 16px;">Status</th>
                                        <th scope="col" style="font-weight: 700; font-size: 16px;"></th>


                                    </tr>
                                </thead>
                                <tbody>
                                   <% if (allUsers && allUsers.length > 0) { %>
                                    <% allUsers.forEach(function(superUser) { %>
                                    <tr>
                                        <th scope="row"><input class="form-check-input" type="checkbox"
                                                id="checkboxNoLabel1" value="" aria-label="..."></th>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="avatar avatar-xs me-2 online avatar-rounded">
                                                    <img src="../assets/images/faces/3.jpg" alt="img">
                                                </span><%= superUser.fullname%>
                                            </div>
                                        </td>
                                        <td><%=superUser.email%></td>

                                        <td><%= superUser.userType%></td>
                                   
                                            <% if(superUser.lastLogin){ %>
                                                <td><%= timeAgo(superUser.lastLogin)%></td>
                                            <% }else{ %>
                                                <td>Not Logged in yet</td>
                                            <% } %>
                                       
                                        <% if(superUser.status == true){ %>
                                            <td><span class="badge bg-success-transparent">Active</span></td>
                                        <% }else{ %>
                                            <td><span class="badge bg-danger-transparent">Inactive</span></td>
                                        <% } %>

                                       

                                    </tr>
                                   <% }) %>
                                  <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-5 text-muted">
                                            No Back Office Users found.
                                        </td>
                                    </tr>
                                   <% } %>


                                    
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>



            </div>
            <!-- End:: row-1 -->

        </div>
    </div>
    <!-- End::app-content -->


    <% if (backOfficeLimitReached) { %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const upgradeButton =
                document.getElementById("backOfficeUpgradeButton");

            if (!upgradeButton) return;

            upgradeButton.addEventListener("click", function () {
                Swal.fire({
                    icon: "info",
                    title: "Plan Limit Reached",
                    text:
                        "Your current plan allows only " +
                        <%- JSON.stringify(maxBackOfficeUsers) %> +
                        " Back Office User account(s). Upgrade your plan to add more.",
                    showCancelButton: true,
                    confirmButtonText: "Upgrade Plan",
                    cancelButtonText: "Cancel"
                }).then(function (result) {
                    if (result.isConfirmed) {
                        window.location.href = "/pricing";
                    }
                });
            });
        });
    </script>
    <% } %>

    <!-- Footer Start -->
    <%- include("../includes/footer"); -%>
        <!-- Footer End -->
        <div class="modal fade" id="header-responsive-search" tabindex="-1" aria-labelledby="header-responsive-search"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-body">
                        <div class="input-group">
                            <input type="text" class="form-control border-end-0" placeholder="Search Anything ..."
                                aria-label="Search Anything ..." aria-describedby="button-addon2">
                            <button class="btn btn-primary" type="button" id="button-addon2"><i
                                    class="bi bi-search"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        </div>


        <!-- Scroll To Top -->
        <div class="scrollToTop">
            <span class="arrow lh-1"><i class="ri-rocket-line align-middle fs-18"></i></span>
        </div>
        <div id="responsive-overlay"></div>
