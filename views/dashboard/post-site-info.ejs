<script>
  document.addEventListener("DOMContentLoaded", function () {
    let activeRecipientTarget = "send";

const sendRecipients =
  <%- JSON.stringify(companyInfo.reportRecipients || []) %>;

const scheduleRecipients =
  <%- JSON.stringify(companyInfo.reportRecipients || []) %>;

    const modalEl = document.getElementById("extraRecipientsModal");
    const fieldsWrapper = document.getElementById("extraRecipientsFields");
    const addFieldBtn = document.getElementById("addRecipientFieldBtn");
    const saveBtn = document.getElementById("saveExtraRecipientsBtn");

    const sendInput = document.getElementById("sendExtraRecipientsInput");
    const scheduleInput = document.getElementById("scheduleExtraRecipientsInput");

    const sendCountText = document.getElementById("sendRecipientCountText");
    const scheduleCountText = document.getElementById("scheduleRecipientCountText");

    function getActiveList() {
      return activeRecipientTarget === "schedule" ? scheduleRecipients : sendRecipients;
    }

    function updateCountText() {
      const sendTotal = 1 + sendRecipients.length;
      const scheduleTotal = 1 + scheduleRecipients.length;

      if (sendCountText) {
        sendCountText.textContent = sendTotal + (sendTotal === 1
          ? " person would receive this report"
          : " people would receive this report");
      }

      if (scheduleCountText) {
        scheduleCountText.textContent = scheduleTotal + (scheduleTotal === 1
          ? " person would receive this scheduled report"
          : " people would receive this scheduled report");
      }

      if (sendInput) sendInput.value = JSON.stringify(sendRecipients);
      if (scheduleInput) scheduleInput.value = JSON.stringify(scheduleRecipients);
    }

    function renderRecipientFields() {
      const list = getActiveList();
      fieldsWrapper.innerHTML = "";

      if (list.length === 0) {
        list.push("");
      }

      list.forEach(function (email, index) {
        const row = document.createElement("div");
        row.className = "input-group mb-2 recipient-row";

        row.innerHTML =
          '<span class="input-group-text">Recipient ' + (index + 1) + '</span>' +
          '<input type="email" class="form-control extra-recipient-email" value="' + email + '" placeholder="Enter recipient email">' +
          '<button type="button" class="btn btn-outline-danger remove-recipient-btn" data-index="' + index + '">' +
            '<i class="ri-delete-bin-line"></i>' +
          '</button>';

        fieldsWrapper.appendChild(row);
      });

      document.querySelectorAll(".remove-recipient-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
          const index = Number(this.getAttribute("data-index"));
          const activeList = getActiveList();

          activeList.splice(index, 1);
          renderRecipientFields();
          updateCountText();
        });
      });
    }

    document.querySelectorAll(".open-extra-recipients-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        activeRecipientTarget = this.getAttribute("data-target-form") || "send";

        renderRecipientFields();

        const modal = new bootstrap.Modal(modalEl);
        modal.show();
      });
    });

    addFieldBtn.addEventListener("click", function () {
      getActiveList().push("");
      renderRecipientFields();
    });

    saveBtn.addEventListener("click", function () {
      const activeList = getActiveList();
      const emails = [];

      document.querySelectorAll(".extra-recipient-email").forEach(function (input) {
        const email = input.value.trim();

        if (email && !emails.includes(email)) {
          emails.push(email);
        }
      });

      if (activeRecipientTarget === "schedule") {
        scheduleRecipients.length = 0;
        emails.forEach(email => scheduleRecipients.push(email));
      } else {
        sendRecipients.length = 0;
        emails.forEach(email => sendRecipients.push(email));
      }

      updateCountText();

      const modalInstance = bootstrap.Modal.getInstance(modalEl);
      modalInstance.hide();
    });

    updateCountText();
  });
</script>



  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const form = document.getElementById("sendReportForm");
      const sendBtn = document.getElementById("sendReportBtn");
      const scheduleBtn = document.getElementById("scheduleReportBtn");

      function showProcessingAlert(message) {
        Swal.fire({
          title: message,
          html: "Please wait while we process your request...",
          timer: 2200,
          timerProgressBar: true,
          allowOutsideClick: false,
          allowEscapeKey: false,
          showConfirmButton: false,
          didOpen: () => {
            Swal.showLoading();
          }
        });
      }

      if (sendBtn) {
        sendBtn.addEventListener("click", function () {
          showProcessingAlert("Sending report...");
        });
      }

      if (scheduleBtn) {
        scheduleBtn.addEventListener("click", function () {
          showProcessingAlert("Scheduling report...");
        });
      }

      const params = new URLSearchParams(window.location.search);
      const success = params.get("success");
      const error = params.get("error");

      if (success === "report_sent") {
        Swal.fire({
          position: "top-end",
          icon: "success",
          title: "Report sent successfully",
          showConfirmButton: false,
          timer: 2500,
          toast: false
        });
      }

      if (success === "report_scheduled") {
        Swal.fire({
          position: "top-end",
          icon: "success",
          title: "Report scheduled successfully",
          showConfirmButton: false,
          timer: 2500,
          toast: false
        });
      }

      if (error === "report_failed") {
        Swal.fire({
          position: "top-end",
          icon: "error",
          title: "Failed to process report",
          text: "Please try again.",
          showConfirmButton: true
        });
      }

      if (success || error) {
        const cleanUrl = window.location.pathname + window.location.hash;
        window.history.replaceState({}, document.title, cleanUrl);
      }
    });
  </script>




  <script>
    const postSiteId = "<%= companyInfo?._id || companyInfo?.id || '' %>";
    const postSiteName = "<%= companyInfo?.siteName || '' %>";
    const companyId = "<%= userInfo?.assignedCompanyID || '' %>";



    async function loadVisitors(dateValue = "") {
      let url = `/api/visitors?companyId=${companyId}&postSiteId=${postSiteId}`;

      if (dateValue) {
        const start = new Date(dateValue);
        const end = new Date(start);
        end.setDate(end.getDate() + 1);

        url += `&startDate=${start.toISOString()}&endDate=${end.toISOString()}`;
      }

      const res = await fetch(url);
      const data = await res.json();

      const container = document.getElementById("visitorsList");
      container.innerHTML = "";

      if (!data.visitors || data.visitors.length === 0) {
        container.innerHTML = `
        <div class="col-12 text-center py-5">
          <i class="ri-user-search-line" style="font-size:50px;color:#8c9097;"></i>
          <h6 class="mt-2">No Visitors Found</h6>
          <p class="text-muted mb-0">No visitor record for the selected date.</p>
        </div>
      `;
        return;
      }

      data.visitors.forEach(v => {
        container.innerHTML += `
        <div class="col-xl-4 col-md-6">
          <div class="card border shadow-sm h-100" onclick='showVisitorModal(${JSON.stringify(v).replace(/'/g, "&apos;")})' style="cursor:pointer;">
            <div class="card-body">
              <h6 class="fw-bold mb-1">${v.visitorName || "Unnamed Visitor"}</h6>
              <p class="text-muted mb-2">${v.purposeOfVisit || "No purpose entered"}</p>
              <span class="badge bg-primary-transparent">${v.sex || "N/A"}</span>
              <span class="badge bg-info-transparent">${v.firstTimeVisiting ? "First Visit" : "Returning"}</span>
              <div class="mt-3 text-muted small">
                <i class="ri-time-line me-1"></i>${new Date(v.visitDateTime).toLocaleString()}
              </div>
            </div>
          </div>
        </div>
      `;
      });
    }

    document.getElementById("visitorDateFilter").addEventListener("change", function () {
      loadVisitors(this.value);
    });

    loadVisitors();
  </script>


