  <!-- Tasks Script -->
  <script>
    function toLocalInput(value) {
      if (!value) return "";
      const date = new Date(value);
      const offset = date.getTimezoneOffset();
      return new Date(date.getTime() - offset * 60000).toISOString().slice(0, 16);
    }

    function addEditTaskSubTask(value = "") {
      const wrapper = document.getElementById("editTaskSubTasks");
      const row = document.createElement("div");
      row.className = "input-group mb-2";
      row.innerHTML = `<input type="text" name="subTasks" class="form-control" value="${safeText(value, "")}"><button type="button" class="btn btn-danger" onclick="this.parentElement.remove()"><i class="ri-delete-bin-line"></i></button>`;
      wrapper.appendChild(row);
    }

    function openTaskEdit(task) {
      document.getElementById("editTaskForm").action = `/update-post-site-task/${task._id}`;
      document.getElementById("editTaskName").value = task.taskName || "";
      document.getElementById("editTaskDescription").value = task.taskDescription || "";
      document.getElementById("editTaskDuration").value = task.maxDuration || "";
      document.getElementById("editTaskStatus").value = task.status || "Active";
      document.getElementById("editTaskType").value = task.taskType || "One-Off";
      document.getElementById("editTaskStart").value = toLocalInput(task.oneOff && task.oneOff.startDateTime);
      document.getElementById("editTaskDue").value = toLocalInput(task.oneOff && task.oneOff.dueDateTime);
      document.getElementById("editRecurringStartTime").value = task.recurring && task.recurring.startTime || "";
      document.getElementById("editRecurringStartingFrom").value = task.recurring && task.recurring.startingFrom ? String(task.recurring.startingFrom).slice(0,10) : "";
      document.getElementById("editRepeatType").value = task.recurring && task.recurring.repeatType || "Daily";
      const selectedIds = (task.assignedGuards || []).map(g => String(g.guardId));
      Array.from(document.getElementById("editTaskGuards").options).forEach(option => { option.selected = selectedIds.includes(option.value.split("&")[0]); });
      const wrapper = document.getElementById("editTaskSubTasks"); wrapper.innerHTML = "";
      (task.subTasks || []).forEach(s => addEditTaskSubTask(s.title || ""));
      if (!(task.subTasks || []).length) addEditTaskSubTask();
      new bootstrap.Modal(document.getElementById("editTaskModal")).show();
    }

    function addSubTaskInput() {
      const wrapper = document.getElementById("subTaskWrapper");

      const div = document.createElement("div");
      div.className = "input-group mb-2";

      div.innerHTML = `
      <input type="text" name="subTasks" class="form-control" placeholder="Enter sub task">
      <button type="button" class="btn btn-danger" onclick="this.parentElement.remove()">
        <i class="ri-delete-bin-line"></i>
      </button>
    `;

      wrapper.appendChild(div);
    }

    function toggleRecurringMode() {
      const toggle = document.getElementById("recurringContinuousToggle");
      const daysBox = document.getElementById("continuousDaysBox");
      const repeatBox = document.getElementById("specificRepeatBox");

      if (toggle.checked) {
        daysBox.style.display = "block";
        repeatBox.style.display = "none";
      } else {
        daysBox.style.display = "none";
        repeatBox.style.display = "block";
      }
    }

    const taskDateFilter = document.getElementById("taskDateFilter");

    if (taskDateFilter) {
      taskDateFilter.addEventListener("change", function () {
        const selectedDate = this.value;
        const rows = document.querySelectorAll(".task-row");

        rows.forEach(row => {
          const rowDate = row.getAttribute("data-date");

          if (!selectedDate || rowDate === selectedDate) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      });
    }
  </script>



