    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const sendButtons = document.querySelectorAll(".send-report-btn");
        const scheduleOpenButtons = document.querySelectorAll(".schedule-report-open-btn");
        const historyButtons = document.querySelectorAll(".schedule-history-btn");

        const modalClientName = document.getElementById("modalClientName");
        const modalClientEmail = document.getElementById("modalClientEmail");

        const scheduleClientName = document.getElementById("scheduleClientName");
        const scheduleClientEmail = document.getElementById("scheduleClientEmail");
        const scheduleReportTitle = document.getElementById("scheduleReportTitle");
        const scheduleFrequency = document.getElementById("scheduleFrequency");
        const scheduleStartDate = document.getElementById("scheduleStartDate");

        const loadReportsByDateBtn = document.getElementById("loadReportsByDateBtn");
        const modalStartDate = document.getElementById("modalStartDate");
        const modalEndDate = document.getElementById("modalEndDate");
        const selectedReportsTags = document.getElementById("selectedReportsTags");
        const selectedReportsEmptyText = document.getElementById("selectedReportsEmptyText");
        const selectedReportIdsInput = document.getElementById("selectedReportIdsInput");
        const selectedFrequencyInput = document.getElementById("selectedFrequencyInput");

        const historyClientNameText = document.getElementById("historyClientNameText");
        const historyClientEmailText = document.getElementById("historyClientEmailText");
        const scheduleHistoryTableBody = document.getElementById("scheduleHistoryTableBody");

        let selectedReports = [];

        function renderSelectedReports() {
          selectedReportsTags.innerHTML = "";

          if (!selectedReports.length) {
            selectedReportsEmptyText.style.display = "block";
            selectedReportIdsInput.value = "";
            return;
          }

          selectedReportsEmptyText.style.display = "none";

          selectedReports.forEach((report) => {
            const tag = document.createElement("div");
            tag.className = "badge bg-primary-transparent d-flex align-items-center gap-2 px-3 py-2";
            tag.innerHTML = `
          <span>${report.title} - ${report.category} - ${report.createdAtText}</span>
          <button type="button" class="btn btn-sm p-0 text-danger remove-report-btn" data-id="${report._id}" style="line-height:1;">
            <i class="ri-close-circle-fill fs-6"></i>
          </button>
        `;
            selectedReportsTags.appendChild(tag);
          });

          selectedReportIdsInput.value = selectedReports.map(r => r._id).join(",");
        }

        selectedReportsTags.addEventListener("click", function (e) {
          const btn = e.target.closest(".remove-report-btn");
          if (!btn) return;

          const id = btn.getAttribute("data-id");
          selectedReports = selectedReports.filter(r => r._id !== id);
          renderSelectedReports();
        });

        sendButtons.forEach((button) => {
          button.addEventListener("click", function () {
            modalClientName.value = this.getAttribute("data-client-name") || "";
            modalClientEmail.value = this.getAttribute("data-client-email") || "";
            selectedFrequencyInput.value = "Manual";
            selectedReports = [];
            renderSelectedReports();
          });
        });

        scheduleOpenButtons.forEach((button) => {
          button.addEventListener("click", function () {
            scheduleClientName.value = this.getAttribute("data-client-name") || "";
            scheduleClientEmail.value = this.getAttribute("data-client-email") || "";
            scheduleReportTitle.value = this.getAttribute("data-saved-title") || "";
            scheduleFrequency.value = this.getAttribute("data-saved-frequency") || "Weekly";
            scheduleStartDate.value = this.getAttribute("data-saved-start-date") || "";
          });
        });

        loadReportsByDateBtn.addEventListener("click", async function () {
          const startDate = modalStartDate.value;
          const endDate = modalEndDate.value;
          const postSiteId = document.querySelector('#sendReportForm input[name="postSiteId"]').value;

          if (!startDate || !endDate) {
            alert("Please select both start date and end date.");
            return;
          }

          try {
            const res = await fetch(`/reports-by-date-range?postSiteId=${encodeURIComponent(postSiteId)}&startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`);
            const data = await res.json();

            if (!data.success) {
              alert(data.message || "Failed to load reports.");
              return;
            }

            selectedReports = data.reports || [];
            renderSelectedReports();
          } catch (err) {
            console.error(err);
            alert("Failed to load reports.");
          }
        });

        function formatCountdown(targetIso) {
          const target = new Date(targetIso).getTime();
          const now = Date.now();
          const diff = target - now;

          if (isNaN(target)) return "Invalid";
          if (diff <= 0) return "Due now";

          const totalSeconds = Math.floor(diff / 1000);
          const days = Math.floor(totalSeconds / 86400);
          const hours = Math.floor((totalSeconds % 86400) / 3600);
          const minutes = Math.floor((totalSeconds % 3600) / 60);
          const seconds = totalSeconds % 60;

          if (days > 0) return `${days}d ${hours}h ${minutes}m ${seconds}s`;
          if (hours > 0) return `${hours}h ${minutes}m ${seconds}s`;
          return `${minutes}m ${seconds}s`;
        }

        function startScheduleCountdowns() {
          const countdownTexts = document.querySelectorAll(".scheduled-countdown-text[data-next-send]");

          function tick() {
            countdownTexts.forEach((el) => {
              const iso = el.getAttribute("data-next-send");
              el.textContent = formatCountdown(iso);
            });
          }

          tick();
          setInterval(tick, 1000);
        }

        historyButtons.forEach((button) => {
          button.addEventListener("click", async function () {
            const clientName = this.getAttribute("data-client-name") || "";
            const clientEmail = this.getAttribute("data-client-email") || "";
            const postSiteId = this.getAttribute("data-post-site-id") || "";

            historyClientNameText.textContent = clientName || "Client";
            historyClientEmailText.textContent = clientEmail || "";
            scheduleHistoryTableBody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">Loading...</td></tr>`;

            try {
              const res = await fetch(`/scheduled-post-site-report-history?postSiteId=${encodeURIComponent(postSiteId)}&clientEmail=${encodeURIComponent(clientEmail)}`);
              const data = await res.json();

              if (!data.success) {
                scheduleHistoryTableBody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">Failed to load history.</td></tr>`;
                return;
              }

              if (!data.logs || !data.logs.length) {
                scheduleHistoryTableBody.innerHTML = `<tr><td colspan="6" class="text-center text-muted">No scheduled history found.</td></tr>`;
                return;
              }

              scheduleHistoryTableBody.innerHTML = data.logs.map((log) => {
                let badgeClass = "bg-secondary-transparent";

                if (log.status === "success") badgeClass = "bg-success-transparent";
                if (log.status === "failed") badgeClass = "bg-danger-transparent";
                if (log.status === "skipped_no_reports") badgeClass = "bg-warning-transparent";

                return `
              <tr>
                <td><span class="badge ${badgeClass}">${log.status}</span></td>
                <td>${log.frequency || "-"}</td>
                <td>${new Date(log.periodStart).toLocaleString()}<br>to<br>${new Date(log.periodEnd).toLocaleString()}</td>
                <td>${log.reportCount ?? 0}</td>
                <td>${log.sentAt ? new Date(log.sentAt).toLocaleString() : "-"}</td>
                <td>${log.errorMessage || "-"}</td>
              </tr>
            `;
              }).join("");
            } catch (err) {
              console.error(err);
              scheduleHistoryTableBody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">Failed to load history.</td></tr>`;
            }
          });
        });

        startScheduleCountdowns();
        refreshScheduleTargets();
        setInterval(refreshScheduleTargets, 10000); // every 10 seconds
      });
    </script>

    <script>
      const urlParams = new URLSearchParams(window.location.search);
      const success = urlParams.get("success");

      if (success === "report_sent") {
        showSuccessPopup("Report sent successfully!");
      }
    </script>
    <!-- refresh -->
    <script>
      async function refreshScheduleTargets() {
        try {
          const postSiteId = "<%= companyInfo?._id || '' %>";
          if (!postSiteId) return;

          const res = await fetch(`/scheduled-post-site-report-status?postSiteId=${encodeURIComponent(postSiteId)}`);
          const data = await res.json();

          if (!data.success || !Array.isArray(data.schedules)) return;

          const byEmail = {};
          data.schedules.forEach((item) => {
            byEmail[String(item.clientEmail).toLowerCase()] = item;
          });

          document.querySelectorAll(".scheduled-countdown-text[data-client-email]").forEach((el) => {
            const email = String(el.getAttribute("data-client-email") || "").toLowerCase();
            const schedule = byEmail[email];

            if (schedule && schedule.nextSendAt) {
              el.setAttribute("data-next-send", new Date(schedule.nextSendAt).toISOString());
            } else {
              el.removeAttribute("data-next-send");
              el.textContent = "Not scheduled";
            }
          });
        } catch (err) {
          console.error("Failed to refresh schedule countdown targets:", err);
        }
      }
    </script>



    <script>
      function showSuccessPopup(message) {
        Swal.fire({
          icon: "success",
          title: "Success",
          text: message,
          confirmButtonColor: "#0d6efd",
          timer: 2000,
          showConfirmButton: false
        });
      }
    </script>

    </body>

    </html>