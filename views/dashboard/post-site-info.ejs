  <script>
    function addChecklistInput() {
      const wrapper = document.getElementById("checklistItemsWrapper");

      const div = document.createElement("div");
      div.className = "input-group mb-2";

      div.innerHTML = `
      <input type="text" name="checklistItems" class="form-control" placeholder="Enter checklist item" required>
      <button type="button" class="btn btn-danger" onclick="this.parentElement.remove()">
        <i class="ri-delete-bin-line"></i>
      </button>
    `;

      wrapper.appendChild(div);
    }

    function openChecklistProgress(item) {
      document.getElementById("checklistProgressTitle").innerText = item.name || "Checklist Progress";

      const guards = item.assignedGuards || [];
      const progress = item.progress || [];
      const items = item.items || [];

      let html = "";

      guards.forEach((guard) => {
        const guardProgress = progress.find(p => p.guardId === guard.guardId) || {};
        const checkedItems = guardProgress.checkedItems || [];

        html += `
        <div class="border rounded p-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <h6 class="fw-bold mb-0">${guard.guardName || "Guard"}</h6>
              <small class="text-muted">${checkedItems.length}/${items.length} completed</small>
            </div>

            ${guardProgress.completed
            ? `<span class="badge bg-success">Completed</span>`
            : `<span class="badge bg-warning">In Progress</span>`
          }
          </div>

          <ul class="list-group">
            ${items.map((i, index) => `
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>${i.text}</span>
                ${checkedItems.includes(index)
              ? `<span class="badge bg-success"><i class="ri-check-line"></i></span>`
              : `<span class="badge bg-light text-dark">Pending</span>`
            }
              </li>
            `).join("")}
          </ul>
        </div>
      `;
      });

      document.getElementById("checklistProgressBody").innerHTML = html;

      new bootstrap.Modal(document.getElementById("checklistProgressModal")).show();
    }

    function addEditChecklistItem(value = "") {
      const wrapper = document.getElementById("editChecklistItems");
      const row = document.createElement("div");
      row.className = "input-group mb-2";
      row.innerHTML = `<input type="text" name="checklistItems" class="form-control" required value="${safeText(value, "")}"><button type="button" class="btn btn-danger" onclick="this.parentElement.remove()"><i class="ri-delete-bin-line"></i></button>`;
      wrapper.appendChild(row);
    }

    function openChecklistEdit(item) {
      document.getElementById("editChecklistId").value = item._id || "";
      document.getElementById("editChecklistName").value = item.name || "";
      document.getElementById("editChecklistDescription").value = item.description || "";
      const guards = document.getElementById("editChecklistGuards");
      const selectedIds = (item.assignedGuards || []).map(g => String(g.guardId));
      Array.from(guards.options).forEach(option => { option.selected = selectedIds.includes(option.value.split("&")[0]); });
      const items = document.getElementById("editChecklistItems");
      items.innerHTML = "";
      (item.items || []).forEach(i => addEditChecklistItem(i.text || ""));
      if (!(item.items || []).length) addEditChecklistItem();
      new bootstrap.Modal(document.getElementById("editChecklistModal")).show();
    }
  </script>


