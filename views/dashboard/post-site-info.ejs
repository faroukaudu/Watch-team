  <div class="modal fade" id="viewTourQrModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h5 class="modal-title" id="tourQrModalTitle">Tour QR Codes</h5>
            <small class="text-muted">Print and place these QR codes at their checkpoint locations.</small>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <div id="tourQrWrapper" class="row g-3"></div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
            <i class="ri-printer-line me-1"></i> Print
          </button>
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="viewTourProgressModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="tourProgressModalTitle">Tour Progress</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body" id="tourProgressWrapper"></div>
      </div>
    </div>
  </div>

  <script>
    window.loadedSiteTours = [];

    function safeText(value, fallback) {
      if (value === null || value === undefined || value === "") return fallback || "";
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    async function loadSiteTours() {
      const tbody = document.getElementById("siteToursTableBody");
      if (!tbody) return;

      tbody.innerHTML = '<tr><td colspan="7" class="text-center py-5 text-muted"><i class="ri-loader-4-line" style="font-size:35px;"></i><p class="mb-0 mt-2">Loading site tours...</p></td></tr>';

      try {
        const url = "/api/site-tours?companyId=" + encodeURIComponent(companyId) + "&postSiteId=" + encodeURIComponent(postSiteId);
        const res = await fetch(url);
        const data = await res.json();

        window.loadedSiteTours = data.tours || [];

        if (!data.tours || data.tours.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="text-center py-5 text-muted"><i class="ri-route-line" style="font-size:45px;"></i><h6 class="mt-2">No Site Tour Found</h6><p class="mb-0">Create the first patrol route for this post site.</p></td></tr>';
          return;
        }

        tbody.innerHTML = "";

        data.tours.forEach(function (tour, index) {
          const checkpoints = tour.checkpoints || [];
          const progress = tour.progress || [];
          let totalScans = 0;
          let activeGuards = [];

          progress.forEach(function (p) {
            const scanned = p.scannedCheckpoints || [];
            totalScans += scanned.length;

            if (p.status === "In Progress") {
              activeGuards.push(p.guardName || "Guard");
            }
          });

          const checkpointCount = checkpoints.length;
          const guardCount = progress.length;
          const expectedTotal = checkpointCount * (guardCount || 1);
          const progressPercent = checkpointCount > 0 && guardCount > 0
            ? Math.min(100, Math.round((totalScans / expectedTotal) * 100))
            : 0;

          const statusBadge = progressPercent >= 100
            ? '<span class="badge bg-success">Completed</span>'
            : progressPercent > 0
              ? '<span class="badge bg-warning">In Progress</span>'
              : '<span class="badge bg-secondary">Not Started</span>';

          const activeGuardText = activeGuards.length > 0
            ? activeGuards.map(function (g) {
              return '<span class="badge bg-info-transparent me-1">' + safeText(g, "Guard") + '</span>';
            }).join("")
            : '<span class="text-muted">No active guard</span>';

          const createdDate = tour.createdAt ? new Date(tour.createdAt).toLocaleString() : "N/A";
          const row = document.createElement("tr");

          row.innerHTML =
            '<td>' +
            '<div class="fw-semibold">' + safeText(tour.tourName, "Site Tour") + '</div>' +
            '<small class="text-muted">' + safeText(tour.description, "No description") + '</small>' +
            '</td>' +
            '<td><span class="badge bg-dark-transparent">' + checkpointCount + '</span></td>' +
            '<td style="min-width:180px;">' +
            '<div class="d-flex justify-content-between"><small>' + progressPercent + '%</small><small>' + totalScans + '/' + expectedTotal + '</small></div>' +
            '<div class="progress progress-xs mt-1"><div class="progress-bar bg-success" style="width:' + progressPercent + '%"></div></div>' +
            '</td>' +
            '<td>' + activeGuardText + '</td>' +
            '<td>' + statusBadge + '</td>' +
            '<td>' + safeText(createdDate, "N/A") + '</td>' +
            '<td class="text-end">' +
            '<button type="button" class="btn btn-sm btn-light me-1" title="View QR Codes" onclick="viewTourQr(' + index + ')"><i class="ri-eye-line"></i></button>' +
            '<button type="button" class="btn btn-sm btn-outline-primary me-1" title="View Progress" onclick="viewTourProgress(' + index + ')"><i class="ri-list-check-2"></i></button>' +
            '<button type="button" class="btn btn-sm btn-primary me-1" title="Edit Tour" onclick="openTourEdit(' + index + ')"><i class="ri-edit-line"></i></button>' +
            '<button type="button" class="btn btn-sm btn-danger" title="Delete Tour" onclick="deleteTour(' + index + ')"><i class="ri-delete-bin-line"></i></button>' +
            '</td>';

          tbody.appendChild(row);
        });
      } catch (error) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-5 text-danger">Unable to load site tours.</td></tr>';
      }
    }

    function openTourEdit(index) {
      const tour = window.loadedSiteTours[index];
      if (!tour) return;
      document.getElementById("editTourForm").action = `/site-tours/${tour._id}/update`;
      document.getElementById("editTourName").value = tour.tourName || "";
      document.getElementById("editTourDescription").value = tour.description || "";
      document.getElementById("editTourDuration").value = tour.durationKey || "1_year";
      document.getElementById("editTourCheckpoints").value = (tour.checkpoints || []).map(p => p.name || "").join("\n");
      new bootstrap.Modal(document.getElementById("editTourModal")).show();
    }

    function openNewCheckpointSetup(tour, checkpointIds) {
      if (!tour || !Array.isArray(checkpointIds) || checkpointIds.length === 0) {
        return;
      }

      const idSet = new Set(checkpointIds.map(function (id) {
        return String(id);
      }));

      const newCheckpoints = (tour.checkpoints || []).filter(function (checkpoint) {
        return idSet.has(String(checkpoint._id));
      });

      if (newCheckpoints.length === 0) {
        return;
      }

      document.getElementById("tourQrModalTitle").innerText =
        (tour.tourName || "Site Tour") + " - Set Up New Checkpoints";

      const wrapper = document.getElementById("tourQrWrapper");
      wrapper.innerHTML = "";

      newCheckpoints.forEach(function (point, index) {
        const nfcValue = point.nfcTagValue || "";
        const isNfcCheckpoint = nfcValue !== "";
        const col = document.createElement("div");
        col.className = "col-md-4 col-sm-6";

        if (isNfcCheckpoint) {
          const escapedNfcValue = String(nfcValue).replace(/'/g, "\\'");
          col.innerHTML =
            '<div class="border rounded p-3 text-center h-100">' +
            '<div class="fw-semibold mb-2">' + (index + 1) + '. ' + safeText(point.name, "Checkpoint") + '</div>' +
            '<i class="ri-nfc-line text-success" style="font-size:70px;"></i>' +
            '<div class="small text-muted mb-2" style="word-break:break-all;">' + safeText(nfcValue, "") + '</div>' +
            '<span id="nfc-status-' + point._id + '" class="badge mb-2 ' + (point.nfcWritten ? 'bg-success' : 'bg-secondary') + '">' +
            (point.nfcWritten ? 'Written' : 'Pending') + '</span><br>' +
            '<button type="button" class="btn btn-sm btn-success" onclick="writeNfcTag(\'' + tour._id + '\', \'' + point._id + '\', \'' + escapedNfcValue + '\')">' +
            '<i class="ri-nfc-line me-1"></i> Write New Tag</button>' +
            '</div>';
        } else {
          const qrValue = encodeURIComponent(point.qrCodeValue || "");
          col.innerHTML =
            '<div class="border rounded p-3 text-center h-100">' +
            '<div class="fw-semibold mb-2">' + (index + 1) + '. ' + safeText(point.name, "Checkpoint") + '</div>' +
            '<img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' + qrValue + '" class="img-fluid mb-2" style="max-width:160px;" alt="QR Code">' +
            '<div class="small text-muted" style="word-break:break-all;">' + safeText(point.qrCodeValue, "") + '</div>' +
            '</div>';
        }

        wrapper.appendChild(col);
      });

      bootstrap.Modal.getOrCreateInstance(
        document.getElementById("viewTourQrModal")
      ).show();
    }

    async function submitTourEdit(event) {
      event.preventDefault();

      const form = event.currentTarget;
      const submitButton = form.querySelector('button[type="submit"]');
      const originalText = submitButton ? submitButton.innerHTML : "";

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.innerHTML = '<i class="ri-loader-4-line me-1"></i> Saving...';
      }

      try {
        const formData = new FormData(form);
        const requestBody = new URLSearchParams();

        formData.forEach(function (value, key) {
          requestBody.append(key, value);
        });

        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
          },
          body: requestBody.toString(),
        });

        const responseText = await response.text();
        let data;

        try {
          data = responseText ? JSON.parse(responseText) : {};
        } catch (_) {
          throw new Error(
            responseText || "The server returned an invalid response."
          );
        }

        if (!response.ok || !data.success) {
          throw new Error(data.message || "Unable to update site tour.");
        }

        bootstrap.Modal.getOrCreateInstance(
          document.getElementById("editTourModal")
        ).hide();

        await loadSiteTours();

        if (Array.isArray(data.newlyAddedCheckpointIds) &&
            data.newlyAddedCheckpointIds.length > 0) {
          openNewCheckpointSetup(data.tour, data.newlyAddedCheckpointIds);
        } else {
          Swal.fire({
            icon: "success",
            title: "Site Tour Updated",
            text: data.message || "The site tour was updated successfully.",
            timer: 1800,
            showConfirmButton: false,
          });
        }
      } catch (error) {
        Swal.fire({
          icon: "error",
          title: "Update Failed",
          text: error.message || "Unable to update site tour.",
        });
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.innerHTML = originalText;
        }
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      const editTourForm = document.getElementById("editTourForm");
      if (editTourForm) {
        editTourForm.addEventListener("submit", submitTourEdit);
      }
    });

    async function deleteTour(index) {
      const tour = window.loadedSiteTours[index];
      if (!tour) return;
      const result = await Swal.fire({title:"Delete Site Tour?",text:"This will delete this tour and its checkpoint progress.",icon:"warning",showCancelButton:true,confirmButtonColor:"#dc3545",confirmButtonText:"Yes, delete it"});
      if (!result.isConfirmed) return;
      const form = document.createElement("form"); form.method="POST"; form.action=`/site-tours/${tour._id}/delete`; document.body.appendChild(form); form.submit();
    }

    function viewTourQr(index) {
      const tour = window.loadedSiteTours[index];
      if (!tour) return;

      document.getElementById("tourQrModalTitle").innerText = (tour.tourName || "Site Tour") + " - QR Codes";

      const wrapper = document.getElementById("tourQrWrapper");
      wrapper.innerHTML = "";

      const checkpoints = tour.checkpoints || [];

      if (checkpoints.length === 0) {
        wrapper.innerHTML = '<div class="col-12 text-center py-4 text-muted">No QR checkpoints found.</div>';
      }

      checkpoints.forEach(function (point, idx) {
        const qrValue = encodeURIComponent(point.qrCodeValue || "");
        const nfcValue = point.nfcTagValue || "";
        const isNfcCheckpoint = nfcValue !== "";
        const col = document.createElement("div");
        col.className = "col-md-3 col-sm-6";

        if (isNfcCheckpoint) {
          const escapedNfcValue = String(nfcValue).replace(/'/g, "\\'");
          col.innerHTML =
            '<div class="border rounded p-3 text-center h-100">' +
            '<div class="fw-semibold mb-2">' + (idx + 1) + '. ' + safeText(point.name, "Checkpoint") + '</div>' +
            '<i class="ri-nfc-line text-success" style="font-size:70px;"></i>' +
            '<div class="small text-muted mb-2" style="word-break:break-all;">' + safeText(nfcValue, "") + '</div>' +
            '<span id="nfc-status-' + point._id + '" class="badge mb-2 ' + (point.nfcWritten ? 'bg-success' : 'bg-secondary') + '">' +
            (point.nfcWritten ? 'Written' : 'Pending') + '</span><br>' +
            '<button type="button" class="btn btn-sm btn-success" onclick="writeNfcTag(\'' + tour._id + '\', \'' + point._id + '\', \'' + escapedNfcValue + '\')">' +
            '<i class="ri-nfc-line me-1"></i> Write Tag</button>' +
            '</div>';
        } else {
          col.innerHTML =
            '<div class="border rounded p-3 text-center h-100">' +
            '<div class="fw-semibold mb-2">' + (idx + 1) + '. ' + safeText(point.name, "Checkpoint") + '</div>' +
            '<img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' + qrValue + '" class="img-fluid mb-2" style="max-width:160px;" alt="QR Code">' +
            '<div class="small text-muted" style="word-break:break-all;">' + safeText(point.qrCodeValue, "") + '</div>' +
            '</div>';
        }

        wrapper.appendChild(col);
      });

      new bootstrap.Modal(document.getElementById("viewTourQrModal")).show();
    }

    function viewTourProgress(index) {
      const tour = window.loadedSiteTours[index];
      if (!tour) return;

      document.getElementById("tourProgressModalTitle").innerText =
        (tour.tourName || "Site Tour") + " - Activity by Date";

      const wrapper = document.getElementById("tourProgressWrapper");
      const progress = [...(tour.progress || [])].sort(function (a, b) {
        return new Date(b.startedAt || 0) - new Date(a.startedAt || 0);
      });

      if (progress.length === 0) {
        wrapper.innerHTML =
          '<div class="text-center py-5 text-muted">' +
          '<i class="ri-map-pin-time-line" style="font-size:45px;"></i>' +
          '<h6 class="mt-2">No Scan Activity Yet</h6>' +
          '<p class="mb-0">No guard has started this tour.</p>' +
          '</div>';
        new bootstrap.Modal(document.getElementById("viewTourProgressModal")).show();
        return;
      }

      let html = '<div class="accordion" id="tourProgressAccordion">';

      progress.forEach(function (item, itemIndex) {
        const scanned = item.scannedCheckpoints || [];
        const snapshot = item.checkpointSnapshot && item.checkpointSnapshot.length
          ? item.checkpointSnapshot
          : (tour.checkpoints || []).map(function (checkpoint) {
              return {
                checkpointId: checkpoint._id,
                checkpointName: checkpoint.name,
                order: checkpoint.order
              };
            });
        const percent = snapshot.length > 0
          ? Math.min(100, Math.round((scanned.length / snapshot.length) * 100))
          : 0;
        const dateValue = item.dateKey || (item.startedAt
          ? new Date(item.startedAt).toISOString().slice(0, 10)
          : "Unknown Date");
        const headingId = "tourProgressHeading" + itemIndex;
        const collapseId = "tourProgressCollapse" + itemIndex;
        const statusClass = item.status === "Completed" ? "bg-success" : "bg-warning";

        html +=
          '<div class="accordion-item">' +
          '<h2 class="accordion-header" id="' + headingId + '">' +
          '<button class="accordion-button ' + (itemIndex === 0 ? '' : 'collapsed') + '" type="button" ' +
          'data-bs-toggle="collapse" data-bs-target="#' + collapseId + '" ' +
          'aria-expanded="' + (itemIndex === 0 ? 'true' : 'false') + '" aria-controls="' + collapseId + '">' +
          '<div class="d-flex justify-content-between align-items-center w-100 me-3 flex-wrap gap-2">' +
          '<span><strong>' + safeText(dateValue, "Date") + '</strong> - ' + safeText(item.guardName, "Guard") + '</span>' +
          '<span class="badge ' + statusClass + '">' + safeText(item.status, "In Progress") + '</span>' +
          '</div>' +
          '</button>' +
          '</h2>' +
          '<div id="' + collapseId + '" class="accordion-collapse collapse ' + (itemIndex === 0 ? 'show' : '') + '" ' +
          'aria-labelledby="' + headingId + '" data-bs-parent="#tourProgressAccordion">' +
          '<div class="accordion-body">' +
          '<div class="row g-2 mb-3">' +
          '<div class="col-md-4"><small class="text-muted d-block">Guard</small><strong>' + safeText(item.guardName, "Guard") + '</strong></div>' +
          '<div class="col-md-4"><small class="text-muted d-block">Started</small><strong>' + (item.startedAt ? new Date(item.startedAt).toLocaleString() : "N/A") + '</strong></div>' +
          '<div class="col-md-4"><small class="text-muted d-block">Completed</small><strong>' + (item.completedAt ? new Date(item.completedAt).toLocaleString() : "Not completed") + '</strong></div>' +
          '</div>' +
          '<div class="d-flex justify-content-between"><small>' + scanned.length + '/' + snapshot.length + ' checkpoints</small><small>' + percent + '%</small></div>' +
          '<div class="progress progress-xs mt-1 mb-3"><div class="progress-bar bg-success" style="width:' + percent + '%"></div></div>' +
          '<div class="table-responsive">' +
          '<table class="table table-sm table-bordered mb-0">' +
          '<thead><tr><th>Checkpoint</th><th>Status</th><th>Scanned At</th></tr></thead><tbody>';

        snapshot.forEach(function (checkpoint) {
          const checkpointId = checkpoint.checkpointId || checkpoint._id;
          const checkpointName = checkpoint.checkpointName || checkpoint.name || "Checkpoint";
          const scannedItem = scanned.find(function (scan) {
            return String(scan.checkpointId) === String(checkpointId);
          });

          html +=
            '<tr>' +
            '<td>' + safeText(checkpointName, "Checkpoint") + '</td>' +
            '<td>' + (scannedItem
              ? '<span class="badge bg-success">Scanned</span>'
              : '<span class="badge bg-secondary">Pending</span>') + '</td>' +
            '<td>' + (scannedItem && scannedItem.scannedAt
              ? new Date(scannedItem.scannedAt).toLocaleString()
              : "N/A") + '</td>' +
            '</tr>';
        });

        html +=
          '</tbody></table></div></div></div></div>';
      });

      html += '</div>';
      wrapper.innerHTML = html;
      new bootstrap.Modal(document.getElementById("viewTourProgressModal")).show();
    }

        let currentNfcTour = null;

    const createNfcTourForm = document.getElementById("createNfcTourForm");

    if (createNfcTourForm) {
      createNfcTourForm.addEventListener("submit", async function (e) {
        e.preventDefault();

        const formData = new FormData(createNfcTourForm);
        const body = Object.fromEntries(formData.entries());

        try {
          const res = await fetch("/site-tours/create-nfc", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(body),
          });

          const data = await res.json();

          if (!data.success) {
            alert(data.message || "Unable to create NFC tour.");
            return;
          }

          currentNfcTour = data.tour;
          console.log(currentNfcTour);
          renderNfcWriteList(currentNfcTour);
          loadSiteTours();
        } catch (error) {
          alert("Server error creating NFC tour.");
        }
      });
    }

    function renderNfcWriteList(tour) {
      const section = document.getElementById("nfcWriteSection");
      const list = document.getElementById("nfcCheckpointList");

      if (!section || !list || !tour) return;

      section.classList.remove("d-none");
      list.innerHTML = "";

      const checkpoints = tour.checkpoints || [];

      checkpoints.forEach(function (point, index) {
        const item = document.createElement("div");
        item.className = "list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2";

        item.innerHTML =
          '<div>' +
          '<div class="fw-semibold">' + (index + 1) + '. ' + safeText(point.name, "Checkpoint") + '</div>' +
          '<small class="text-muted" style="word-break:break-all;">' + safeText(point.nfcTagValue, "") + '</small>' +
          '</div>' +
          '<div class="d-flex align-items-center gap-2">' +
          '<span id="nfc-status-' + point._id + '" class="badge ' + (point.nfcWritten ? 'bg-success' : 'bg-secondary') + '">' + (point.nfcWritten ? 'Written' : 'Pending') + '</span>' +
          '<button type="button" class="btn btn-sm btn-success" onclick="writeNfcTag(\'' + tour._id + '\', \'' + point._id + '\', \'' + String(point.nfcTagValue || "").replace(/'/g, "\\'") + '\')">' +
          '<i class="ri-nfc-line me-1"></i> Write Tag' +
          '</button>' +
          '</div>';

        list.appendChild(item);
      });
    }

    async function writeNfcTag(tourId, checkpointId, nfcTagValue) {
      if (!("NDEFReader" in window)) {
        alert("This browser does not support Web NFC. Use Chrome on an NFC-enabled Android phone over HTTPS.");
        return;
      }

      try {
        const writer = new NDEFReader();

        await writer.write({
          records: [
            {
              recordType: "text",
              data: nfcTagValue,
            },
          ],
        });

        const confirmRes = await fetch("/api/site-tours/nfc-write-confirm", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            companyId,
            postSiteId,
            tourId,
            checkpointId,
          }),
        });

        const confirmData = await confirmRes.json();

        if (!confirmData.success) {
          alert(confirmData.message || "NFC was written, but server confirmation failed.");
          return;
        }

        const status = document.getElementById("nfc-status-" + checkpointId);
        if (status) {
          status.className = "badge bg-success";
          status.innerText = "Written";
        }

        loadSiteTours();
        alert("NFC tag written successfully.");
      } catch (error) {
        alert("NFC write failed or was cancelled. Try again and hold the tag close to the phone.");
      }
    }

    const siteToursTab = document.getElementById("site-tours-tab");
    if (siteToursTab) {
      siteToursTab.addEventListener("click", loadSiteTours);
    }
  </script>

