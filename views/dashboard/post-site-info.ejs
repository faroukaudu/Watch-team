    <div class="modal-dialog modal-lg">
      <form action="/site-tours/create" method="POST" class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title">Create Site Tour</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <input type="hidden" name="companyId" value="<%= userInfo?.assignedCompanyID || '' %>">
