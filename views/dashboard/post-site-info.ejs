<%- include("../includes/header", { user: userInfo }); -%>
  <link rel="stylesheet" href="assets/libs/sweetalert2/sweetalert2.min.css">

  <div class="main-content app-content">
    <div class="container-fluid">

      <!-- Page Header -->
      <div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
          <h1 class="page-title fw-medium fs-18 mb-2">Post Site</h1>
          <nav>
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="javascript:void(0);">Client</a></li>
              <li class="breadcrumb-item active" aria-current="page">View Post Site</li>
            </ol>
          </nav>
        </div>

        <button type="button" class="btn btn-danger btn-wave" id="deletePostSiteButton">
          <i class="ri-delete-bin-6-line me-1"></i> Delete Post Site
        </button>

        <form id="deletePostSiteForm" action="/delete-post-site/<%= companyInfo?._id || '' %>" method="POST" class="d-none"></form>
      </div>

      <!-- Hero -->
      <div class="row">
        <div class="col-xl-12">
          <div class="card custom-card profile-card ">
            <div class="profile-image position-relative" style="height:260px; overflow:hidden;">
              <div id="postSiteBannerMap" data-lat="<%= companyInfo.lat %>" data-long="<%= companyInfo.long %>"
                style="height:260px; width:100%;">
              </div>
            </div>

            <div class="card-body p-4 pb-0 position-relative">
              <span class="avatar avatar-xxl avatar-rounded bg-info online">
                <img src="./assets/images/faces/4.jpg" alt="">
              </span>

              <div class="mt-4 mb-3 d-flex align-items-center flex-wrap gap-3 justify-content-between">
                <div>
                  <h5 class="fw-semibold mb-1">
                    <%= companyInfo?.siteName || "Post Site" %>
                  </h5>
                  <span class="d-block fw-medium text-muted mb-1">
                    <%= companyInfo?.clientName || fullCompInfo?.companyName || "Unknown Client" %>
                  </span>
                  <p class="fs-12 mb-0 fw-medium text-muted">
                    <span class="me-3">
                      <i class="ri-map-pin-line me-1 align-middle"></i>
                      <%= companyInfo?.address || "No address available" %>
                    </span>

                    <% if (companyInfo?.phone) { %>
                      <span class="me-3">
                        <i class="ri-phone-line me-1 align-middle"></i>
                        <%= companyInfo.phone %>
                      </span>
                      <% } %>

                        <% if (companyInfo?.email) { %>
                          <span>
                            <i class="ri-mail-line me-1 align-middle"></i>
                            <%= companyInfo.email %>
                          </span>
                          <% } %>
                  </p>
                </div>

                <div class="d-flex mb-0 flex-wrap gap-5">
                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar avatar-lg bg-primary avatar-rounded border border-primary border-opacity-10">
                      <i class="ri-shield-user-line fs-18"></i>
                    </div>
                    <div>
                      <p class="mb-0 fs-12 text-muted fw-medium">Guards Assigned</p>
                      <p class="fw-semibold fs-20 mb-0">
                        <%= assignedGuards?.length || 0 %>
                      </p>
                    </div>
                  </div>

                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar avatar-lg bg-secondary avatar-rounded border border-secondary border-opacity-10">
                      <i class="ri-file-list-3-line fs-18"></i>
                    </div>
                    <div>
                      <p class="mb-0 fs-12 text-muted fw-medium">Total Reports</p>
                      <p class="fw-semibold fs-20 mb-0">
                        <%= reportSummary?.total || 0 %>
                      </p>
                    </div>
                  </div>

                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar avatar-lg bg-warning avatar-rounded border border-warning border-opacity-10">
                      <i class="ri-alarm-warning-line fs-18"></i>
                    </div>
                    <div>
                      <p class="mb-0 fs-12 text-muted fw-medium">Incident Reports</p>
                      <p class="fw-semibold fs-20 mb-0">
                        <%= reportSummary?.incident || 0 %>
                      </p>
                    </div>
                  </div>

                  <div class="d-flex align-items-center gap-3">
                    <div class="avatar avatar-lg bg-success avatar-rounded border border-success border-opacity-10">
                      <i class="ri-task-line fs-18"></i>
                    </div>
                    <div>
                      <p class="mb-0 fs-12 text-muted fw-medium">Standard Reports</p>
                      <p class="fw-semibold fs-20 mb-0">
                        <%= reportSummary?.standard || 0 %>
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Tabs -->
              <ul class="nav nav-tabs mb-0 tab-style-8 scaleX" id="postSiteTab" role="tablist">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-pane"
                    type="button" role="tab" aria-controls="overview-pane" aria-selected="true">
                    Overview
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-pane"
                    type="button" role="tab" aria-controls="profile-pane" aria-selected="false">
                    Profile
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact-pane"
                    type="button" role="tab" aria-controls="contact-pane" aria-selected="false">
                    Contact
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="guards-tab" data-bs-toggle="tab" data-bs-target="#guards-pane"
                    type="button" role="tab" aria-controls="guards-pane" aria-selected="false">
                    Assign Guards
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="reports-tab" data-bs-toggle="tab" data-bs-target="#reports-pane"
                    type="button" role="tab" aria-controls="reports-pane" aria-selected="false">
                    Reports
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="email-reports-tab" data-bs-toggle="tab"
                    data-bs-target="#email-reports-pane" type="button" role="tab" aria-controls="email-reports-pane"
                    aria-selected="false">
                    Email Report
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="kpi-tab" data-bs-toggle="tab" data-bs-target="#kpi-pane" type="button"
                    role="tab" aria-controls="kpi-pane" aria-selected="false">
                    KPI
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes-pane"
                    type="button" role="tab" aria-controls="notes-pane" aria-selected="false">
                    Notes
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="task-tab" data-bs-toggle="tab" data-bs-target="#task-pane" type="button"
                    role="tab" aria-controls="task-pane" aria-selected="false">
                    Tasks
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="files-tab" data-bs-toggle="tab" data-bs-target="#files-pane"
                    type="button" role="tab" aria-controls="files-pane" aria-selected="false">
                    Files
                  </button>
                </li>
                <li class="nav-item">
                  <a class="nav-link" data-bs-toggle="tab" href="#visitorsTab">
                    <i class="ri-user-received-line me-1"></i> Visitors
                  </a>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="site-tours-tab" data-bs-toggle="tab" data-bs-target="#site-tours-pane"
                    type="button" role="tab">
                    Site Tours
                  </button>
                </li>

                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="checklist-tab" data-bs-toggle="tab" data-bs-target="#checklist-pane"
                    type="button" role="tab" aria-controls="checklist-pane" aria-selected="false">
                    Checklist
                  </button>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab Content -->
      <div class="row">
        <div class="col-xl-12">
          <div class="tab-content mt-3" id="postSiteTabContent">

            <!-- Overview -->
            <div class="tab-pane fade show active" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab"
              tabindex="0">
              <div class="row">
                <div class="col-xxl-4 col-xl-5">
                  <div class="card custom-card">
                    <div class="card-header justify-content-between">
                      <div class="card-title">Latest Activity</div>
                    </div>
                    <div class="card-body">
                      <ul class="list-unstyled crm-top-leads mb-0">
                        <% if (latestActivity && latestActivity.length> 0) { %>
                          <% latestActivity.forEach(function(item){ %>
                            <li class="mb-3">
                              <div class="d-flex align-items-top flex-wrap">
                                <div class="me-2">
                                  <span class="avatar avatar-sm avatar-rounded bg-primary-transparent fw-semibold">
                                    <%= (item.title || "X" ).charAt(0).toUpperCase() %>
                                  </span>
                                </div>
                                <div class="flex-fill">
                                  <p class="fw-semibold mb-0">
                                    <%= item.title || "Activity" %>
                                  </p>
                                  <span class="text-muted fs-12">
                                    <%= item.subtitle || "" %>
                                  </span>
                                </div>
                                <div class="fw-semibold fs-12">
                                  <% if (item.status==="Approved" || item.status==="Active" ) { %>
                                    <span class="badge bg-success-transparent">
                                      <%= item.status %>
                                    </span>
                                    <% } else { %>
                                      <span class="badge bg-warning-transparent">
                                        <%= item.status || "Pending" %>
                                      </span>
                                      <% } %>
                                </div>
                              </div>
                            </li>
                            <% }) %>
                              <% } else { %>
                                <li class="text-muted">No recent activity found.</li>
                                <% } %>
                      </ul>
                    </div>
                  </div>
                </div>

                <div class="col-xxl-8 col-xl-7">
                  <div class="card custom-card">
                    <div class="card-header">
                      <div class="card-title">Report Summary</div>
                    </div>
                    <div class="card-body">
                      <div class="row g-3">
                        <div class="col-md-4">
                          <div class="p-3 border rounded">
                            <div class="fs-12 text-muted">General</div>
                            <div class="fs-24 fw-semibold">
                              <%= reportSummary?.general || 0 %>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-4">
                          <div class="p-3 border rounded">
                            <div class="fs-12 text-muted">Incident</div>
                            <div class="fs-24 fw-semibold">
                              <%= reportSummary?.incident || 0 %>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-4">
                          <div class="p-3 border rounded">
                            <div class="fs-12 text-muted">Standard</div>
                            <div class="fs-24 fw-semibold">
                              <%= reportSummary?.standard || 0 %>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-4">
                          <div class="p-3 border rounded">
                            <div class="fs-12 text-muted">Log</div>
                            <div class="fs-24 fw-semibold">
                              <%= reportSummary?.log || 0 %>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-4">
                          <div class="p-3 border rounded">
                            <div class="fs-12 text-muted">NFC</div>
                            <div class="fs-24 fw-semibold">
                              <%= reportSummary?.nfc || 0 %>
                            </div>
                          </div>
                        </div>
                        <div class="col-md-4">
                          <div class="p-3 border rounded">
                            <div class="fs-12 text-muted">Total</div>
                            <div class="fs-24 fw-semibold">
                              <%= reportSummary?.total || 0 %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="card custom-card">
                    <div class="card-header">
                      <div class="card-title">Recent Reports</div>
                    </div>
                    <div class="card-body">
                      <div class="table-responsive">
                        <table class="table text-nowrap table-sm">
                          <thead>
                            <tr>
                              <th>Title</th>
                              <th>Category</th>
                              <th>Submitted By</th>
                              <th>Date</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if (reports && reports.length> 0) { %>
                              <% reports.slice(0, 8).forEach(function(report){ %>
                                <tr>
                                  <td>
                                    <%= report.title || "Untitled Report" %>
                                  </td>
                                  <td>
                                    <% const cat=(report.category || "general" ).toLowerCase(); %>
                                      <% if (cat==="incident" ) { %>
                                        <span class="badge bg-warning-transparent">Incident</span>
                                        <% } else if (cat==="standard" ) { %>
                                          <span class="badge bg-success-transparent">Standard</span>
                                          <% } else if (cat==="nfc" ) { %>
                                            <span class="badge bg-secondary-transparent">NFC</span>
                                            <% } else if (cat==="log" ) { %>
                                              <span class="badge bg-info-transparent">Log</span>
                                              <% } else { %>
                                                <span class="badge bg-dark-transparent">General</span>
                                                <% } %>
                                  </td>
                                  <td>
                                    <%= report.fullname || "Unknown" %>
                                  </td>
                                  <td>
                                    <%= new Date(report.createdAt).toLocaleString() %>
                                  </td>
                                </tr>
                                <% }) %>
                                  <% } else { %>
                                    <tr>
                                      <td colspan="4" class="text-center text-muted">No reports found for this post
                                        site.</td>
                                    </tr>
                                    <% } %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Profile -->
            <div class="tab-pane fade" id="profile-pane" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
              <div class="card custom-card overflow-hidden">
                <div class="card-body p-4">
                  <div class="row gy-4 align-items-center">
                    <div class="col-xl-3"><span class="fw-medium">Client Name :</span></div>
                    <div class="col-xl-9"><input type="text" class="form-control"
                        value="<%= companyInfo?.clientName || '' %>" readonly></div>

                    <div class="col-xl-3"><span class="fw-medium">Post Site :</span></div>
                    <div class="col-xl-9"><input type="text" class="form-control"
                        value="<%= companyInfo?.siteName || '' %>" readonly></div>

                    <div class="col-xl-3"><span class="fw-medium">Address :</span></div>
                    <div class="col-xl-9"><input type="text" class="form-control"
                        value="<%= companyInfo?.address || '' %>" readonly></div>

                    <div class="col-xl-3"><span class="fw-medium">Phone Number :</span></div>
                    <div class="col-xl-9"><input type="text" class="form-control"
                        value="<%= companyInfo?.phone || '' %>" readonly></div>

                    <div class="col-xl-3"><span class="fw-medium">Email :</span></div>
                    <div class="col-xl-9"><input type="text" class="form-control"
                        value="<%= companyInfo?.email || '' %>" readonly></div>

                    <div class="col-xl-3"><span class="fw-medium">Status :</span></div>
                    <div class="col-xl-9">
                      <% if (companyInfo?.statusIsActive===true) { %>
                        <span class="badge bg-success-transparent">Active</span>
                        <% } else { %>
                          <span class="badge bg-danger-transparent">Inactive</span>
                          <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Contact -->
            <div class="tab-pane fade" id="contact-pane" role="tabpanel" aria-labelledby="contact-tab" tabindex="0">
              <div class="card custom-card">
                <div class="card-body">
                  <div class="table-responsive">
                    <h4>Post Site Contacts</h4><br>
                    <table class="table text-nowrap table-sm">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Email</th>
                          <th>Phone Number</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (clients && clients.length> 0) { %>
                          <% clients.forEach(function(client){ %>
                            <tr>
                              <td>
                                <%= client.fullname || "Unknown" %>
                              </td>
                              <td>
                                <%= client.email || "N/A" %>
                              </td>
                              <td>
                                <%= client.phone || "N/A" %>
                              </td>
                            </tr>
                            <% }) %>
                              <% } else { %>
                                <tr>
                                  <td colspan="3" class="text-center text-muted">No contacts found.</td>
                                </tr>
                                <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- Assign Guards -->
            <div class="tab-pane fade" id="guards-pane" role="tabpanel" aria-labelledby="guards-tab" tabindex="0">
              <div class="card custom-card">
                <div class="card-body">
                  <div class="table-responsive">
                    <h4>Assigned Guards</h4><br>
                    <table class="table text-nowrap table-sm">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Mobile Number</th>
                          <th>Email</th>
                          <th>View</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (assignedGuards && assignedGuards.length> 0) { %>
                          <% assignedGuards.forEach(function(guard){ %>
                            <tr>
                              <td>
                                <%= guard.fullname || "Unknown" %>
                              </td>
                              <td>
                                <%= guard.phone || "N/A" %>
                              </td>
                              <td>
                                <%= guard.email || "N/A" %>
                              </td>
                              <td>
                                <form action="/guard-details" method="post" id="guardinfo <%=guard.id%>">


                                  <input type="hidden" name="guard_id" value="<%= guard.id%>">
                                  <!-- <li class=""><a class="dropdown-item" href="#" onclick="document.getElementById('guardinfo <%=guard.id%>').submit(); return false;"><i class="ti ti-eye"></i> &nbsp; Guard Info</a></li> -->
                                  <!-- <li class=""><a class="dropdown-item" href="javascript:void(0);"><i class="ti ti-archive"></i> &nbsp; &nbsp;Assign PostSite</a> -->
                                  <!-- <li class=""><a class="dropdown-item" href="javascript:void(0);"><i class="ti ti-archive"></i> &nbsp; &nbsp;Assign PostSite</a> -->
                                  <!-- </li> -->


                                </form>

                                <a href="#"
                                  onclick="document.getElementById('guardinfo <%=guard.id%>').submit(); return false;"><i
                                    class="ri-eye-line"></i></a>
                              </td>
                            </tr>
                            <% }) %>
                              <% } else { %>
                                <tr>
                                  <td colspan="4" class="text-center text-muted">No guards assigned to this post site.
                                  </td>
                                </tr>
                                <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- Reports -->
            <div class="tab-pane fade" id="reports-pane" role="tabpanel" aria-labelledby="reports-tab" tabindex="0">
              <div class="card custom-card">
                <div class="card-body">
                  <div class="table-responsive">
                    <h4>Reports</h4><br>
                    <table class="table text-nowrap table-sm">
                      <thead>
                        <tr>
                          <th>Title</th>
                          <th>Description / Site Ref</th>
                          <th>Type</th>
                          <th>Submitted By</th>
                          <th>Date</th>
                          <th>status</th>
                          <th>view</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (reports && reports.length> 0) { %>
                          <% reports.forEach(function(report){ %>
                            <tr>
                              <td>
                                <%= report.title || "Untitled Report" %>
                              </td>
                              <td>
                                <%= report.fields?.details || report.fields?.notes || report.fields?.location ||
                                  companyInfo?.siteName || "N/A" %>
                              </td>
                              <td>
                                <% const cat=(report.category || "general" ).toLowerCase(); %>
                                  <% if (cat==="incident" ) { %>
                                    <span class="badge bg-warning-transparent">Incident</span>
                                    <% } else if (cat==="standard" ) { %>
                                      <span class="badge bg-success-transparent">Standard</span>
                                      <% } else if (cat==="nfc" ) { %>
                                        <span class="badge bg-secondary-transparent">NFC</span>
                                        <% } else if (cat==="log" ) { %>
                                          <span class="badge bg-info-transparent">Log</span>
                                          <% } else { %>
                                            <span class="badge bg-dark-transparent">General</span>
                                            <% } %>
                              </td>
                              <td>
                                <%= report.fullname || "Unknown" %>
                              </td>
                              <td>
                                <%= new Date(report.createdAt).toLocaleString() %>
                              </td>
                              <td>
                                <div class="fw-semibold fs-12">
                                  <% if (report.status===true || report.status==="Active" ) { %>
                                    <span class="badge bg-success-transparent">Approved</span>
                                    <% } else { %>
                                      <span class="badge bg-warning-transparent">
                                        <%= report.status || "Pending" %>
                                      </span>
                                      <% } %>
                                </div>
                              </td>
                              <td>
                                <form action="/reports-view" method="POST" class="m-0">
                                  <input type="hidden" name="action" value="view">
                                  <input type="hidden" name="reportId" value="<%= report._id %>">
                                  <button type="submit" class="dropdown-item">
                                    <i class="ri-eye-line me-1 align-middle d-inline-block"></i>
                                  </button>
                                </form>

                                <!-- <i class="ri-eye-line"></i></td> -->
                            </tr>
                            <% }) %>
                              <% } else { %>
                                <tr>
                                  <td colspan="5" class="text-center text-muted">No reports available.</td>
                                </tr>
                                <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- Email Report -->
            <!-- Email Report -->
            <div class="tab-pane fade" id="email-reports-pane" role="tabpanel" aria-labelledby="email-reports-tab"
              tabindex="0">
              <div class="card custom-card">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                  <div>
                    <h4 class="card-title mb-1">Email Reports</h4>
                    <p class="text-muted fs-12 mb-0">Manage report recipients and send scheduled or manual reports.</p>
                  </div>

                  <div class="dropdown">
                    <button class="btn btn-primary btn-sm dropdown-toggle" type="button" id="frequencyDropdown"
                      data-bs-toggle="dropdown" aria-expanded="false">
                      <i class="ri-timer-line me-1"></i> Frequency
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="frequencyDropdown">
                      <li><a class="dropdown-item frequency-option active" href="javascript:void(0);"
                          data-frequency="Daily">Daily</a></li>
                      <li><a class="dropdown-item frequency-option" href="javascript:void(0);"
                          data-frequency="Weekly">Weekly</a></li>
                      <li><a class="dropdown-item frequency-option" href="javascript:void(0);"
                          data-frequency="Monthly">Monthly</a></li>
                    </ul>
                  </div>
                </div>

                <div class="card-body">
                  <div class="table-responsive">
                    <table class="table text-nowrap table-bordered align-middle">
                      <thead class="table-light">
                        <tr>
                          <th style="width: 60px;">#</th>
                          <th>Client Name</th>
                          <th>Email</th>
                          <th>Report Name</th>
                          <th>Frequency</th>
                          <th>Scheduled Countdown</th>
                          <th class="text-center" style="width: 180px;">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (clients && clients.length> 0) { %>
                          <% clients.forEach(function(client, index){ %>
                            <% const clientSchedule=scheduleMap && client.email ?
                              scheduleMap[String(client.email).toLowerCase()] : null; %>
                              <tr>
                                <td>
                                  <%= index + 1 %>
                                </td>
                                <td>
                                  <div class="fw-semibold">
                                    <%= client.fullname || "Unknown Client" %>
                                  </div>
                                </td>
                                <td>
                                  <span class="text-muted">
                                    <%= client.email || "No Email" %>
                                  </span>
                                </td>
                                <td>
                                  <span class="badge bg-primary-transparent">
                                    <%= clientSchedule?.reportTitle || companyInfo?.siteName || "Site Report" %>
                                  </span>
                                </td>
                                <td>
                                  <span class="badge bg-info-transparent email-frequency-badge">
                                    <%= clientSchedule?.frequency || "Not scheduled" %>
                                  </span>
                                </td>
                                <td>
                                  <% if (clientSchedule?.nextSendAt) { %>
                                    <span class="badge bg-dark-transparent scheduled-countdown-text"
                                      data-next-send="<%= new Date(clientSchedule.nextSendAt).toISOString() %>">
                                      Loading...
                                    </span>
                                    <% } else { %>
                                      <span class="badge bg-dark-transparent scheduled-countdown-text">Not
                                        scheduled</span>
                                      <% } %>
                                </td>
                                <td class="text-center">
                                  <div class="d-flex justify-content-center gap-2">

                                    <button type="button" class="btn btn-sm btn-success send-report-btn"
                                      data-bs-toggle="modal" data-bs-target="#sendReportModal"
                                      data-client-name="<%= client.fullname || 'Unknown Client' %>"
                                      data-client-email="<%= client.email || '' %>">
                                      <i class="ri-send-plane-2-line"></i>
                                    </button>

                                    <button type="button" class="btn btn-sm btn-warning schedule-report-open-btn"
                                      data-bs-toggle="modal" data-bs-target="#scheduleReportModal"
                                      data-client-name="<%= client.fullname || 'Unknown Client' %>"
                                      data-client-email="<%= client.email || '' %>"
                                      data-saved-frequency="<%= clientSchedule?.frequency || 'Weekly' %>"
                                      data-saved-title="<%= clientSchedule?.reportTitle || (companyInfo?.siteName || 'Scheduled Site Report') %>"
                                      data-saved-start-date="<%= clientSchedule?.startDate ? new Date(clientSchedule.startDate).toISOString().slice(0,10) : '' %>">
                                      <i class="ri-calendar-schedule-line"></i>
                                    </button>

                                    <button type="button" class="btn btn-sm btn-info schedule-history-btn"
                                      data-bs-toggle="modal" data-bs-target="#scheduleHistoryModal"
                                      data-client-name="<%= client.fullname || 'Unknown Client' %>"
                                      data-client-email="<%= client.email || '' %>"
                                      data-post-site-id="<%= companyInfo?._id || '' %>">
                                      <i class="ri-eye-line"></i>
                                    </button>

                                    <% if (clientSchedule) { %>
                                      <form action="/disable-scheduled-post-site-report" method="POST"
                                        style="display:inline;">
                                        <input type="hidden" name="postSiteId" value="<%= companyInfo?._id || '' %>">
                                        <input type="hidden" name="clientEmail" value="<%= client.email || '' %>">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                          <i class="ri-close-circle-line"></i>
                                        </button>
                                      </form>
                                      <% } %>

                                  </div>
                                </td>
                              </tr>
                              <% }) %>
                                <% } else { %>
                                  <tr>
                                    <td colspan="7" class="text-center text-muted">No client email records found for
                                      this post site.</td>
                                  </tr>
                                  <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- KPI -->
            <div class="tab-pane fade" id="kpi-pane" role="tabpanel" aria-labelledby="kpi-tab" tabindex="0">
              <div class="card custom-card">
                <div class="card-body">
                  <h4>KPI</h4>
                  <p class="text-muted mb-0">Blank placeholder for now.</p>
                </div>
              </div>
            </div>

            <!-- Notes -->
            <div class="tab-pane fade" id="notes-pane" role="tabpanel" aria-labelledby="notes-tab" tabindex="0">
              <div class="card custom-card">
                <div class="card-header">
                  <div class="card-title">Post Site Notes</div>
                </div>

                <div class="card-body">
                  <% if (notes && notes.length> 0) { %>
                    <div class="table-responsive">
                      <table class="table table-bordered text-nowrap">
                        <thead>
                          <tr>
                            <th>Date</th>
                            <th>Guard Name</th>
                            <th>Title</th>
                            <th>Action</th>
                          </tr>
                        </thead>

                        <tbody>
                          <% notes.forEach(function(note) { %>
                            <tr>
                              <td>
                                <%= new Date(note.createdAt).toLocaleString() %>
                              </td>
                              <td>
                                <%= note.guardName || "Unknown Guard" %>
                              </td>
                              <td>
                                <%= note.title || "Untitled Note" %>
                              </td>
                              <td>
                                <button type="button" class="btn btn-sm btn-primary view-note-btn"
                                  data-title="<%= note.title || 'Note' %>"
                                  data-guard="<%= note.guardName || 'Unknown Guard' %>"
                                  data-date="<%= new Date(note.createdAt).toLocaleString() %>"
                                  data-note="<%= note.note || '' %>">
                                  <i class="ri-eye-line"></i>
                                </button>
                              </td>
                            </tr>
                            <% }) %>
                        </tbody>
                      </table>
                    </div>
                    <% } else { %>
                      <p class="text-muted mb-0">No notes available for this post site.</p>
                      <% } %>
                </div>
              </div>
            </div>

            <!-- Files -->
            <div class="tab-pane fade" id="files-pane" role="tabpanel" aria-labelledby="files-tab" tabindex="0">
              <div class="card custom-card">
                <div class="card-body">
                  <h4>Files</h4>
                  <p class="text-muted mb-0">Blank placeholder for now.</p>
                </div>
              </div>
            </div>
            <!-- Visitors -->
            <div class="tab-pane fade" id="visitorsTab">
              <style>
                .visitor-mini-card {
                  border: 1px solid rgba(148, 163, 184, .25);
                  border-radius: 16px;
                  background: linear-gradient(180deg, #ffffff, #f8fafc);
                  box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
                  transition: all .2s ease;
                  cursor: pointer;
                }

                .visitor-mini-card:hover {
                  transform: translateY(-3px);
                  box-shadow: 0 14px 30px rgba(15, 23, 42, .12);
                }

                .visitor-avatar {
                  width: 42px;
                  height: 42px;
                  border-radius: 50%;
                  object-fit: cover;
                  background: #e0f2fe;
                  color: #0284c7;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  font-size: 20px;
                  flex-shrink: 0;
                }

                .visitor-purpose {
                  max-width: 100%;
                  white-space: nowrap;
                  overflow: hidden;
                  text-overflow: ellipsis;
                }
              </style>

              <div class="card custom-card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div>
                    <h5 class="card-title mb-1">
                      <i class="ri-user-received-line me-1 text-primary"></i> Visitors
                    </h5>
                    <small class="text-muted">Visitors recorded by guards for this post site</small>
                  </div>

                  <input type="date" id="visitorDateFilter" class="form-control form-control-sm"
                    style="max-width:190px;">
                </div>

                <div class="card-body">
                  <div id="visitorsList" class="row g-3"></div>
                </div>
              </div>
            </div>

            <!-- Site tour -->
            <div class="tab-pane fade" id="site-tours-pane" role="tabpanel">

              <div class="card custom-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <div>
                    <h5 class="card-title mb-1">
                      <i class="ri-route-line me-1 text-primary"></i> Site Tours
                    </h5>
                    <small class="text-muted">
                      Create patrol routes, monitor scan progress, and view QR checkpoints
                    </small>
                  </div>

                  <div class="d-flex gap-2 flex-wrap">
  <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createTourModal">
    <i class="ri-qr-code-line me-1"></i> Create QR Code Tour
  </button>

  <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#createNfcTourModal">
    <i class="ri-rfid-line me-1"></i> Create NFC Tour
  </button>
</div>
                </div>

                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Tour Name</th>
                          <th>Checkpoints</th>
                          <th>Progress</th>
                          <th>Active Guards</th>
                          <th>Status</th>
                          <th>Created</th>
                          <th class="text-end">Action</th>
                        </tr>
                      </thead>

                      <tbody id="siteToursTableBody">
                        <tr>
                          <td colspan="7" class="text-center py-5 text-muted">
                            <i class="ri-loader-4-line" style="font-size:35px;"></i>
                            <p class="mb-0 mt-2">Click the Site Tours tab to load tours.</p>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

            </div>

            <!-- CheckList -->
            <div class="tab-pane fade" id="checklist-pane" role="tabpanel" aria-labelledby="checklist-tab" tabindex="0">
              <div class="card custom-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <div>
                    <h5 class="card-title mb-1">Post Site Checklists</h5>
                    <small class="text-muted">Create and monitor guard checklist progress</small>
                  </div>

                  <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addChecklistModal">
                    <i class="ri-add-line me-1"></i> Add Checklist
                  </button>
                </div>

                <div class="card-body">
                  <div class="table-responsive">
                    <table class="table table-hover align-middle text-nowrap">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Date</th>
                          <th>Added By</th>
                          <th>Progress</th>
                          <th>Status</th>
                          <th class="text-end">Action</th>
                        </tr>
                      </thead>

                      <tbody>
                        <% if (checklists && checklists.length> 0) { %>
                          <% checklists.forEach(function(item){ const totalItems=item.items ? item.items.length : 0; let
                            totalChecked=0; let completedCount=0; if (item.progress && item.progress.length> 0) {
                            item.progress.forEach(function(p){
                            totalChecked += p.checkedItems ? p.checkedItems.length : 0;
                            if (p.completed) completedCount++;
                            });
                            }

                            const assignedCount = item.assignedGuards ? item.assignedGuards.length : 0;
                            const expectedTotal = totalItems * assignedCount;
                            const isCompleted = expectedTotal > 0 && totalChecked === expectedTotal;
                            %>

                            <tr>
                              <td>
                                <div class="fw-semibold">
                                  <%= item.name %>
                                </div>
                                <small class="text-muted">
                                  <%= item.description || "No description" %>
                                </small>
                              </td>

                              <td>
                                <%= new Date(item.createdAt).toLocaleString() %>
                              </td>

                              <td>
                                <div class="fw-semibold">
                                  <%= item.addedByName || "Unknown" %>
                                </div>
                                <span class="badge bg-info-transparent">
                                  <%= item.addedByUserType || "User" %>
                                </span>
                              </td>

                              <td>
                                <div class="fw-semibold">
                                  <%= totalChecked %>/<%= expectedTotal %>
                                </div>
                                <div class="progress progress-xs mt-1">
                                  <div class="progress-bar bg-success"
                                    style="width:<%= expectedTotal > 0 ? Math.round((totalChecked / expectedTotal) * 100) : 0 %>%">
                                  </div>
                                </div>
                              </td>

                              <td>
                                <% if (isCompleted) { %>
                                  <span class="badge bg-success">Completed</span>
                                  <% } else { %>
                                    <span class="badge bg-warning">In Progress</span>
                                    <% } %>
                              </td>

                              <td class="text-end">
                                <button class="btn btn-sm btn-light"
                                  onclick='openChecklistProgress(<%- JSON.stringify(item) %>)'>
                                  View Progress
                                </button>

                                <button class="btn btn-sm btn-primary"
                                  onclick='openChecklistEdit(<%- JSON.stringify(item) %>)'>
                                  <i class="ri-edit-line"></i> Edit
                                </button>

                                <form action="/delete-checklist/<%= item._id %>" method="POST" class="d-inline delete-record-form" data-record-name="checklist">
                                  <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="ri-delete-bin-line"></i> Delete
                                  </button>
                                </form>
                              </td>
                            </tr>

                            <% }) %>
                              <% } else { %>
                                <tr>
                                  <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="ri-list-check-3" style="font-size:45px;"></i>
                                    <h6 class="mt-2">No Checklist Found</h6>
                                    <p class="mb-0">Create the first checklist for this post site.</p>
                                  </td>
                                </tr>
                                <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tasks -->
            <div class="tab-pane fade" id="task-pane" role="tabpanel" aria-labelledby="task-tab" tabindex="0">
              <div class="card custom-card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div>
                    <h5 class="card-title mb-1">
                      <i class="ri-task-line me-1 text-primary"></i> Post Site Tasks
                    </h5>
                    <small class="text-muted">Create one-off and recurring guard tasks for this post site</small>
                  </div>

                  <div class="d-flex gap-2">
                    <input type="date" id="taskDateFilter" class="form-control form-control-sm">
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newTaskModal">
                      <i class="ri-add-line me-1"></i> New Task
                    </button>
                  </div>
                </div>

                <div class="card-body p-0">
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Task Name</th>
                          <th>Duration</th>
                          <th>Type</th>
                          <th>Status</th>
                          <th>Guards</th>
                          <th class="text-end">Action</th>
                        </tr>
                      </thead>

                      <tbody>
                        <% if (postSiteTasks && postSiteTasks.length> 0) { %>
                          <% postSiteTasks.forEach(function(task){ %>
                            <tr class="task-row"
                              data-date="<%= task.createdAt ? new Date(task.createdAt).toISOString().split('T')[0] : '' %>">
                              <td>
                                <div class="fw-semibold">
                                  <%= task.taskName || "Untitled Task" %>
                                </div>
                                <small class="text-muted">
                                  <%= task.taskDescription || "No description" %>
                                </small>
                              </td>

                              <td>
                                <span class="badge bg-info-transparent">
                                  <%= task.maxDuration || "N/A" %>
                                </span>
                              </td>

                              <td>
                                <% if (task.taskType==="Recurring" ) { %>
                                  <span class="badge bg-primary">Recurring</span>
                                  <% } else { %>
                                    <span class="badge bg-secondary">One-Off</span>
                                    <% } %>
                              </td>

                              <td>
                                <% if (task.status==="Active" ) { %>
                                  <span class="badge bg-success">Active</span>
                                  <% } else if (task.status==="Completed" ) { %>
                                    <span class="badge bg-info">Completed</span>
                                    <% } else { %>
                                      <span class="badge bg-secondary">Inactive</span>
                                      <% } %>
                              </td>

                              <td>
                                <% if (task.assignedGuards && task.assignedGuards.length> 0) { %>
                                  <% task.assignedGuards.forEach(function(g){ %>
                                    <span class="badge bg-light text-dark me-1">
                                      <i class="ri-shield-user-line me-1"></i>
                                      <%= g.guardName || "Guard" %>
                                    </span>
                                    <% }) %>
                                      <% } else { %>
                                        <span class="text-muted">No guard</span>
                                        <% } %>
                              </td>

                              <td class="text-end">
                                <button type="button" class="btn btn-sm btn-primary"
                                  onclick='openTaskEdit(<%- JSON.stringify(task) %>)'>
                                  <i class="ri-edit-line"></i>
                                </button>

                                <form action="/delete-post-site-task/<%= task._id %>" method="POST" class="d-inline">
                                  <button class="btn btn-sm btn-danger delete-record-button">
                                    <i class="ri-delete-bin-line"></i>
                                  </button>
                                </form>
                              </td>
                            </tr>
                            <% }) %>
                              <% } else { %>
                                <tr>
                                  <td colspan="6" class="text-center py-5">
                                    <i class="ri-task-line" style="font-size:48px;color:#94a3b8;"></i>
                                    <h6 class="mt-2 mb-1">No Task Found</h6>
                                    <p class="text-muted mb-0">Create your first task for this post site.</p>
                                  </td>
                                </tr>
                                <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>


          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Site tour modal -->
