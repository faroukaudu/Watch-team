<%- include("../includes/header", { user: userInfo }); -%>

<style>
  :root {
    --wt-chat-primary: #0d4a6b;
    --wt-chat-primary-soft: rgba(13, 74, 107, 0.12);
    --wt-chat-accent: #19c6d4;
    --wt-chat-accent-soft: rgba(25, 198, 212, 0.14);
    --wt-chat-surface: rgba(255, 255, 255, 0.94);
    --wt-chat-surface-dark: rgba(15, 27, 42, 0.92);
    --wt-chat-border: rgba(125, 145, 166, 0.18);
    --wt-chat-text: #17202a;
    --wt-chat-muted: #718096;
    --wt-chat-shadow: 0 24px 70px rgba(14, 42, 66, 0.15);
  }

  .wt-chat-page {
    position: relative;
    min-height: calc(100vh - 120px);
    overflow: hidden;
  }

  .wt-chat-page::before,
  .wt-chat-page::after {
    content: "";
    position: fixed;
    z-index: 0;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    opacity: 0.22;
  }

  .wt-chat-page::before {
    top: 80px;
    right: 6%;
    background: var(--wt-chat-accent);
    animation: wtFloatGlow 9s ease-in-out infinite;
  }

  .wt-chat-page::after {
    bottom: 4%;
    left: 10%;
    background: var(--wt-chat-primary);
    animation: wtFloatGlow 11s ease-in-out infinite reverse;
  }

  @keyframes wtFloatGlow {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(0, -22px, 0) scale(1.08); }
  }

  .wt-chat-shell {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    height: calc(100vh - 245px);
    min-height: 610px;
    border: 1px solid var(--wt-chat-border);
    border-radius: 24px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.96), rgba(244,248,251,0.93));
    box-shadow: var(--wt-chat-shadow);
    backdrop-filter: blur(20px);
  }

  [data-theme-mode="dark"] .wt-chat-shell {
    background:
      linear-gradient(135deg, rgba(16,29,45,0.97), rgba(9,21,34,0.96));
  }

  .wt-chat-sidebar {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border-right: 1px solid var(--wt-chat-border);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.97), rgba(244,248,251,0.9));
  }

  [data-theme-mode="dark"] .wt-chat-sidebar {
    background:
      linear-gradient(180deg, rgba(17,31,48,0.98), rgba(11,24,38,0.96));
  }

  .wt-chat-sidebar-head {
    padding: 22px 20px 16px;
    border-bottom: 1px solid var(--wt-chat-border);
  }

  .wt-chat-kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
    color: var(--wt-chat-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .wt-chat-kicker-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--wt-chat-accent);
    box-shadow: 0 0 0 5px var(--wt-chat-accent-soft);
    animation: wtPulseDot 2s ease-in-out infinite;
  }

  @keyframes wtPulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.75); opacity: 0.55; }
  }

  .wt-chat-title {
    margin: 0;
    font-size: 22px;
    font-weight: 750;
    color: var(--wt-chat-text);
  }

  [data-theme-mode="dark"] .wt-chat-title {
    color: #f3f7fb;
  }

  .wt-chat-subtitle {
    margin: 5px 0 0;
    color: var(--wt-chat-muted);
    font-size: 12px;
  }

  .wt-chat-search {
    position: relative;
    padding: 16px 18px;
  }

  .wt-chat-search i {
    position: absolute;
    top: 50%;
    left: 33px;
    z-index: 2;
    transform: translateY(-50%);
    color: var(--wt-chat-muted);
    font-size: 17px;
  }

  .wt-chat-search input {
    height: 46px;
    padding-left: 42px;
    border: 1px solid transparent;
    border-radius: 15px;
    background: rgba(123, 145, 166, 0.09);
    color: inherit;
    transition: 180ms ease;
  }

  .wt-chat-search input:focus {
    border-color: rgba(25, 198, 212, 0.5);
    background: rgba(255,255,255,0.96);
    box-shadow: 0 0 0 4px var(--wt-chat-accent-soft);
  }

  [data-theme-mode="dark"] .wt-chat-search input:focus {
    background: rgba(17,31,48,0.98);
  }

  .wt-chat-section-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px 10px;
    color: var(--wt-chat-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .wt-chat-user-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0 10px 16px;
  }

  .wt-chat-user-list::-webkit-scrollbar,
  .wt-chat-body::-webkit-scrollbar {
    width: 7px;
  }

  .wt-chat-user-list::-webkit-scrollbar-thumb,
  .wt-chat-body::-webkit-scrollbar-thumb {
    border-radius: 10px;
    background: rgba(113, 128, 150, 0.3);
  }

  .company-user-item {
    margin-bottom: 7px;
    border-radius: 16px;
    transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;
  }

  .company-user-item > a {
    display: block;
    padding: 11px 12px;
    color: inherit;
    text-decoration: none;
  }

  .company-user-item:hover {
    transform: translateX(4px);
    background: var(--wt-chat-primary-soft);
  }

  .company-user-item.active,
  .company-user-item.checkforactive.active {
    background:
      linear-gradient(135deg, rgba(13,74,107,0.98), rgba(20,103,139,0.94));
    color: #fff;
    box-shadow: 0 12px 28px rgba(13,74,107,0.25);
  }

  .company-user-item.active .text-muted {
    color: rgba(255,255,255,0.72) !important;
  }

  .wt-user-avatar,
  .wt-chat-avatar {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 15px;
    color: #fff;
    font-weight: 700;
    background:
      linear-gradient(135deg, var(--wt-chat-primary), #167da3);
    box-shadow: 0 8px 20px rgba(13,74,107,0.2);
  }

  .wt-user-avatar::after,
  .wt-chat-avatar::after {
    content: "";
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 11px;
    height: 11px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #20c77a;
  }

  [data-theme-mode="dark"] .wt-user-avatar::after,
  [data-theme-mode="dark"] .wt-chat-avatar::after {
    border-color: #102033;
  }

  .wt-user-name {
    margin: 0 0 3px;
    font-size: 13px;
    font-weight: 700;
  }

  .wt-user-role {
    margin: 0;
    color: var(--wt-chat-muted);
    font-size: 11px;
  }

  .wt-chat-main {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background:
      radial-gradient(circle at top right, rgba(25,198,212,0.08), transparent 28%),
      linear-gradient(180deg, rgba(249,252,254,0.96), rgba(239,245,249,0.95));
  }

  [data-theme-mode="dark"] .wt-chat-main {
    background:
      radial-gradient(circle at top right, rgba(25,198,212,0.10), transparent 30%),
      linear-gradient(180deg, rgba(10,22,36,0.98), rgba(7,17,29,0.98));
  }

  .wt-chat-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 22px;
    border-bottom: 1px solid var(--wt-chat-border);
    background: rgba(255,255,255,0.68);
    backdrop-filter: blur(16px);
  }

  [data-theme-mode="dark"] .wt-chat-header {
    background: rgba(13,27,43,0.72);
  }

  .wt-chat-avatar {
    width: 46px;
    height: 46px;
  }

  .wt-chat-header-copy {
    flex: 1;
    min-width: 0;
  }

  .wt-chat-header-copy h5 {
    margin: 0;
    color: var(--wt-chat-text);
    font-size: 15px;
    font-weight: 750;
  }

  [data-theme-mode="dark"] .wt-chat-header-copy h5 {
    color: #f3f7fb;
  }

  .wt-chat-header-copy p {
    margin: 4px 0 0;
    color: #20c77a;
    font-size: 11px;
  }

  .wt-chat-actions {
    display: flex;
    gap: 8px;
  }

  .wt-chat-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--wt-chat-border);
    border-radius: 12px;
    background: rgba(255,255,255,0.72);
    color: var(--wt-chat-primary);
    transition: 160ms ease;
  }

  [data-theme-mode="dark"] .wt-chat-action {
    background: rgba(255,255,255,0.04);
    color: #d9f7fb;
  }

  .wt-chat-action:hover {
    transform: translateY(-2px);
    border-color: rgba(25,198,212,0.45);
    color: var(--wt-chat-accent);
    box-shadow: 0 10px 22px var(--wt-chat-accent-soft);
  }

.wt-chat-body {
  position: relative;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  padding: 22px 24px 28px;
  scroll-behavior: smooth;
}

/* Empty state stays centered inside the visible chat area */
.wt-chat-empty {
  position: absolute;
  inset: 0;
  z-index: 2;

  display: grid;
  place-items: center;

  padding: 30px 20px;
  text-align: center;
  color: var(--wt-chat-muted);
  pointer-events: none;
}

  .wt-chat-empty-orb {
    position: relative;
    display: grid;
    width: 96px;
    height: 96px;
    margin: 0 auto 16px;
    place-items: center;
    border-radius: 28px;
    color: #fff;
    font-size: 34px;
    background:
      linear-gradient(135deg, var(--wt-chat-primary), var(--wt-chat-accent));
    box-shadow: 0 20px 45px rgba(13,74,107,0.25);
    animation: wtOrbFloat 3.2s ease-in-out infinite;
  }

  @keyframes wtOrbFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .wt-chat-empty-orb::before,
  .wt-chat-empty-orb::after {
    content: "";
    position: absolute;
    inset: -10px;
    border: 1px solid rgba(25,198,212,0.22);
    border-radius: 34px;
    animation: wtOrbitRing 4s linear infinite;
  }

  .wt-chat-empty-orb::after {
    inset: -20px;
    animation-duration: 6s;
    animation-direction: reverse;
  }

  @keyframes wtOrbitRing {
    to { transform: rotate(360deg); }
  }

#chat-messages {
  position: relative;
  z-index: 1;

  display: flex;
  flex-direction: column;
  gap: 4px;

  min-height: 0;
  padding: 0;
  margin: 0;
  list-style: none;
}

@media (max-width: 767.98px) {
  .wt-chat-body {
    padding: 16px 14px 22px;
  }

  .wt-chat-empty {
    padding: 24px 18px;
  }

  .wt-chat-empty-orb {
    width: 78px;
    height: 78px;
    font-size: 29px;
    border-radius: 23px;
  }
}

  #chat-messages .msg-row {
    display: flex;
    flex-direction: column;
    margin: 6px 0;
    animation: wtMessageIn 220ms ease-out;
  }

  @keyframes wtMessageIn {
    from { opacity: 0; transform: translateY(7px) scale(0.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  #chat-messages .msg-row.sent { align-items: flex-end; }
  #chat-messages .msg-row.received { align-items: flex-start; }

  #chat-messages .bubble {
    position: relative;
    max-width: min(72%, 620px);
    padding: 11px 14px;
    border-radius: 18px;
    line-height: 1.45;
    word-break: break-word;
    white-space: pre-wrap;
  }

  #chat-messages .sent .bubble {
    border-bottom-right-radius: 5px;
    color: #fff;
    background:
      linear-gradient(135deg, var(--wt-chat-primary), #146d91);
    box-shadow: 0 12px 24px rgba(13,74,107,0.18);
  }

  #chat-messages .received .bubble {
    border: 1px solid var(--wt-chat-border);
    border-bottom-left-radius: 5px;
    color: var(--wt-chat-text);
    background: rgba(255,255,255,0.96);
    box-shadow: 0 10px 24px rgba(24,44,65,0.08);
  }

  [data-theme-mode="dark"] #chat-messages .received .bubble {
    color: #eef4f8;
    background: rgba(24,40,58,0.96);
  }

  #chat-messages .bubble .text {
    margin: 0;
    font-size: 13px;
  }

  #chat-messages .meta-out {
    margin-top: 4px;
    padding: 0 5px;
    color: var(--wt-chat-muted);
    font-size: 10px;
    user-select: none;
  }

  .wt-chat-composer {
    position: sticky;
    z-index: 20;
    right: 0;
    bottom: 0;
    left: 0;
    flex: 0 0 auto;
    padding: 14px 18px calc(17px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--wt-chat-border);
    background: rgba(255,255,255,0.92);
    box-shadow: 0 -14px 34px rgba(14, 42, 66, 0.10);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  [data-theme-mode="dark"] .wt-chat-composer {
    background: rgba(12,25,40,0.82);
  }

  .wt-chat-composer-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px;
    border: 1px solid var(--wt-chat-border);
    border-radius: 18px;
    background: rgba(255,255,255,0.9);
    box-shadow: 0 12px 30px rgba(25,52,75,0.07);
  }

  [data-theme-mode="dark"] .wt-chat-composer-inner {
    background: rgba(18,34,51,0.96);
  }

  .wt-chat-composer input {
    min-width: 0;
    height: 42px;
    border: 0;
    background: transparent;
    box-shadow: none !important;
  }

  .wt-composer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 13px;
    transition: 160ms ease;
  }

  .wt-composer-btn.secondary {
    color: var(--wt-chat-primary);
    background: var(--wt-chat-primary-soft);
  }

  .wt-composer-btn.send {
    color: #fff;
    background:
      linear-gradient(135deg, var(--wt-chat-primary), var(--wt-chat-accent));
    box-shadow: 0 10px 24px rgba(13,74,107,0.22);
  }

  .wt-composer-btn:hover {
    transform: translateY(-2px) scale(1.02);
  }

  .wt-chat-offcanvas {
    background:
      linear-gradient(180deg, #10243a, #091827);
    color: #fff;
  }

  .wt-details-card {
    padding: 24px;
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 22px;
    background: rgba(255,255,255,0.055);
    backdrop-filter: blur(14px);
  }

  .wt-details-avatar {
    display: grid;
    width: 88px;
    height: 88px;
    margin: 0 auto 14px;
    place-items: center;
    border-radius: 28px;
    color: #fff;
    font-size: 30px;
    font-weight: 800;
    background:
      linear-gradient(135deg, var(--wt-chat-primary), var(--wt-chat-accent));
    box-shadow: 0 18px 45px rgba(25,198,212,0.18);
  }

  @media (max-width: 991.98px) {
    .wt-chat-shell {
      grid-template-columns: 285px minmax(0, 1fr);
      min-height: 570px;
    }
  }

  @media (max-width: 767.98px) {
    .wt-chat-page {
      min-height: 0;
      overflow: visible;
    }

    .wt-chat-shell {
      display: flex;
      height: auto;
      min-height: 0;
      overflow: visible;
      flex-direction: column;
      border-radius: 18px;
    }

    .wt-chat-sidebar {
      max-height: 320px;
      border-right: 0;
      border-bottom: 1px solid var(--wt-chat-border);
    }

    .wt-chat-main {
      height: calc(100dvh - 150px);
      min-height: 500px;
      max-height: 760px;
      overflow: hidden;
    }

    .wt-chat-header {
      padding: 12px 14px;
    }

    .wt-chat-body {
      padding: 16px 14px 24px;
    }

    .wt-chat-composer {
      padding: 10px 10px calc(10px + env(safe-area-inset-bottom));
    }

    .wt-chat-composer-inner {
      gap: 7px;
      padding: 6px;
      border-radius: 16px;
    }

    .wt-chat-composer input {
      height: 40px;
      font-size: 16px;
    }

    .wt-composer-btn {
      width: 39px;
      height: 39px;
      border-radius: 12px;
    }

    #chat-messages .bubble {
      max-width: 88%;
    }
  }

  @media (max-width: 479.98px) {
    .wt-chat-sidebar {
      max-height: 280px;
    }

    .wt-chat-main {
      height: calc(100dvh - 118px);
      min-height: 480px;
    }

    .wt-chat-actions .wt-chat-action:nth-child(-n + 2) {
      display: none;
    }

    .wt-chat-header-copy h5 {
      max-width: 180px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #chat-messages .bubble {
      max-width: 92%;
    }
  }
</style>

<div class="main-content app-content wt-chat-page">
  <div class="container-fluid">

    <div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <div class="wt-chat-kicker">
          <span class="wt-chat-kicker-dot"></span>
          Secure Company Communication
        </div>
        <h1 class="page-title fw-semibold fs-20 mb-1">Messenger</h1>
        <p class="text-muted mb-0 fs-12">Real-time communication across your Watch Team network.</p>
      </div>

      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success-transparent px-3 py-2">
          <i class="ri-shield-check-line me-1"></i>
          Secure Channel
        </span>
      </div>
    </div>

    <div class="wt-chat-shell mb-4">

      <aside class="wt-chat-sidebar">
        <div class="wt-chat-sidebar-head">
          <div class="wt-chat-kicker">
            <span class="wt-chat-kicker-dot"></span>
            Live Network
          </div>
          <h2 class="wt-chat-title">Company Users</h2>
          <p class="wt-chat-subtitle">Select a teammate to begin a secure conversation.</p>
        </div>

        <div class="wt-chat-search">
          <i class="ri-search-2-line"></i>
          <input
            id="chat-search"
            type="text"
            class="form-control"
            placeholder="Search users..."
            autocomplete="off"
          />
        </div>

        <div class="wt-chat-section-label">
          <span>Available contacts</span>
          <span><%= companyUsers && companyUsers.length ? companyUsers.length : 0 %></span>
        </div>

        <div class="wt-chat-user-list" id="chat-msg-scroll">
          <ul class="list-unstyled mb-0">
            <% if (companyUsers && companyUsers.length) { %>
              <% companyUsers.forEach((u) => {
                const displayName = (u.fullname && u.fullname.trim())
                  ? u.fullname
                  : (u.username || "User");
                const firstLetter = displayName.trim().charAt(0).toUpperCase();
              %>
                <li
                  class="checkforactive company-user-item"
                  data-user-id="<%= u._id %>"
                  data-user-name="<%- displayName %>"
                >
                  <a
                    href="javascript:void(0);"
                    onclick="selectUser('<%= u._id %>','<%- displayName %>')"
                  >
                    <div class="d-flex align-items-center gap-3">
                      <span class="wt-user-avatar">
                        <%= firstLetter %>
                      </span>

                      <div class="flex-fill min-w-0">
                        <p class="wt-user-name text-truncate"><%- displayName %></p>
                        <p class="wt-user-role text-truncate"><%= u.userType %></p>
                      </div>

                      <span class="text-muted fs-11">
                        <i class="ri-arrow-right-s-line"></i>
                      </span>
                    </div>
                  </a>
                </li>
              <% }) %>
            <% } else { %>
              <li class="px-3 py-5 text-center text-muted">
                <div class="mb-2 fs-24">
                  <i class="ri-user-search-line"></i>
                </div>
                No company users found.
              </li>
            <% } %>
          </ul>
        </div>
      </aside>

      <section class="wt-chat-main">
        <header class="wt-chat-header">
          <span class="wt-chat-avatar" id="chat-header-avatar">
            <span id="chat-header-letter">?</span>
          </span>

          <div class="wt-chat-header-copy">
            <h5 id="chat-header-name">Select a User</h5>
            <p id="chat-header-status">
              <i class="ri-radio-button-line me-1"></i>
              Ready when you are
            </p>
          </div>

          <div class="wt-chat-actions">
            <button type="button" class="wt-chat-action" aria-label="Voice call" title="Voice call">
              <i class="ti ti-phone"></i>
            </button>
            <button type="button" class="wt-chat-action" aria-label="Video call" title="Video call">
              <i class="ti ti-video"></i>
            </button>
            <button
              type="button"
              class="wt-chat-action responsive-userinfo-open"
              data-bs-toggle="offcanvas"
              data-bs-target="#offcanvasRight"
              aria-controls="offcanvasRight"
              aria-label="User information"
              title="User information"
            >
              <i class="ti ti-user-circle" id="responsive-chat-close"></i>
            </button>
          </div>
        </header>

        <div class="wt-chat-body" id="wt-chat-body">
