<!-- Small helpers to keep avatar letters in sync with selected user -->
<script>
  // Wrap selectUser to also update header/offcanvas letters without changing your client_chat.js logic
  (function () {
    const originalSelectUser = window.selectUser;

    window.selectUser = async function (userId, userName) {
      // Update header + offcanvas letters instantly
      const letter = (userName || "?").trim().charAt(0).toUpperCase() || "?";
      const headerName = document.getElementById("chat-header-name");
      const headerLetter = document.getElementById("chat-header-letter");
      const emptyHint = document.getElementById("chat-empty-hint");

      const detailsName = document.getElementById("details-name");
      const detailsLetter = document.getElementById("details-letter");

      if (headerName) headerName.textContent = userName || "Select a User";
      if (headerLetter) headerLetter.textContent = letter;

      if (detailsName) detailsName.textContent = userName || "Select a user";
      if (detailsLetter) detailsLetter.textContent = letter;

      if (emptyHint) emptyHint.style.display = "none";

      // Call your real selectUser from client_chat.js
      if (typeof originalSelectUser === "function") {
        return await originalSelectUser(userId, userName);
      }
    };

    // Simple local search filter (keeps your UI nice)
    const input = document.getElementById("chat-search");
    if (input) {
      input.addEventListener("input", function () {
        const q = (this.value || "").toLowerCase();
        document.querySelectorAll(".company-user-item").forEach((li) => {
          const name = (li.getAttribute("data-user-name") || "").toLowerCase();
          li.style.display = name.includes(q) ? "" : "none";
        });
      });
    }
  })();
</script>

