<style>
    /* WhatsApp-like layout */
#chat-messages {
  list-style: none;
  padding: 12px;
  margin: 0;
}

#chat-messages .msg-row {
  display: flex;
  flex-direction: column;
  margin: 6px 0;
  position: relative;
}

#chat-messages .msg-row.sent {
  align-items: flex-end;
}

#chat-messages .msg-row.received {
  align-items: flex-start;
}

/* Bubble */
#chat-messages .bubble {
  max-width: min(70%, 520px);
  padding: 10px 12px;
  border-radius: 14px;
  position: relative;
  line-height: 1.35;
  word-break: break-word;
  white-space: pre-wrap;
  box-shadow: 0 1px 1px rgba(0,0,0,0.08);
}

#chat-messages .sent .bubble {
  background: #95cf83;  /* darker than #dcf8c6 */
  border-top-right-radius: 6px;
}
#chat-messages .sent .bubble::after {
  border-left-color: #b7f0a5; /* tail matches bubble */
}

#chat-messages .received .bubble {
  background: #ffffff;
  border-top-left-radius: 6px;
}

#chat-messages .bubble .text {
  margin: 0;
  font-size: 14px;
  color: #111;
}

/* ✅ Time OUTSIDE the bubble */
#chat-messages .meta-out {
  margin-top: 3px;
  font-size: 11px;
  opacity: 0.65;
  user-select: none;
}

#chat-messages .sent .meta-out {
  text-align: right;
  padding-right: 6px; /* aligns under bubble tail */
}

#chat-messages .received .meta-out {
  text-align: left;
  padding-left: 6px; /* aligns under bubble tail */
}

/* ✅ Bubble tail (arrow) using pseudo elements */
#chat-messages .sent .bubble::after {
  content: "";
  position: absolute;
  right: -6px;
  top: 10px;
  width: 0;
  height: 0;
  border-left: 6px solid #95cf83;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
}

#chat-messages .received .bubble::after {
  content: "";
  position: absolute;
  left: -6px;
  top: 10px;
  width: 0;
  height: 0;
  border-right: 6px solid #ffffff;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
}

</style>
