                                    <script>
                                        document.addEventListener('change', async (e) => {
                                            if (!e.target.matches('.clientSelect')) return;

                                            const form = e.target.closest('.assign-form');     // scope to the correct pair
                                            const siteSelect = form.querySelector('.siteSelect');
                                            const clientId = e.target.value;

                                            // reset target dropdown
                                            siteSelect.innerHTML = '<option value="">-- Select a client first --</option>';
                                            siteSelect.disabled = true;

                                            if (!clientId) return;

                                            try {
                                                const res = await fetch(`/api/clients/${encodeURIComponent(clientId)}/sites`, {
                                                    headers: { 'Accept': 'application/json' }
                                                });
                                                if (!res.ok) throw new Error('Failed to load sites');

                                                // Expecting { sites: [...] }. If your server does res.send(sites), handle both:
                                                const data = await res.json();
                                                const sites = Array.isArray(data) ? data : (data.sites || []);

                                                if (!sites.length) {
                                                    siteSelect.innerHTML = '<option value="">No sites for this client</option>';
                                                    return;
                                                }

                                                siteSelect.innerHTML = '<option value="">-- Select Site --</option>';
                                                sites.forEach(s => {
                                                    const opt = document.createElement('option');
                                                    opt.value = s._id || s.siteId || s.value || s.siteName;  // adjust to your schema
                                                    opt.textContent = s.siteName || s.name || String(opt.value);
                                                    siteSelect.appendChild(opt);
                                                });
                                                siteSelect.disabled = false;
                                            } catch (err) {
                                                console.error(err);
                                                siteSelect.innerHTML = '<option value="">Error loading sites</option>';
                                            }
                                        });
                                    </script>





