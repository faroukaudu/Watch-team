<script>
  $(function () {
    function applyMode(mode) {
      if (mode === 'email') {
        // Hide phone, disable & remove name so it won't validate or submit
        $('#phoneCol').addClass('d-none').hide();
        $('#phone').prop('disabled', true).prop('required', false).removeAttr('name');

        // Show email, enable & require, and give it the name the server expects
        $('#emailCol').removeClass('d-none').show();
        $('#email').prop('disabled', false).prop('required', true).attr('name', 'email');
      } else {
        // Show phone
        $('#phoneCol').removeClass('d-none').show();
        $('#phone').prop('disabled', false).prop('required', true).attr('name', 'phone');

        // Hide email
        $('#emailCol').addClass('d-none').hide();
        $('#email').prop('disabled', true).prop('required', false).removeAttr('name');
      }
    }

    $('#floatingSelect').on('change', function () {
      applyMode(this.value); // 'sms' or 'email'
    });

    // Initial state
    applyMode($('#floatingSelect').val());
  });
</script>