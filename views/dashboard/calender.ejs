                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="col-xl-9">
                        <div class="card custom-card">
                            <div class="card-header justify-content-between">
                              <div class="card-title">All Events</div>
                              <button class="btn btn-primary btn-wave"><i class="ri-add-line align-middle me-1 fw-medium d-inline-block"></i>Create New Event</button>
                            </div>
                            <div class="card-body p-0">
                                <div id="external-events" class="border-bottom p-3 d-flex align-items-center flex-wrap gap-3">
