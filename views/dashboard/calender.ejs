        <!-- Start::app-content -->
        <div class="main-content app-content">
            <div class="container-fluid">

              <!-- Page Header -->
              <div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
                  <div>
                      <h1 class="page-title fw-medium fs-18 mb-2">Full Calendar</h1>
                      <div class="">
                          <nav>
                              <ol class="breadcrumb mb-0">
                                  <li class="breadcrumb-item"><a href="javascript:void(0);">Apps</a></li>
                                  <li class="breadcrumb-item active" aria-current="page">Full Calendar</li>
                              </ol>
                          </nav>
                      </div>
                  </div>
                  <div>
                      <button class="btn btn-primary-light btn-wave me-2 waves-effect waves-light">
                          <i class="bx bx-crown align-middle"></i> Plan Upgrade
                      </button>
                      <button class="btn btn-secondary-light btn-wave me-0">
                          <i class="ri-upload-cloud-line align-middle"></i> Export Report
                      </button>
                  </div>
              </div>
              <!-- Page Header Close -->


               <!-- Modal -->
<div class="modal fade" id="add-task" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">Add Task</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body px-4">
        <div class="row gy-2">

          <div class="col-xl-12">
            <label for="taskPostSite" class="form-label">Title</label>
            <input type="text" class="form-control" id="title" placeholder="Task Title">
          </div>
            <div class="col-xl-6">
            <label class="form-label">Assign to</label>
            <select class="form-control" id="taskTags" >
            <option value="" selected hidden>--- Select a Guard ---</option>
             <% guard.forEach(function(g){ %>
                
                 <option value="<%= g._id%>"><%= g.fullname%></option>
             <% }) %>
              <!-- <option value="Marketing">Marketing</option>
              <option value="Finance">Finance</option>
              <option value="Designing">Designing</option>
              <option value="Admin">Admin</option>
              <option value="Authentication">Authentication</option>
              <option value="Product">Product</option>
              <option value="Development">Development</option> -->
            </select>
          </div>
          

          

          <div class="col-xl-6">
            <label for="taskFrequency" class="form-label">Frequency</label>
            <textarea  class="form-control" id="taskFrequency" rows="1" placeholder="e.g. Daily, Weekly, Once"></textarea>
          </div>

          <div class="col-xl-6">
            <label class="form-label">Post Site</label>
            <select class="form-control" id="choices-multiple-remove-button1" >
                <option value="" selected hidden>--- Select Post Site ---</option>
              <% post.forEach(function(p){ %>
                <option value="<%=p._id%>"><%= p.siteName%></option>
                
              <% }) %>
              <!-- <option value="Kiara advain">Kiara advain</option>
              <option value="Hercules Jhon">Hercules Jhon</option>
              <option value="Mayor Kim">Mayor Kim</option> -->
            </select>
          </div>

          <div class="col-xl-6">
            <label class="form-label">Target Date</label>
            <div class="input-group">
              <div class="input-group-text text-muted"><i class="ri-calendar-line"></i></div>
              <input type="text" class="form-control" id="targetDate" placeholder="Choose date and time">
            </div>
          </div>

          <div class="col-xl-12">
            <label for="taskEmail" class="form-label">Description</label>
            <input type="text" class="form-control" id="taskEmail" placeholder="Email">
          </div>

        

        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="submitTaskBtn">Add Task</button>
      </div>
    </div>
  </div>
</div>

                <!-- Start::row-1 -->
                <div class="row">
                    <div class="col-xl-3">
                      <div class="card custom-card">
                        <div class="card-body p-0">
