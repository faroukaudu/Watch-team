<%- include("../includes/header", {user: userInfo || user || { fullname: "User" }}); -%>

    <style>
       .dispatch-hero {
  background: linear-gradient(135deg, #071029 0%, #191044 40%, #213037 100%);
  border-radius: 20px;
  padding: 26px;
  color: #fff;
  margin-bottom: 24px;
  box-shadow: 0 18px 45px rgba(5, 11, 23, 0.35);
  position: relative;
  overflow: hidden;
}
.dispatch-hero::after {
  content: "";
  position: absolute;
  top: -40px;
  right: -40px;
  width: 180px;
  height: 180px;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.dispatch-hero h2 {
  font-size: 22px;
  color: #dbeafe;
}

.dispatch-hero p {
  font-size: 13px;
}


        .dispatch-stat-card {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 14px;
            padding: 16px;
            backdrop-filter: blur(8px);
        }

        .dispatch-table-card {
            border-radius: 18px;
            overflow: hidden;
            border: 1px solid #edf1f7;
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
        }

        .dispatch-table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .04em;
            border-bottom: 1px solid #e5e7eb;
        }

        .dispatch-table tbody tr {
            transition: all .2s ease;
        }

        .dispatch-table tbody tr:hover {
            background: #f8fafc;
        }

        .ticket-pill {
            background: #eff6ff;
            color: #1d4ed8;
            border-radius: 999px;
            padding: 6px 10px;
            font-weight: 700;
            font-size: 12px;
        }

        .dispatch-icon-box {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: #eff6ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .empty-dispatch {
            padding: 70px 20px;
            text-align: center;
        }

        .empty-dispatch-icon {
            width: 86px;
            height: 86px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: linear-gradient(135deg, #dbeafe, #eff6ff);
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 42px;
        }
    </style>

    <div class="main-content app-content">
        <div class="container-fluid">

            <% const totalDispatch=dispatchList ? dispatchList.length : 0; const pendingDispatch=dispatchList ?
                dispatchList.filter(d=> d.status !== 'Accepted').length : 0;
                const acceptedDispatch = dispatchList ? dispatchList.filter(d => d.status === 'Accepted').length : 0;
                const highPriority = dispatchList ? dispatchList.filter(d => d.priority === 'High').length : 0;
                %>

                <div class="dispatch-hero">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <h2 class="fw-bold mb-1 ">Dispatch Center</h2>
                            <p class="mb-0 text-white-50">
                                Create, assign, monitor, and manage security dispatch tickets.
                            </p>
                        </div>

                        <a href="/new-dispatch" class="btn btn-light btn-wave fw-semibold">
                            <i class="ri-add-line me-1"></i> Add New Dispatch
                        </a>
                    </div>

                    <div class="row mt-4 g-3">
                        <div class="col-xl-3 col-md-6">
                            <div class="dispatch-stat-card">
                                <p class="mb-1 text-white-50">Total Dispatch</p>
                                <h3 class="fw-bold  mb-0">
                                    <%= totalDispatch %>
                                </h3>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <div class="dispatch-stat-card">
                                <p class="mb-1 text-white-50">Pending</p>
                                <h3 class="fw-bold  mb-0">
                                    <%= pendingDispatch %>
                                </h3>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <div class="dispatch-stat-card">
                                <p class="mb-1 text-white-50">Accepted</p>
                                <h3 class="fw-bold  mb-0">
                                    <%= acceptedDispatch %>
                                </h3>
                            </div>
                        </div>

                        <div class="col-xl-3 col-md-6">
                            <div class="dispatch-stat-card">
                                <p class="mb-1 text-white-50">High Priority</p>
                                <h3 class="fw-bold  mb-0">
                                    <%= highPriority %>
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card custom-card dispatch-table-card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h5 class="card-title mb-1">Dispatch Tickets</h5>
                            <small class="text-muted">All dispatch records for this company</small>
                        </div>

                        <div style="min-width:280px;">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="ri-search-line"></i>
                                </span>
                                <input type="text" id="dispatchSearch" class="form-control border-start-0"
                                    placeholder="Search ticket, client, guard, incident...">
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table dispatch-table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Ticket</th>
                                        <th>Client / Post Site</th>
                                        <th>Assigned Guard</th>
                                        <th>Priority</th>
                                        <th>Incident</th>
                                        <th>Status</th>
                                        <th>Date & Time</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% if (dispatchList && dispatchList.length> 0) { %>
                                        <% dispatchList.forEach(function(item){ %>
                                            <tr class="dispatch-row <%= item.status === 'Accepted' ? 'dispatch-accepted' : '' %>">
                                                <td>
                                                    <span class="ticket-pill">
                                                        <%= item.ticketId %>
                                                    </span>
                                                </td>

                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="dispatch-icon-box">
                                                            <i class="ri-building-4-line"></i>
                                                        </div>
                                                        <div>
                                                            <div class="fw-semibold">
                                                                <%= item.clientName || 'N/A' %>
                                                            </div>
                                                            <small class="text-muted">
                                                                <i class="ri-map-pin-line me-1"></i>
                                                                <%= item.postSiteName || 'No Post Site' %>
                                                            </small>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td>
                                                    <div class="fw-semibold">
                                                        <%= item.guardName || 'Not Assigned' %>
                                                    </div>
                                                    <small class="text-muted">Security Guard</small>
                                                </td>

                                                <td>
                                                    <% if(item.priority==='High' ){ %>
                                                        <span class="badge bg-danger-transparent text-danger">
                                                            <i class="ri-error-warning-line me-1"></i>High
                                                        </span>
                                                        <% } else if(item.priority==='Medium' ){ %>
                                                            <span class="badge bg-warning-transparent text-warning">
                                                                <i class="ri-alert-line me-1"></i>Medium
                                                            </span>
                                                            <% } else { %>
                                                                <span class="badge bg-info-transparent text-info">
                                                                    <i class="ri-information-line me-1"></i>Low
                                                                </span>
                                                                <% } %>
                                                </td>

                                                <td>
                                                    <div class="fw-semibold">
                                                        <%= item.incidentType || 'N/A' %>
                                                    </div>
                                                    <small class="text-muted">
                                                        <%= item.incidentLocation || 'No location' %>
                                                    </small>
                                                </td>

                                                <td>
                                                    <% if(item.status==='Accepted' ){ %>
                                                        <span class="badge bg-success">
                                                            <i class="ri-checkbox-circle-line me-1"></i>Accepted
                                                        </span>
                                                        <% } else { %>
                                                            <span class="badge bg-warning">
                                                                <i class="ri-time-line me-1"></i>Pending
                                                            </span>
                                                            <% } %>
                                                </td>

                                                <td>
                                                    <div class="fw-semibold">
                                                        <%= item.incidentDateTime ? new
                                                            Date(item.incidentDateTime).toLocaleDateString() : 'N/A' %>
                                                    </div>
                                                    <small class="text-muted">
                                                        <%= item.incidentDateTime ? new
                                                            Date(item.incidentDateTime).toLocaleTimeString([],
                                                            {hour: '2-digit' , minute:'2-digit'}) : '' %>
                                                    </small>
                                                </td>

                                                <td class="text-end">
                                                    <a href="/edit-dispatch/<%= item._id %>"
                                                        class="btn btn-sm btn-light">
                                                        <i class="ri-edit-line me-1"></i>Edit
                                                    </a>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="8">
                                                            <div class="empty-dispatch">
                                                                <div class="empty-dispatch-icon">
                                                                    <i class="ri-file-list-3-line"></i>
                                                                </div>
                                                                <h5 class="fw-bold mb-1">No Dispatch Found</h5>
                                                                <p class="text-muted mb-3">Create your first dispatch
                                                                    ticket and assign it to a guard.</p>
                                                                <a href="/new-dispatch"
                                                                    class="btn btn-light btn-wave fw-semibold">
                                                                    <i class="ri-add-line me-1"></i> Add New Dispatch
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("dispatchSearch");
            const rows = document.querySelectorAll(".dispatch-row");

            if (searchInput) {
                searchInput.addEventListener("keyup", function () {
                    const value = this.value.toLowerCase();

                    rows.forEach(row => {
                        const text = row.innerText.toLowerCase();
                        row.style.display = text.includes(value) ? "" : "none";
                    });
                });
            }
        });
    </script>


    <%- include("../includes/footer"); -%>

        <!-- Scroll To Top -->
        <div class="scrollToTop">
            <span class="arrow lh-1"><i class="ri-rocket-line align-middle fs-18"></i></span>
        </div>
        <div id="responsive-overlay"></div>
        <!-- Scroll To Top -->

        <!-- Popper JS -->
        <script src="assets/libs/@popperjs/core/umd/popper.min.js"></script>

        <!-- Bootstrap JS -->
        <script src="assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>

        <!-- Defaultmenu JS -->
        <script src="assets/js/defaultmenu.min.js"></script>

        <!-- Node Waves JS-->
        <script src="assets/libs/node-waves/waves.min.js"></script>

        <!-- Sticky JS -->
        <script src="assets/js/sticky.js"></script>

        <!-- Simplebar JS -->
        <script src="assets/libs/simplebar/simplebar.min.js"></script>
        <script src="assets/js/simplebar.js"></script>

        <!-- Auto Complete JS -->
        <script src="assets/libs/@tarekraafat/autocomplete.js/autoComplete.min.js"></script>

        <!-- Color Picker JS -->
        <script src="assets/libs/@simonwep/pickr/pickr.es5.min.js"></script>

        <!-- Date & Time Picker JS -->
        <script src="assets/libs/flatpickr/flatpickr.min.js"></script>


        <!-- Apex Charts JS -->
        <script src="assets/libs/apexcharts/apexcharts.min.js"></script>

        <!-- Sales Dashboard -->
        <script src="assets/js/sales-dashboard.js"></script>

        <!-- Custom JS -->
        <script src="assets/js/custom.js"></script>


        <!-- Custom-Switcher JS -->
        <script src="assets/js/custom-switcher.min.js"></script>

        <!-- Google Maps API -->
        <script src="https://maps.google.com/maps/api/js?key=AIzaSyCW16SmpzDNLsrP-npQii6_8vBu_EJvEjA"></script>

        <!-- Google Maps JS -->
        <script src="assets/libs/gmaps/gmaps.min.js"></script>
        <script src="assets/js/google-maps.js"></script>

        <!-- Custom JS -->
        <script src="assets/js/custom.js"></script>
        <script src="../assets/js/apexcharts-column.js"></script>

        </body>

        </html>