<%- include('../partials/header') %>

<div class="container-fluid py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="mb-1">Site Tours</h3>
      <p class="text-muted mb-0"><%= postSiteName || 'Post Site' %></p>
    </div>

    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTourModal">
      Create Site Tour
    </button>
  </div>

  <% if (success && success.length > 0) { %>
    <div class="alert alert-success"><%= success[0] %></div>
  <% } %>

  <% if (error && error.length > 0) { %>
    <div class="alert alert-danger"><%= error[0] %></div>
  <% } %>

  <% if (!tours || tours.length === 0) { %>
    <div class="card">
      <div class="card-body text-center py-5">
        <h5>No site tours created yet</h5>
        <p class="text-muted">Create a tour and add checkpoints such as gates, doors, parking lots, junctions, or equipment rooms.</p>
      </div>
    </div>
  <% } %>

  <% tours.forEach(function(tour) { %>
    <div class="card mb-4 shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <h5 class="mb-0"><%= tour.tourName %></h5>
          <small class="text-muted"><%= tour.description || '' %></small>
        </div>
        <span class="badge bg-dark"><%= tour.checkpoints.length %> checkpoints</span>
      </div>

      <div class="card-body">
        <div class="row">
          <% tour.checkpoints.forEach(function(point, index) { %>
            <div class="col-md-3 col-sm-6 mb-4">
              <div class="border rounded p-3 h-100 text-center">
                <h6 class="mb-2"><%= index + 1 %>. <%= point.name %></h6>

                <img
                  class="img-fluid mb-2"
                  style="max-width: 150px;"
                  src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=<%= encodeURIComponent(point.qrCodeValue) %>"
                  alt="QR Code"
                >

                <p class="small text-muted mb-1">QR Value</p>
                <small style="word-break: break-all;"><%= point.qrCodeValue %></small>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="card-footer text-end">
        <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
          Print QR Codes
        </button>
      </div>
    </div>
  <% }) %>
</div>

<div class="modal fade" id="createTourModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <form method="POST" action="/site-tours/create" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Create Site Tour</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <input type="hidden" name="companyId" value="<%= companyId %>">
        <input type="hidden" name="postSiteId" value="<%= postSiteId %>">
        <input type="hidden" name="postSiteName" value="<%= postSiteName %>">

        <div class="mb-3">
          <label class="form-label">Tour Name</label>
          <input type="text" name="tourName" class="form-control" placeholder="Example: Night Patrol Tour" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Description</label>
          <textarea name="description" class="form-control" rows="2" placeholder="Optional description"></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">Checkpoints / Junctions</label>
          <textarea
            name="checkpoints"
            class="form-control"
            rows="8"
            placeholder="Enter one checkpoint per line, e.g.&#10;Main Gate&#10;Parking Lot&#10;Generator Room&#10;Back Exit"
            required
          ></textarea>
          <small class="text-muted">Enter one checkpoint per line. Each checkpoint will automatically receive a QR code.</small>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create Tour</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
<!-- Scroll To Top -->
