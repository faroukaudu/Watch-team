<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Live Tracking</title>

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/socket.io/socket.io.js"></script>

  <style>
    html, body { height: 100%; margin: 0; }
    #liveMap { height: 420px; width: 100%; border-radius: 14px; overflow: hidden; }

    .status-badge{
      font: 12px/1.2 system-ui, Arial;
      position: absolute;
      right: 12px;
      top: 12px;
      background: rgba(0,0,0,0.55);
      color: #fff;
      padding: 8px 10px;
      border-radius: 10px;
      backdrop-filter: blur(6px);
      z-index: 999;
    }

    /* ===== DEFAULT LEAFLET PIN + PULSE ===== */
    .lf-wrap{
      position: relative;
      width: 25px;   /* default marker width */
      height: 41px;  /* default marker height */
      /* pointer-events: none; */
      transform: translate(-12px, -41px); /* anchor tip */
      filter: drop-shadow(0 6px 10px rgba(0,0,0,0.35));
    }

    /* Big visible pulse at the tip */
    .lf-pulse{
      position: absolute;
      left: 50%;
      bottom: 2px;
      width: 18px;
      height: 18px;
      transform: translateX(-50%);
      border-radius: 50%;
      background: rgba(0, 136, 255, 0.35);
      box-shadow: 0 0 0 8px rgba(0, 136, 255, 0.18);
      animation: lfPulse 1.25s ease-out infinite;
      pointer-events: none;
    }
    @keyframes lfPulse{
      0%   { transform: translateX(-50%) scale(1); opacity: 0.95; }
      100% { transform: translateX(-50%) scale(7.2); opacity: 0; }
    }

    /* the default leaflet marker png */
    .lf-pin{
      position: absolute;
      left: 0;
      top: 0;
      width: 25px;
      height: 41px;
      pointer-events: none;
      user-select: none;
    }
  </style>
</head>

<body>
  <div id="liveMap"></div>
  <div class="status-badge">Status: <span id="statusText">waiting…</span></div>

  <script>
    const companyId   = "<%= userInfo.assignedCompanyID %>";
    const pageGuardId = "<%= guardId || '' %>"; // one guard id (recommended)

    const statusText = document.getElementById("statusText");
    const setStatus = (t) => statusText.textContent = t;

    // URLs for Leaflet's default marker images
    const LEAFLET_PIN_URL =
      "https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png";
    const LEAFLET_PIN_URL_2X =
      "https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png";
    const LEAFLET_SHADOW_URL =
      "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png";

    // ===== map =====
    const map = L.map("liveMap").setView([9.0765, 7.3986], 16);

    const satellite = L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 19, attribution: "Tiles © Esri" }
    ).addTo(map);

    const dark = L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
      { maxZoom: 20, attribution: "&copy; OpenStreetMap &copy; CARTO" }
    );

    L.control.layers({ "Satellite": satellite, "Dark": dark }).addTo(map);
    setTimeout(() => map.invalidateSize(), 200);

    // ===== marker store =====
    const markers = new Map();

    // ===== cache last location (ONLY used after guard becomes online) =====
    function saveLastLoc(guardId, payload) {
      try { localStorage.setItem("lastLoc:" + guardId, JSON.stringify(payload)); } catch {}
    }
    function loadLastLoc(guardId) {
      try {
        const s = localStorage.getItem("lastLoc:" + guardId);
        return s ? JSON.parse(s) : null;
      } catch { return null; }
    }

    // ✅ Create a DivIcon that visually uses Leaflet's default pin + pulse
    function createDefaultPinWithPulse() {
      // Use srcset so retina devices look crisp
      const html = `
        <div class="lf-wrap">
          <div class="lf-pulse"></div>
          <img class="lf-pin"
               src="${LEAFLET_PIN_URL}"
               srcset="${LEAFLET_PIN_URL_2X} 2x"
               alt="pin" />
        </div>
      `;

      return L.divIcon({
        className: "",
        html,
        iconSize: [25, 41],
        iconAnchor: [12, 41],   // tip of the pin
        popupAnchor: [0, -36],
      });
    }

    const DEFAULT_PIN_ICON = createDefaultPinWithPulse();

    // ✅ Create/update marker using our default-pin-with-pulse icon
    function upsertMarkerFromPayload(p, { pan = false } = {}) {
      const lat = Number(p.lat);
      const lng = Number(p.lng);
      if (Number.isNaN(lat) || Number.isNaN(lng)) return;

      const guardId = String(p.guardId);
      const guardName = (p.guardName && String(p.guardName).trim())
        ? String(p.guardName).trim()
        : guardId;

      const latlng = [lat, lng];

      if (!markers.has(guardId)) {
        const marker = L.marker(latlng, { icon: DEFAULT_PIN_ICON }).addTo(map);
        marker.bindPopup(`Guard: ${guardName}`);        // <-- popup text here
        markers.set(guardId, marker);
      } else {
        const m = markers.get(guardId);
        m.setLatLng(latlng);
        m.setPopupContent(`Guard: ${guardName}`);       // <-- popup update here
      }

      if (pan) map.flyTo([lat, lng], 17, {
    animate: true,
    duration: 1.2
});
    }

    setStatus("waiting for guard to check in…");

    // ===== socket =====
    const socket = io();

    socket.on("connect", () => {
      const joinPayload = { companyId };
      if (pageGuardId) joinPayload.guardId = pageGuardId;
      socket.emit("join", joinPayload);
      setStatus("connected (waiting…)");
    });

    socket.on("guard:location", (p) => {
      if (pageGuardId && String(p.guardId) !== String(pageGuardId)) return;

      upsertMarkerFromPayload(p, { pan: false });
      saveLastLoc(String(p.guardId), p);
      setStatus("online (tracking)");
    });

    socket.on("guard:online", ({ guardId }) => {
      const gid = String(guardId);
      if (pageGuardId && gid !== String(pageGuardId)) return;

      const cached = loadLastLoc(gid);
      if (cached) {
        upsertMarkerFromPayload(cached, { pan: true });
        setStatus("online (restored last loc)");
      } else {
        setStatus("online (waiting for GPS)");
      }
    });

    socket.on("guard:offline", ({ guardId }) => {
      const gid = String(guardId);
      if (pageGuardId && gid !== String(pageGuardId)) return;

      const m = markers.get(gid);
      if (m) {
        map.removeLayer(m);
        markers.delete(gid);
      }
      setStatus("offline (checked out)");
    });
  </script>
</body>
</html>
