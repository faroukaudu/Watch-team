<%- include("../includes/header", {user:userInfo}); -%>

 <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/socket.io/socket.io.js"></script>

 <style>
    html, body { height: 100%; margin: 0; }
    #liveMap { height: 420px; width: 100%; border-radius: 14px; overflow: hidden; }

    .status-badge{
      font: 12px/1.2 system-ui, Arial;
      position: absolute;
      right: 12px;
      top: 12px;
      background: rgba(0,0,0,0.55);
      color: #fff;
      padding: 8px 10px;
      border-radius: 10px;
      backdrop-filter: blur(6px);
      z-index: 999;
    }

    /* ===== DEFAULT LEAFLET PIN + PULSE ===== */
    .lf-wrap{
      position: relative;
      width: 25px;   /* default marker width */
      height: 41px;  /* default marker height */
      /* pointer-events: none; */
      transform: translate(-12px, -41px); /* anchor tip */
      filter: drop-shadow(0 6px 10px rgba(0,0,0,0.35));
    }

    /* Big visible pulse at the tip */
    .lf-pulse{
      position: absolute;
      left: 50%;
      bottom: 2px;
      width: 18px;
      height: 18px;
      transform: translateX(-50%);
      border-radius: 50%;
      background: rgba(0, 136, 255, 0.35);
      box-shadow: 0 0 0 8px rgba(0, 136, 255, 0.18);
      animation: lfPulse 1.25s ease-out infinite;
      pointer-events: none;
    }
    @keyframes lfPulse{
      0%   { transform: translateX(-50%) scale(1); opacity: 0.95; }
      100% { transform: translateX(-50%) scale(7.2); opacity: 0; }
    }

    /* Guard/police map marker: circular badge with a tapered location pointer. */
    .guard-police-pin {
      position: absolute;
      left: -5px;
      top: -8px;
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: #ff8a00;
      color: #fff;
      border: 3px solid #fff;
      box-shadow: 0 7px 16px rgba(0,0,0,.35);
      pointer-events: none;
      overflow: visible;
      z-index: 2;
    }

    /* White outer edge of the tapered pointer. */
    .guard-police-pin::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -21px;
      width: 0;
      height: 0;
      transform: translateX(-50%);
      border-left: 10px solid transparent;
      border-right: 10px solid transparent;
      border-top: 24px solid #fff;
      z-index: -2;
    }

    /* Orange centre of the tapered pointer. */
    .guard-police-pin::before {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -17px;
      width: 0;
      height: 0;
      transform: translateX(-50%);
      border-left: 7px solid transparent;
      border-right: 7px solid transparent;
      border-top: 20px solid #ff8a00;
      z-index: -1;
    }

    .guard-police-pin i {
      position: relative;
      z-index: 3;
      font-size: 20px;
      line-height: 1;
    }

.map-shell { position: relative; }

    .map-legend {
      position: absolute;
      left: 12px;
      bottom: 12px;
      z-index: 999;
      background: rgba(8, 30, 44, 0.88);
      color: #fff;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 12px;
      padding: 10px 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,.2);
      backdrop-filter: blur(8px);
      font-size: 12px;
    }

    .legend-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 4px 0;
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }

    .legend-dot.me {
      background: #0d6efd;
      box-shadow: 0 0 0 4px rgba(13,110,253,.22);
    }

    .legend-dot.guard {
      background: #ff8a00;
      box-shadow: 0 0 0 4px rgba(255,138,0,.20);
    }

    .current-user-marker {
      position: relative;
      width: 52px;
      height: 62px;
    }

    .current-user-pulse {
      position: absolute;
      left: 16px;
      top: 24px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: rgba(13,110,253,.28);
      animation: userPulse 1.6s ease-out infinite;
    }

    @keyframes userPulse {
      from { transform: scale(.8); opacity: 1; }
      to { transform: scale(3.4); opacity: 0; }
    }

    .current-user-pin {
      position: absolute;
      left: 11px;
      top: 6px;
      width: 30px;
      height: 30px;
      border-radius: 50% 50% 50% 0;
      transform: rotate(-45deg);
      background: #0d6efd;
      border: 3px solid #fff;
      box-shadow: 0 8px 18px rgba(0,0,0,.35);
    }

    .current-user-pin i {
      position: absolute;
      inset: 5px;
      display: grid;
      place-items: center;
      color: #fff;
      transform: rotate(45deg);
      font-size: 14px;
    }

    .marker-label {
      position: absolute;
      left: 50%;
      top: -22px;
      transform: translateX(-50%);
      white-space: nowrap;
      background: #0d4a6b;
      color: #fff;
      padding: 4px 8px;
      border-radius: 7px;
      font-size: 11px;
      font-weight: 700;
      box-shadow: 0 5px 14px rgba(0,0,0,.25);
    }

    .guard-label {
      position: absolute;
      left: 50%;
      top: -28px;
      transform: translateX(-50%);
      white-space: nowrap;
      background: #8f4e00;
      color: #fff;
      padding: 3px 7px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 700;
      box-shadow: 0 4px 12px rgba(0,0,0,.24);
    }
    /* ===== COMPACT FUTURISTIC SECURITY STAT CARDS ===== */
    .security-stat-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 10px;
      width: 100%;
      min-width: 0;
    }

    .security-stat-card {
      --stat-rgb: 38, 132, 255;
      position: relative;
      min-width: 0;
      min-height: 126px;
      margin-bottom: 0;
      overflow: hidden;
      isolation: isolate;
      border: 1px solid rgba(var(--stat-rgb), .28);
      border-radius: 13px;
      background:
        radial-gradient(circle at 12% 8%, rgba(var(--stat-rgb), .14), transparent 34%),
        linear-gradient(145deg, rgba(10, 29, 48, .97), rgba(7, 20, 35, .98));
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, .035),
        0 10px 24px rgba(0, 0, 0, .16);
      transition:
        transform .24s ease,
        border-color .24s ease,
        box-shadow .24s ease;
    }

    .security-stat-card::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -2;
      opacity: .18;
      background-image:
        linear-gradient(rgba(var(--stat-rgb), .10) 1px, transparent 1px),
        linear-gradient(90deg, rgba(var(--stat-rgb), .10) 1px, transparent 1px);
      background-size: 18px 18px;
      mask-image: linear-gradient(to bottom, #000, transparent 82%);
      pointer-events: none;
    }

    .security-stat-card::after {
      content: "";
      position: absolute;
      left: -35%;
      right: -35%;
      top: -48%;
      height: 38%;
      z-index: -1;
      background: linear-gradient(
        to bottom,
        transparent,
        rgba(var(--stat-rgb), .14),
        transparent
      );
      transform: rotate(-8deg);
      animation: securityScan 5.5s linear infinite;
      pointer-events: none;
    }

    .security-stat-card:hover {
      transform: translateY(-3px);
      border-color: rgba(var(--stat-rgb), .54);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, .05),
        0 14px 30px rgba(0, 0, 0, .22),
        0 0 22px rgba(var(--stat-rgb), .08);
    }

    @keyframes securityScan {
      0%   { top: -55%; opacity: 0; }
      12%  { opacity: .8; }
      80%  { opacity: .35; }
      100% { top: 125%; opacity: 0; }
    }

    .security-stat-card.stat-clients { --stat-rgb: 51, 140, 255; }
    .security-stat-card.stat-sites { --stat-rgb: 166, 92, 255; }
    .security-stat-card.stat-guards { --stat-rgb: 32, 219, 142; }
    .security-stat-card.stat-office { --stat-rgb: 246, 91, 171; }
    .security-stat-card.stat-checkins { --stat-rgb: 255, 173, 51; }
    .security-stat-card.stat-clockins { --stat-rgb: 0, 210, 229; }

    .security-stat-card .card-body {
      position: relative;
      z-index: 2;
      min-height: 126px;
      padding: 12px 12px 10px;
      display: flex;
      flex-direction: column;
    }

    .security-stat-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
    }

    .security-stat-icon-wrap {
      position: relative;
      width: 38px;
      height: 38px;
      flex: 0 0 38px;
      display: grid;
      place-items: center;
    }

    .security-stat-icon-wrap::before,
    .security-stat-icon-wrap::after {
      content: "";
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(var(--stat-rgb), .42);
      animation: statRadarPulse 2.6s ease-out infinite;
    }

    .security-stat-icon-wrap::before {
      inset: 4px;
    }

    .security-stat-icon-wrap::after {
      inset: -1px;
      animation-delay: 1.3s;
    }

    @keyframes statRadarPulse {
      0% { transform: scale(.72); opacity: .9; }
      100% { transform: scale(1.42); opacity: 0; }
    }

    .security-stat-icon {
      position: relative;
      z-index: 2;
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(var(--stat-rgb), .40);
      border-radius: 10px;
      color: rgb(var(--stat-rgb));
      background:
        linear-gradient(145deg, rgba(var(--stat-rgb), .22), rgba(var(--stat-rgb), .06));
      box-shadow:
        inset 0 0 13px rgba(var(--stat-rgb), .10),
        0 0 14px rgba(var(--stat-rgb), .07);
      font-size: 17px;
    }

    .security-stat-live {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      margin-top: 2px;
      color: rgba(222, 235, 247, .66);
      font-size: 7px;
      font-weight: 700;
      letter-spacing: .10em;
      text-transform: uppercase;
    }

    .security-stat-live-dot {
      position: relative;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: rgb(var(--stat-rgb));
      box-shadow: 0 0 8px rgba(var(--stat-rgb), .85);
    }

    .security-stat-live-dot::after {
      content: "";
      position: absolute;
      inset: -3px;
      border: 1px solid rgba(var(--stat-rgb), .55);
      border-radius: 50%;
      animation: liveDotPulse 1.8s ease-out infinite;
    }

    @keyframes liveDotPulse {
      from { transform: scale(.65); opacity: 1; }
      to { transform: scale(1.8); opacity: 0; }
    }

    .security-stat-label {
      margin: 0 0 3px;
      max-width: 82px;
      color: rgba(205, 220, 235, .72);
      font-size: 9px;
      line-height: 1.18;
      font-weight: 600;
      letter-spacing: .015em;
      text-align: right;
    }

    .security-stat-value {
      margin: 0;
      color: #f7fbff;
      font-size: clamp(22px, 1.8vw, 29px);
      line-height: 1;
      font-weight: 750;
      letter-spacing: -.04em;
      text-shadow: 0 0 15px rgba(var(--stat-rgb), .18);
      text-align: right;
    }

    .security-stat-footer {
      margin-top: auto;
      padding-top: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      border-top: 1px solid rgba(var(--stat-rgb), .14);
    }

    .security-stat-caption {
      overflow: hidden;
      color: #eef7ff;
      font-size: 9px;
      font-weight: 650;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .security-stat-code {
      color: rgba(var(--stat-rgb), .84);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 7px;
      font-weight: 700;
      letter-spacing: .06em;
      white-space: nowrap;
    }

    .security-stat-corner {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 30px;
      height: 30px;
      border-right: 2px solid rgba(var(--stat-rgb), .40);
      border-bottom: 2px solid rgba(var(--stat-rgb), .40);
      border-bottom-right-radius: 12px;
      opacity: .5;
      pointer-events: none;
    }

    /*
     * Keep all six cards on one horizontal line on tablets and phones.
     * Users can swipe sideways without affecting the rest of the dashboard.
     */
    @media (max-width: 991.98px) {
      .security-stat-grid {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 2px 2px 10px;
        scroll-snap-type: x proximity;
        overscroll-behavior-inline: contain;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
      }

      .security-stat-grid .security-stat-card {
        flex: 0 0 150px;
        width: 150px;
        scroll-snap-align: start;
      }
    }

    @media (max-width: 575.98px) {
      .security-stat-grid .security-stat-card {
        flex-basis: 142px;
        width: 142px;
      }

      .security-stat-card .card-body {
        padding: 11px 10px 9px;
      }
    }

    /* ===== SAFE MAP STACKING FIX ===== */
    /*
     * Keep Leaflet inside its own stacking context. This prevents the map
     * from covering the mobile header or menu without overriding the
     * positioning supplied by the website theme.
     */
    .map-shell {
      position: relative;
      z-index: 0;
      isolation: isolate;
      overflow: hidden;
      width: 100%;
      max-width: 100%;
      border-radius: 14px;
    }

    #liveMap,
    .leaflet-container {
      position: relative;
      z-index: 0 !important;
      width: 100%;
      max-width: 100%;
    }

    .map-shell .leaflet-top,
    .map-shell .leaflet-bottom {
      z-index: 10 !important;
    }

    /*
     * Set only z-index for theme elements. Their original fixed/sticky
     * positioning must remain untouched.
     */
    .app-header,
    .main-header {
      z-index: 1050 !important;
    }

    .app-sidebar,
    .main-sidebar,
    .offcanvas {
      z-index: 1100 !important;
    }

    .offcanvas-backdrop,
    #responsive-overlay {
      z-index: 1090 !important;
    }

    .modal-backdrop {
      z-index: 1190 !important;
    }

    .modal {
      z-index: 1200 !important;
    }

    @media (max-width: 991.98px) {
      /*
       * Remove any desktop sidebar spacing that remains on small screens.
       * This fixes the blank strip beside the dashboard.
       */
      .main-content.app-content {
        width: 100% !important;
        max-width: 100% !important;
        margin-inline-start: 0 !important;
        margin-inline-end: 0 !important;
        overflow-x: hidden;
      }

      .main-content.app-content > .container-fluid {
        width: 100%;
        max-width: 100%;
        padding-inline: 10px !important;
        margin-inline: 0 !important;
      }

      /*
       * The theme already reserves space for its mobile header. Remove
       * only the additional page-header margin that produced the top gap.
       */
      .page-header-breadcrumb {
        margin-top: 0 !important;
        padding-top: 6px;
      }

      #liveMap {
        height: 320px;
      }

      .leaflet-control-layers,
      .leaflet-control-zoom {
        z-index: 10 !important;
      }
    }

    @media (max-width: 575.98px) {
      .main-content.app-content > .container-fluid {
        padding-inline: 8px !important;
      }

      .page-header-breadcrumb {
        padding-top: 4px;
      }

      #liveMap {
        height: 285px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .security-stat-card::after,
      .security-stat-icon-wrap::before,
      .security-stat-icon-wrap::after,
      .security-stat-live-dot::after {
        animation: none !important;
      }

      .security-stat-card {
        transition: none;
      }
    }

  
    /* ===== REPORTS SEMI-DONUT ===== */
    .reports-chart-card .card-body {
      min-height: 198px;
      overflow: visible;
    }

    #orders-summary {
      width: 100%;
      min-height: 198px;
      margin-top: 0;
      margin-bottom: -34px;
      overflow: visible;
    }

    #orders-summary .apexcharts-canvas,
    #orders-summary .apexcharts-svg {
      overflow: visible !important;
    }

    .reports-chart-card .card-footer {
      padding-top: 8px;
    }

    .reports-chart-card .apexcharts-canvas {
      margin-inline: auto;
    }

    .reports-chart-card .apexcharts-pie-series path {
      transition:
        transform .28s ease,
        filter .28s ease,
        opacity .28s ease;
      transform-origin: center;
      cursor: pointer;
    }

    .reports-chart-card .apexcharts-pie-series path:hover {
      filter:
        drop-shadow(0 0 8px rgba(255,255,255,.22))
        drop-shadow(0 0 14px rgba(13,110,253,.22));
      opacity: 1;
    }

    @media (max-width: 575.98px) {
      .reports-chart-card .card-body {
        min-height: 178px;
      }

      #orders-summary {
        min-height: 178px;
        margin-top: 0;
        margin-bottom: -28px;
      }
    }

  </style>

        <!-- Start::app-content -->
