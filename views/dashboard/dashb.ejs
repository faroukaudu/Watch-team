                 <script>
    const companyId = <%- JSON.stringify(String(userInfo.assignedCompanyID || "")) %>;
    const currentUserName = <%- JSON.stringify(userInfo.fullname || userInfo.username || "Current User") %>;
    const rawUserType = <%- JSON.stringify(userInfo.userType || "User") %>;

    function displayUserType(value) {
      const normalized = String(value || "")
        .trim()
        .toLowerCase()
        .replace(/[_-]+/g, " ");

      if (normalized === "super admin") return "Super Admin";
      if (normalized === "platform admin") return "Platform Admin";
      if (normalized === "client" || normalized === "clients") return "Client";
      return value || "User";
    }

    function escapeHtml(value) {
      return String(value ?? "").replace(/[&<>'"]/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        "'": "&#39;",
        '"': "&quot;"
      })[char]);
    }

    const currentUserType = displayUserType(rawUserType);
    const statusText = document.getElementById("statusText");
    const setStatus = (text) => {
      if (statusText) statusText.textContent = text;
    };

    const map = L.map("liveMap", {
      zoomControl: true
    }).setView([9.0765, 7.3986], 14);

    const satellite = L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      {
        maxZoom: 19,
        attribution: "Tiles © Esri"
      }
    ).addTo(map);

    const dark = L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
      {
        maxZoom: 20,
        attribution: "&copy; OpenStreetMap &copy; CARTO"
      }
    );

    L.control.layers({
      Satellite: satellite,
      Dark: dark
    }).addTo(map);

    setTimeout(() => map.invalidateSize(), 250);

    const guardMarkers = new Map();

    let currentUserMarker = null;
    let currentAccuracyCircle = null;
    let currentUserWatchId = null;
    let hasCenteredOnUser = false;
    let lastAcceptedUserLocation = null;

    const CURRENT_USER_ICON = L.divIcon({
      className: "",
      html: `
        <div class="current-user-marker">
          <span class="marker-label">${escapeHtml(currentUserType)}</span>
          <span class="current-user-pulse"></span>
          <span class="current-user-pin">
            <i class="ri-user-location-fill"></i>
          </span>
        </div>
      `,
      iconSize: [52, 62],
      iconAnchor: [26, 56],
      popupAnchor: [0, -54]
    });

    function guardIcon(label) {
      const safeLabel = escapeHtml(label || "Guard");

      return L.divIcon({
        className: "",
        html: `
          <div class="lf-wrap">
            <span class="guard-label">${safeLabel}</span>
            <div
              class="lf-pulse"
              style="
                background: rgba(255,138,0,.34);
                box-shadow: 0 0 0 8px rgba(255,138,0,.18);
              "
            ></div>
            <!-- CHANGE THE POLICE/GUARD ICON CLASS ON THE NEXT LINE. -->
            <span class="guard-police-pin" aria-hidden="true">
              <i class="ri-shield-user-fill"></i>
            </span>
          </div>
        `,
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [0, -36]
      });
    }

    function updateDashboardStatus() {
      const count = guardMarkers.size;
      const guardText = `${count} checked-in guard${count === 1 ? "" : "s"}`;

      if (currentUserMarker) {
        setStatus(`showing your location and ${guardText}`);
      } else {
        setStatus(`showing ${guardText}`);
      }
    }

    function updateCurrentUserLocation(position) {
      const latitude = Number(position.coords.latitude);
      const longitude = Number(position.coords.longitude);
      const accuracy = Number(position.coords.accuracy || 0);

      if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
        return;
      }

      const latlng = L.latLng(latitude, longitude);

      /*
       * Laptop location values often change slightly while stationary.
       * Ignore movements below two metres so the pointer stays stable.
       */
      if (lastAcceptedUserLocation) {
        const movedMetres = lastAcceptedUserLocation.distanceTo(latlng);

        if (movedMetres < 2) {
          if (currentAccuracyCircle) {
            currentAccuracyCircle.setRadius(Math.max(accuracy, 8));
          }
          return;
        }
      }

      lastAcceptedUserLocation = latlng;

      /*
       * Create this marker once. Later readings only move the existing
       * marker, so it never disappears and gets recreated.
       */
      if (!currentUserMarker) {
        currentUserMarker = L.marker(latlng, {
          icon: CURRENT_USER_ICON,
          zIndexOffset: 2000,
          title: `${currentUserName} - ${currentUserType}`,
          keyboard: true,
          riseOnHover: true
        }).addTo(map);

        currentUserMarker.bindPopup(`
          <div style="min-width:180px">
            <strong>${escapeHtml(currentUserName)}</strong><br>
            <span>${escapeHtml(currentUserType)}</span><br>
            <small>Your current browser location</small>
          </div>
        `);
      } else {
        currentUserMarker.setLatLng(latlng);
      }

      if (!currentAccuracyCircle) {
        currentAccuracyCircle = L.circle(latlng, {
          radius: Math.max(accuracy, 8),
          weight: 1,
          opacity: .7,
          fillOpacity: .08,
          interactive: false
        }).addTo(map);
      } else {
        currentAccuracyCircle.setLatLng(latlng);
        currentAccuracyCircle.setRadius(Math.max(accuracy, 8));
      }

      /*
       * Immediately move the dashboard map to the user's position after
       * permission is accepted. Do this only once so later updates do not
       * interrupt the user while viewing guards.
       */
      if (!hasCenteredOnUser) {
        map.flyTo(latlng, 17, {
          animate: true,
          duration: 1.1
        });

        hasCenteredOnUser = true;
      }

      updateDashboardStatus();
    }

    function handleLocationError(error) {
      const messages = {
        1: "Location permission denied. Allow location access in your browser.",
        2: "Your current location is unavailable.",
        3: "Location request timed out."
      };

      const message =
        messages[error.code] || "Could not load your current location.";

      /*
       * Keep the last known pointer visible when a temporary update fails.
       */
      if (currentUserMarker) {
        setStatus(`${message} Showing your last known location.`);
        return;
      }

      setStatus(message);
    }

    function beginContinuousLocationUpdates() {
      if (currentUserWatchId !== null) {
        return;
      }

      currentUserWatchId = navigator.geolocation.watchPosition(
        updateCurrentUserLocation,
        handleLocationError,
        {
          enableHighAccuracy: true,
          timeout: 20000,
          maximumAge: 5000
        }
      );
    }

    function startCurrentUserTracking() {
      if (!navigator.geolocation) {
        setStatus("This browser does not support location services.");
        return;
      }

      setStatus("requesting your current location...");

      /*
       * Request one fresh location first. This triggers the browser
       * permission prompt. As soon as permission is accepted, the map
       * loads and centers on the user's current location.
       */
      navigator.geolocation.getCurrentPosition(
        (position) => {
          updateCurrentUserLocation(position);
          beginContinuousLocationUpdates();
        },
        (error) => {
          handleLocationError(error);

          if (error.code !== 1) {
            beginContinuousLocationUpdates();
          }
        },
        {
          enableHighAccuracy: true,
          timeout: 20000,
          maximumAge: 0
        }
      );
    }

    function getGuardId(payload) {
      return String(
        payload.guardId ||
        payload.guardID ||
        payload.userId ||
        payload._id ||
        ""
      );
    }

    function saveLastGuardLocation(guardId, payload) {
      try {
        localStorage.setItem(
          `lastLoc:${guardId}`,
          JSON.stringify(payload)
        );
      } catch (_) {}
    }

    function loadLastGuardLocation(guardId) {
      try {
        const stored = localStorage.getItem(`lastLoc:${guardId}`);
        return stored ? JSON.parse(stored) : null;
      } catch (_) {
        return null;
      }
    }

    function upsertGuardMarker(payload, { pan = false } = {}) {
      const guardId = getGuardId(payload);
      const latitude = Number(payload.lat ?? payload.latitude);
      const longitude = Number(
        payload.lng ?? payload.long ?? payload.longitude
      );

      if (
        !guardId ||
        !Number.isFinite(latitude) ||
        !Number.isFinite(longitude)
      ) {
        return;
      }

      const guardName =
        payload.guardName ||
        payload.fullname ||
        payload.name ||
        `Guard ${guardId.slice(-4)}`;

      const latlng = [latitude, longitude];

      if (!guardMarkers.has(guardId)) {
        const marker = L.marker(latlng, {
          icon: guardIcon(guardName),
          zIndexOffset: 1000,
          title: guardName,
          keyboard: true,
          riseOnHover: true
        }).addTo(map);

        marker.bindPopup(`
          <strong>${escapeHtml(guardName)}</strong><br>
          <span>Checked-in Guard</span>
        `);

        guardMarkers.set(guardId, marker);
      } else {
        const marker = guardMarkers.get(guardId);

        marker.setLatLng(latlng);
        marker.setIcon(guardIcon(guardName));
        marker.setPopupContent(`
          <strong>${escapeHtml(guardName)}</strong><br>
          <span>Checked-in Guard</span>
        `);
      }

      saveLastGuardLocation(guardId, payload);

      if (pan && !hasCenteredOnUser) {
        map.flyTo(latlng, 17, {
          animate: true,
          duration: 1.1
        });
      }

      updateDashboardStatus();
    }

    function removeGuardMarker(guardId) {
      const id = String(guardId || "");
      const marker = guardMarkers.get(id);

      if (marker) {
        map.removeLayer(marker);
        guardMarkers.delete(id);
      }

      updateDashboardStatus();
    }

    /*
     * Restore all currently checked-in guard markers from MongoDB whenever
     * the dashboard is opened or refreshed. Socket.IO then continues with
     * real-time movement and checkout updates.
     */
    async function loadDashboardGuardLocations() {
      try {
        const response = await fetch("/api/tracking/current", {
          headers: { Accept: "application/json" },
          cache: "no-store"
        });

        const data = await response.json();
        if (!response.ok || !data.ok) return;

        const rows = Array.isArray(data.rows) ? data.rows : [];
        const onlineGuardIds = new Set();

        rows.forEach((row) => {
          if (row.source !== "guard" || row.status !== "online") return;

          const guardId = getGuardId(row);
          const latitude = Number(row.latitude ?? row.lat);
          const longitude = Number(row.longitude ?? row.lng ?? row.long);

          if (
            !guardId ||
            !Number.isFinite(latitude) ||
            !Number.isFinite(longitude)
          ) {
            return;
          }

          onlineGuardIds.add(guardId);

          upsertGuardMarker({
            ...row,
            guardId,
            guardName:
              row.userName ||
              row.guardName ||
              row.fullname ||
              row.name ||
              "Guard",
            lat: latitude,
            lng: longitude
          });
        });

        for (const guardId of Array.from(guardMarkers.keys())) {
          if (!onlineGuardIds.has(String(guardId))) {
            removeGuardMarker(guardId);
          }
        }

        updateDashboardStatus();
      } catch (error) {
        console.error("Dashboard guard location restore failed:", error);
      }
    }

    const socket = io();

    socket.on("connect", () => {
      socket.emit("join", { companyId });
      setStatus("connected - loading locations...");
      loadDashboardGuardLocations();
    });

    socket.on("guard:location", (payload) => {
      upsertGuardMarker(payload);
    });

    socket.on("guard:online", ({ guardId, guardName }) => {
      const id = String(guardId || "");
      const cached = id ? loadLastGuardLocation(id) : null;

      if (cached) {
        upsertGuardMarker(
          {
            ...cached,
            guardId: id,
            guardName: guardName || cached.guardName
          },
          { pan: false }
        );
      } else {
        setStatus(
          `${guardName || "A guard"} checked in - waiting for GPS...`
        );
      }
    });

    socket.on("guard:offline", ({ guardId }) => {
      removeGuardMarker(guardId);
    });

    socket.on("disconnect", () => {
      setStatus("live connection interrupted - reconnecting...");
    });

    window.addEventListener("beforeunload", () => {
      if (currentUserWatchId !== null && navigator.geolocation) {
        navigator.geolocation.clearWatch(currentUserWatchId);
      }
    });

    startCurrentUserTracking();
    loadDashboardGuardLocations();
  </script>


