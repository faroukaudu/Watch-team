                </div>
                <!-- End::page-header -->

                <!-- Start:: row-1 -->
                <div class="row">
                    <div class="col-xxl-9">
                        <%
                            let dashboardCheckInCount = 0;
                            let dashboardClockInCount = 0;

                            if (companyInfo && Array.isArray(companyInfo.activity)) {
                                companyInfo.activity.forEach(function(activity) {
                                    if (activity.type === "Check In") dashboardCheckInCount++;
                                    if (activity.type === "Clock In") dashboardClockInCount++;
                                });
                            }
                        %>

                        <div class="security-stat-grid">
                            <!-- Clients -->
                            <div class="card custom-card security-stat-card stat-clients">
                                <div class="card-body">
                                    <div class="security-stat-top">
                                        <div>
                                            <div class="security-stat-icon-wrap">
                                                <div class="security-stat-icon">
                                                    <i class="ri-team-line"></i>
                                                </div>
                                            </div>
                                            <span class="security-stat-live">
                                                <span class="security-stat-live-dot"></span>
                                                Live
                                            </span>
                                        </div>

                                        <div>
                                            <p class="security-stat-label">Clients</p>
                                            <h3 class="security-stat-value"><%= activeClient %></h3>
                                        </div>
                                    </div>

                                    <div class="security-stat-footer">
                                        <span class="security-stat-caption">Active Clients</span>
                                        <span class="security-stat-code">CL-01</span>
                                    </div>
                                    <span class="security-stat-corner"></span>
                                </div>
                            </div>

                            <!-- Post Sites -->
                            <div class="card custom-card security-stat-card stat-sites">
                                <div class="card-body">
                                    <div class="security-stat-top">
                                        <div>
                                            <div class="security-stat-icon-wrap">
                                                <div class="security-stat-icon">
                                                    <i class="ri-building-4-line"></i>
                                                </div>
                                            </div>
                                            <span class="security-stat-live">
                                                <span class="security-stat-live-dot"></span>
                                                Online
                                            </span>
                                        </div>

                                        <div>
                                            <p class="security-stat-label">Post Sites</p>
                                            <h3 class="security-stat-value"><%= compPostSite %></h3>
                                        </div>
                                    </div>

                                    <div class="security-stat-footer">
                                        <span class="security-stat-caption">Active Post Sites</span>
                                        <span class="security-stat-code">PS-02</span>
                                    </div>
                                    <span class="security-stat-corner"></span>
                                </div>
                            </div>

                            <!-- Security Guards -->
                            <div class="card custom-card security-stat-card stat-guards">
                                <div class="card-body">
                                    <div class="security-stat-top">
                                        <div>
                                            <div class="security-stat-icon-wrap">
                                                <div class="security-stat-icon">
                                                    <i class="ri-shield-user-line"></i>
                                                </div>
                                            </div>
                                            <span class="security-stat-live">
                                                <span class="security-stat-live-dot"></span>
                                                Secured
                                            </span>
                                        </div>

                                        <div>
                                            <p class="security-stat-label">Security Guards</p>
                                            <h3 class="security-stat-value"><%= guardCount %></h3>
                                        </div>
                                    </div>

                                    <div class="security-stat-footer">
                                        <span class="security-stat-caption">Active Guards</span>
                                        <span class="security-stat-code">SG-03</span>
