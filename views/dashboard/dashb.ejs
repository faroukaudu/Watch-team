    <!-- Apex Charts JS -->
    <script src="assets/libs/apexcharts/apexcharts.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const reportStats = <%- JSON.stringify(reportStats) %>;
            const chartElement = document.querySelector("#orders-summary");

            if (!chartElement || typeof ApexCharts === "undefined") {
                return;
            }

            const reportSeries = [
                Number(reportStats.incident?.count || 0),
                Number(reportStats.general?.count || 0),
                Number(reportStats.codeRed?.count || 0),
                Number(reportStats.others?.count || 0)
            ];

            const chartOptions = {
                series: reportSeries,
                labels: ["Incidents", "General", "Code Red", "Others"],

                chart: {
                    type: "donut",
                    height: 250,
                    sparkline: {
                        enabled: true
                    },
                    animations: {
                        enabled: true,
                        easing: "easeinout",
                        speed: 900,
                        animateGradually: {
                            enabled: true,
                            delay: 110
                        },
                        dynamicAnimation: {
                            enabled: true,
                            speed: 450
                        }
                    },
                    events: {
                        dataPointMouseEnter: function (event, chartContext, config) {
                            const paths = chartElement.querySelectorAll(
                                ".apexcharts-pie-series path"
                            );

                            paths.forEach((path, index) => {
                                if (index === config.dataPointIndex) {
                                    path.style.transform = "scale(1.055)";
                                    path.style.filter =
                                        "drop-shadow(0 0 10px rgba(255,255,255,.30)) " +
                                        "drop-shadow(0 0 18px rgba(13,110,253,.28))";
                                    path.style.opacity = "1";
                                } else {
                                    path.style.opacity = ".55";
                                }
                            });
                        },

                        dataPointMouseLeave: function () {
                            const paths = chartElement.querySelectorAll(
                                ".apexcharts-pie-series path"
                            );

                            paths.forEach((path) => {
                                path.style.transform = "scale(1)";
                                path.style.filter = "";
                                path.style.opacity = "1";
                            });
                        }
                    }
                },

                colors: [
                    "#20c997",
                    "#8b5e3c",
                    "#ff2d2d",
                    "#0d6efd"
                ],

                stroke: {
                    width: 4,
                    colors: ["var(--custom-white)"],
                    lineCap: "round"
                },

                dataLabels: {
                    enabled: false
                },

                legend: {
                    show: false
                },

                tooltip: {
                    enabled: true,
                    followCursor: true,
                    custom: function ({ series, seriesIndex, w }) {
                        const count = Number(series[seriesIndex] || 0);
                        const total = reportSeries.reduce(
                            (sum, current) => sum + Number(current || 0),
                            0
                        );
                        const percentage = total
                            ? ((count / total) * 100).toFixed(1)
                            : "0.0";
                        const label = w.globals.labels[seriesIndex];

                        return `
                            <div style="
                                min-width:145px;
                                padding:10px 12px;
                                border-radius:10px;
                                background:rgba(7,20,35,.96);
                                color:#fff;
                                box-shadow:0 12px 30px rgba(0,0,0,.35);
                                border:1px solid rgba(255,255,255,.10);
                            ">
                                <div style="
                                    font-size:11px;
                                    opacity:.72;
                                    margin-bottom:3px;
                                ">
                                    ${label}
                                </div>
                                <div style="
                                    font-size:22px;
                                    line-height:1;
                                    font-weight:750;
                                ">
                                    ${count.toLocaleString()}
                                </div>
                                <div style="
                                    margin-top:4px;
                                    font-size:11px;
                                    opacity:.72;
                                ">
                                    ${percentage}% of all reports
                                </div>
                            </div>
                        `;
                    }
                },

                states: {
                    normal: {
                        filter: {
                            type: "none"
                        }
                    },
                    hover: {
                        filter: {
                            type: "lighten",
                            value: 0.08
                        }
                    },
                    active: {
                        filter: {
                            type: "darken",
                            value: 0.08
                        }
                    }
                },

                plotOptions: {
                    pie: {
                        startAngle: -90,
                        endAngle: 90,
                        offsetY: 18,
                        expandOnClick: false,
                        customScale: 0.94,
                        donut: {
                            size: "66%",
                            labels: {
                                show: false
                            }
                        }
                    }
                },

                grid: {
                    padding: {
                        top: 20,
                        right: 10,
                        bottom: -34,
                        left: 10
                    }
                },

                noData: {
                    text: "No reports available"
                },

                responsive: [
                    {
                        breakpoint: 575,
                        options: {
                            chart: {
                                height: 225
                            },
                            plotOptions: {
                                pie: {
                                    customScale: 0.9,
                                    offsetY: 16
                                }
                            },
                            grid: {
                                padding: {
                                    top: 18,
                                    right: 8,
                                    bottom: -30,
                                    left: 8
                                }
                            }
                        }
                    }
                ]
            };

            new ApexCharts(chartElement, chartOptions).render();
        });
    </script>


