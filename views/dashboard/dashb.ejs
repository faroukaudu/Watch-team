            <div class="container-fluid">

                <!-- Start::page-header -->
                <div class="d-flex align-items-center justify-content-between my-3 page-header-breadcrumb flex-wrap gap-2">
                    <div>
                        <p class="fw-medium fs-18 mb-0">Hello <%= userInfo.fullname%></p>
                        <p class="fs-13 text-muted mb-0">Let's make <span class="badge bg-success-transparent"><strong style="font-size: larger; color: rgb(12, 216, 83); text-transform: uppercase;"><%= userInfo.compName%></strong></span>  Safe!</p>
                    </div>
