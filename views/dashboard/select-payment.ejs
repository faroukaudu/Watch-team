<%- include("../includes/header", { user: userInfo }); -%>

<div class="main-content app-content">
  <div class="container-fluid">
    <div class="my-4">
      <h1 class="page-title fw-medium fs-18 mb-2">Choose Payment Gateway</h1>
      <p class="text-muted mb-4">
        Plan: <strong><%= selectedPlan.planName %></strong> -
        <strong><%= selectedPlan.billingCycle %></strong> -
        <strong>$<%= selectedPlan.amount %></strong>
      </p>

      <div class="row justify-content-center">
        <div class="col-md-5">
          <div class="card custom-card">
            <div class="card-body text-center p-4">
              <h4 class="mb-2">Stripe</h4>
              <p class="text-muted">Use Stripe hosted subscription checkout.</p>

              <form action="/billing/stripe/checkout" method="POST">
                <input type="hidden" name="planCode" value="<%= planCode %>">
                <button type="submit" class="btn btn-primary w-100">
                  Continue with Stripe
                </button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-md-5">
          <div class="card custom-card">
            <div class="card-body text-center p-4">
              <h4 class="mb-2">PayPal</h4>
              <p class="text-muted">Use PayPal hosted subscription approval.</p>

              <a href="/billing/paypal/checkout?planCode=<%= encodeURIComponent(planCode) %>" class="btn btn-warning w-100">
                Continue with PayPal
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../includes/footer"); -%>