<%- include("../includes/header", {user:userInfo}); -%>

<style>
  .scheduler-hero {
    margin-bottom: 22px;
    padding: 24px;
    color: #ffffff;
    background: linear-gradient(135deg, #111827, #123458);
    border-radius: 18px;
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.15);
  }

  .shift-card {
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 18px;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
  }

  .shift-table th {
    color: #64748b;
    font-size: 12px;
    text-transform: uppercase;
    background: #f8fafc;
  }

  .day-pill {
    display: inline-block;
    margin: 2px;
    padding: 4px 8px;
    color: #2563eb;
    font-size: 11px;
    font-weight: 700;
    background: #eff6ff;
    border-radius: 999px;
  }

  .break-text {
    display: block;
    margin-bottom: 3px;
    color: #334155;
    font-size: 12px;
    font-weight: 600;
  }

  .action-buttons {
    display: flex;
    gap: 6px;
    white-space: nowrap;
  }

  .guard-picker {
    position: relative;
  }

  .guard-picker-toggle {
    width: 100%;
    min-height: 42px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.75rem;
    color: #212529 !important;
    text-align: left;
    background: #ffffff !important;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    cursor: pointer;
  }

  .guard-picker-toggle .picker-label,
  .guard-picker-toggle i {
    color: #212529 !important;
  }

  .guard-picker-toggle:hover {
    border-color: #0d6efd;
  }

  .guard-picker-toggle:focus {
    outline: 0;
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
  }

  .guard-picker-menu {
    display: none;
    position: absolute;
    z-index: 1080;
    top: calc(100% + 6px);
    right: 0;
    left: 0;
    max-height: 280px;
    overflow-y: auto;
    padding: 10px;
    color: #212529 !important;
    background: #ffffff !important;
    border: 1px solid #dbe2ea;
    border-radius: 12px;
    box-shadow: 0 16px 35px rgba(15, 23, 42, 0.16);
  }

  .guard-picker.open .guard-picker-menu {
    display: block;
  }

  .guard-option {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 2px;
    padding: 10px 12px;
    color: #212529 !important;
    background: #ffffff !important;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .guard-option:hover {
    background: #edf4ff !important;
  }

  .guard-option span,
  .guard-option strong {
    color: #212529 !important;
  }

  .guard-option small {
    color: #6c757d !important;
  }

  .guard-option input[type="checkbox"] {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    accent-color: #0d6efd;
  }

  .selected-guards {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    min-height: 30px;
    margin-top: 10px;
  }

  .guard-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 9px;
    color: #0d6efd;
    font-size: 12px;
    font-weight: 600;
    background: #eaf2ff;
    border: 1px solid #cfe2ff;
    border-radius: 999px;
  }

  .guard-chip button {
    padding: 0;
    color: #0d6efd;
    font-size: 16px;
    line-height: 1;
    background: transparent;
    border: 0;
  }

  .guard-chip button:hover {
    color: #dc3545;
  }

  .guard-empty {
    padding: 4px 0;
    color: #94a3b8;
    font-size: 12px;
  }

  .picker-status {
    padding: 10px;
    color: #64748b !important;
    font-size: 13px;
    background: #ffffff !important;
  }

  .modal-content {
    border-radius: 16px;
  }

  .delete-inline {
    display: inline;
  }
</style>

<div class="main-content app-content">\n  <div class="container-fluid">
  <div class="scheduler-hero">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div><h2 class="fw-bold text-white-10 mb-1" >Shift Template</h2><p class="text-white-50 mb-0">Create reusable guard shifts by post site, time, repeat days, and duration.</p>
        </div>
        <button class="btn btn-light fw-semibold" data-bs-toggle="modal" data-bs-target="#newShiftModal"><i class="ri-add-line me-1"></i> New Shift</button></div></div>

  <div class="card custom-card shift-card"><div class="card-header d-flex justify-content-between align-items-center"><div><h5 class="card-title mb-1">Shift Templates</h5><small class="text-muted">All active and recurring shift templates</small></div></div>
    <div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0 shift-table">
      <thead><tr><th>Template Name</th><th>Start Time</th><th>End Time</th><th>Post Site</th><th>Guard Name</th><th>Repeat</th><th>Breaks</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
      <% if (shiftTemplates && shiftTemplates.length > 0) { %>
        <% shiftTemplates.forEach(function(item, index){ %>
        <tr>
          <td><div class="fw-bold"><%= item.shiftTitle || "Untitled Shift" %></div><small class="text-muted"><%= item.note || "No note" %></small></td>
          <td><%= item.startTime || "N/A" %></td><td><%= item.endTime || "N/A" %></td>
          <td><div class="fw-semibold"><%= item.postSiteName || "N/A" %></div></td>
          <td><% if(item.guards&&item.guards.length){ item.guards.forEach(function(g){ %><div class="fw-semibold"><%= g.guardName || "Guard" %></div><% }) } else { %><span class="text-muted">No guard assigned</span><% } %></td>
          <td><% if(item.repeatDays&&item.repeatDays.length){ item.repeatDays.forEach(function(day){ %><span class="day-pill"><%= day %></span><% }) } %><div class="text-muted fs-12 mt-1"><%= item.repeatFor || "" %></div></td>
          <td><% if(item.breaks&&item.breaks.length){ item.breaks.forEach(function(b){ %><span class="break-text"><%= b %></span><% }) } else { %><span class="text-muted">None</span><% } %></td>
          <td><span class="badge <%= item.status === 'Active' ? 'bg-success' : 'bg-secondary' %>"><%= item.status || 'Active' %></span></td>
          <td><div class="action-buttons"><button type="button" class="btn btn-sm btn-primary edit-shift-btn" data-template-index="<%= index %>"><i class="ri-edit-line"></i> Edit</button><form class="delete-inline delete-shift-form" action="/delete-shift-template/<%= item._id %>" method="POST"><button type="submit" class="btn btn-sm btn-danger"><i class="ri-delete-bin-line"></i> Delete</button></form></div></td>
        </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="9" class="text-center py-5"><i class="ri-calendar-schedule-line" style="font-size:46px;color:#94a3b8"></i><h6 class="mt-2 mb-1">No Shift Template Found</h6><p class="text-muted mb-3">Create your first shift template.</p><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newShiftModal"><i class="ri-add-line me-1"></i> New Shift</button></td></tr>
      <% } %>
      </tbody>
    </table></div></div>
  </div>
</div></div>

<% function repeatOptions(){ return ["1 Week","2 Weeks","3 Weeks","4 Weeks","5 Weeks","6 Weeks","2 Months","3 Months","4 Months","5 Months","6 Months"]; } %>

<!-- NEW SHIFT MODAL -->
<div class="modal fade" id="newShiftModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form action="/create-shift-template" method="POST" id="newShiftForm">
  <div class="modal-header"><h5 class="modal-title"><i class="ri-calendar-schedule-line me-1 text-primary"></i> New Shift Template</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body"><div class="row gy-3">
    <div class="col-12"><label class="form-label">Shift Title</label><input type="text" name="shiftTitle" class="form-control" placeholder="Morning Shift" required></div>
    <div class="col-md-6"><label class="form-label">Start Time</label><input type="time" name="startTime" class="form-control" required></div>
    <div class="col-md-6"><label class="form-label">End Time</label><input type="time" name="endTime" class="form-control" required></div>
    <div class="col-12"><label class="form-label">Repeat Shift</label><div class="d-flex flex-wrap gap-3 border rounded p-3"><% ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"].forEach(function(day){ %><div class="form-check"><input class="form-check-input" type="checkbox" name="repeatDays" value="<%= day %>" id="new_day_<%= day %>"><label class="form-check-label" for="new_day_<%= day %>"><%= day %></label></div><% }) %></div></div>
    <div class="col-md-6"><label class="form-label">Repeat For</label><select name="repeatFor" class="form-control" required><option value="">Select Duration</option><% repeatOptions().forEach(function(v){ %><option value="<%= v %>"><%= v %></option><% }) %></select></div>
    <div class="col-md-6"><label class="form-label">Post Site</label><select name="postSiteInfo" id="newPostSiteSelect" class="form-control" required><option value="">Select Post Site</option><% if(postSites&&postSites.length){ postSites.forEach(function(site){ %><option value="<%= site._id || site.id %>&<%= site.siteName || 'Post Site' %>"><%= site.siteName || 'Unnamed Post Site' %></option><% }) } %></select></div>
    <div class="col-12"><label class="form-label">Guards Assigned to Post Site</label><div class="guard-picker" id="newGuardPicker"><button type="button" class="guard-picker-toggle"><span class="picker-label">Select guards</span><i class="ri-arrow-down-s-line"></i></button><div class="guard-picker-menu"><div class="picker-status">Select a post site first.</div></div><div class="selected-guards"><span class="guard-empty">No guards selected</span></div><div class="guard-hidden-inputs"></div></div><small class="text-muted">Open the dropdown and tick one or more guards. Remove a selected guard using the × button.</small></div>
    <div class="col-12"><label class="form-label">Breaks</label><div class="d-flex flex-wrap gap-3 border rounded p-3"><div class="form-check"><input class="form-check-input" type="checkbox" name="breaks" value="Tea Break - 15 min" id="newTeaBreak"><label class="form-check-label" for="newTeaBreak">Tea Break - 15 min</label></div><div class="form-check"><input class="form-check-input" type="checkbox" name="breaks" value="Lunch Break - 30 min" id="newLunchBreak"><label class="form-check-label" for="newLunchBreak">Lunch Break - 30 min</label></div></div></div>
    <div class="col-12"><label class="form-label">Note</label><textarea name="note" class="form-control" rows="4" placeholder="Add shift instruction or note..."></textarea></div>
  </div></div>
  <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Shift Template</button></div>
</form></div></div></div>

<!-- EDIT SHIFT MODAL -->
<div class="modal fade" id="editShiftModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form method="POST" id="editShiftForm">
  <div class="modal-header"><h5 class="modal-title"><i class="ri-edit-line me-1 text-primary"></i> Edit Shift Template</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
  <div class="modal-body"><div class="row gy-3">
    <div class="col-12"><label class="form-label">Shift Title</label><input type="text" name="shiftTitle" id="editShiftTitle" class="form-control" required></div>
    <div class="col-md-6"><label class="form-label">Start Time</label><input type="time" name="startTime" id="editStartTime" class="form-control" required></div>
    <div class="col-md-6"><label class="form-label">End Time</label><input type="time" name="endTime" id="editEndTime" class="form-control" required></div>
    <div class="col-12"><label class="form-label">Repeat Shift</label><div class="d-flex flex-wrap gap-3 border rounded p-3"><% ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"].forEach(function(day){ %><div class="form-check"><input class="form-check-input edit-repeat-day" type="checkbox" name="repeatDays" value="<%= day %>" id="edit_day_<%= day %>"><label class="form-check-label" for="edit_day_<%= day %>"><%= day %></label></div><% }) %></div></div>
    <div class="col-md-6"><label class="form-label">Repeat For</label><select name="repeatFor" id="editRepeatFor" class="form-control" required><option value="">Select Duration</option><% repeatOptions().forEach(function(v){ %><option value="<%= v %>"><%= v %></option><% }) %></select></div>
    <div class="col-md-6"><label class="form-label">Post Site</label><select name="postSiteInfo" id="editPostSiteSelect" class="form-control" required><option value="">Select Post Site</option><% if(postSites&&postSites.length){ postSites.forEach(function(site){ %><option value="<%= site._id || site.id %>&<%= site.siteName || 'Post Site' %>"><%= site.siteName || 'Unnamed Post Site' %></option><% }) } %></select></div>
    <div class="col-12"><label class="form-label">Guards Assigned to Post Site</label><div class="guard-picker" id="editGuardPicker"><button type="button" class="guard-picker-toggle"><span class="picker-label">Select guards</span><i class="ri-arrow-down-s-line"></i></button><div class="guard-picker-menu"><div class="picker-status">Select a post site first.</div></div><div class="selected-guards"><span class="guard-empty">No guards selected</span></div><div class="guard-hidden-inputs"></div></div><small class="text-muted">Open the dropdown and tick one or more guards. Remove a selected guard using the × button.</small></div>
    <div class="col-12"><label class="form-label">Breaks</label><div class="d-flex flex-wrap gap-3 border rounded p-3"><div class="form-check"><input class="form-check-input edit-break" type="checkbox" name="breaks" value="Tea Break - 15 min" id="editTeaBreak"><label class="form-check-label" for="editTeaBreak">Tea Break - 15 min</label></div><div class="form-check"><input class="form-check-input edit-break" type="checkbox" name="breaks" value="Lunch Break - 30 min" id="editLunchBreak"><label class="form-check-label" for="editLunchBreak">Lunch Break - 30 min</label></div></div></div>
    <div class="col-md-6"><label class="form-label">Status</label><select name="status" id="editStatus" class="form-control"><option value="Active">Active</option><option value="Inactive">Inactive</option></select></div>
    <div class="col-12"><label class="form-label">Note</label><textarea name="note" id="editNote" class="form-control" rows="4"></textarea></div>
  </div></div>
  <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Update Shift Template</button></div>
</form></div></div></div>

<script>
  const shiftTemplatesData = <%- JSON.stringify(shiftTemplates || []).replace(/</g, '\\u003c') %>;

  class GuardPicker {
    constructor(rootId, postSiteSelectId) {
      this.root = document.getElementById(rootId);
      this.postSiteSelect = document.getElementById(postSiteSelectId);
      this.menu = this.root.querySelector(".guard-picker-menu");
      this.toggle = this.root.querySelector(".guard-picker-toggle");
      this.label = this.root.querySelector(".picker-label");
      this.chips = this.root.querySelector(".selected-guards");
      this.hidden = this.root.querySelector(".guard-hidden-inputs");
      this.guards = [];
      this.selected = new Map();

      this.toggle.addEventListener("click", () => {
        this.root.classList.toggle("open");
      });

      this.postSiteSelect.addEventListener("change", () => {
        this.loadGuards();
      });
    }

    async loadGuards(preselected = []) {
      const selectedValue = this.postSiteSelect.value;

      this.selected.clear();
      this.renderSelected();

      if (!selectedValue) {
        this.menu.innerHTML =
          '<div class="picker-status">Select a post site first.</div>';
        return;
      }

      this.menu.innerHTML =
        '<div class="picker-status">Loading guards...</div>';

      try {
        const postSiteId = selectedValue.split("&")[0];
        const response = await fetch(`/api/post-site-guards/${postSiteId}`);
        const data = await response.json();

        this.guards =
          data.success && Array.isArray(data.guards) ? data.guards : [];

        const presetIds = new Set(
          preselected.map((guard) =>
            String(guard.guardId || guard._id)
          )
        );

        this.guards.forEach((guard) => {
          if (presetIds.has(String(guard._id))) {
            this.selected.set(String(guard._id), guard);
          }
        });

        this.renderMenu();
        this.renderSelected();
      } catch (error) {
        console.error(error);
        this.menu.innerHTML =
          '<div class="picker-status text-danger">Failed to load guards.</div>';
      }
    }

    renderMenu() {
      if (!this.guards.length) {
        this.menu.innerHTML =
          '<div class="picker-status">No guards are assigned to this post site.</div>';
        return;
      }

      this.menu.innerHTML = "";

      this.guards.forEach((guard) => {
        const id = String(guard._id);
        const name = guard.fullname || guard.email || "Unnamed Guard";
        const row = document.createElement("label");

        row.className = "guard-option";
        row.innerHTML = `
          <input
            type="checkbox"
            ${this.selected.has(id) ? "checked" : ""}
          >
          <span>
            <strong>${this.escape(name)}</strong>
            ${
              guard.email
                ? `<small class="d-block">${this.escape(guard.email)}</small>`
                : ""
            }
          </span>
        `;

        row.querySelector("input").addEventListener("change", (event) => {
          if (event.target.checked) {
            this.selected.set(id, guard);
          } else {
            this.selected.delete(id);
          }

          this.renderSelected();
        });

        this.menu.appendChild(row);
      });
    }

    renderSelected() {
      this.chips.innerHTML = "";
      this.hidden.innerHTML = "";

      if (!this.selected.size) {
        this.chips.innerHTML =
          '<span class="guard-empty">No guards selected</span>';
        this.label.textContent = "Select guards";
        return;
      }

      this.label.textContent =
        `${this.selected.size} guard${this.selected.size === 1 ? "" : "s"} selected`;

      this.selected.forEach((guard, id) => {
        const name =
          guard.fullname ||
          guard.guardName ||
          guard.email ||
          "Guard";

        const email =
          guard.email ||
          guard.guardEmail ||
          "";

        const chip = document.createElement("span");
        chip.className = "guard-chip";
        chip.innerHTML = `
          ${this.escape(name)}
          <button
            type="button"
            aria-label="Remove ${this.escape(name)}"
          >
            &times;
          </button>
        `;

        chip.querySelector("button").addEventListener("click", () => {
          this.selected.delete(id);
          this.renderMenu();
          this.renderSelected();
        });

        this.chips.appendChild(chip);

        const input = document.createElement("input");
        input.type = "hidden";
        input.name = "guards";
        input.value = `${id}&${name}&${email}`;

        this.hidden.appendChild(input);
      });
    }

    escape(value) {
      const element = document.createElement("div");
      element.textContent = value || "";
      return element.innerHTML;
    }
  }

  const newPicker = new GuardPicker(
    "newGuardPicker",
    "newPostSiteSelect"
  );

  const editPicker = new GuardPicker(
    "editGuardPicker",
    "editPostSiteSelect"
  );

  document.addEventListener("click", (event) => {
    document
      .querySelectorAll(".guard-picker.open")
      .forEach((picker) => {
        if (!picker.contains(event.target)) {
          picker.classList.remove("open");
        }
      });
  });

  document.querySelectorAll(".edit-shift-btn").forEach((button) => {
    button.addEventListener("click", async () => {
      const item =
        shiftTemplatesData[Number(button.dataset.templateIndex)];

      if (!item) {
        return;
      }

      document.getElementById("editShiftForm").action =
        `/update-shift-template/${item._id}`;

      document.getElementById("editShiftTitle").value =
        item.shiftTitle || "";

      document.getElementById("editStartTime").value =
        item.startTime || "";

      document.getElementById("editEndTime").value =
        item.endTime || "";

      document.getElementById("editRepeatFor").value =
        item.repeatFor || "";

      document.getElementById("editNote").value =
        item.note || "";

      document.getElementById("editStatus").value =
        item.status || "Active";

      document
        .querySelectorAll(".edit-repeat-day")
        .forEach((checkbox) => {
          checkbox.checked =
            (item.repeatDays || []).includes(checkbox.value);
        });

      document
        .querySelectorAll(".edit-break")
        .forEach((checkbox) => {
          checkbox.checked =
            (item.breaks || []).includes(checkbox.value);
        });

      const postSiteSelect =
        document.getElementById("editPostSiteSelect");

      const siteOption = [...postSiteSelect.options].find(
        (option) =>
          option.value.split("&")[0] === String(item.postSiteId)
      );

      postSiteSelect.value = siteOption ? siteOption.value : "";

      await editPicker.loadGuards(item.guards || []);

      bootstrap.Modal
        .getOrCreateInstance(
          document.getElementById("editShiftModal")
        )
        .show();
    });
  });

  document
    .querySelectorAll(".delete-shift-form")
    .forEach((form) => {
      form.addEventListener("submit", (event) => {
        const confirmed = window.confirm(
          "Delete this shift template? This action cannot be undone."
        );

        if (!confirmed) {
          event.preventDefault();
        }
      });
    });

  document
    .getElementById("newShiftForm")
    .addEventListener("submit", (event) => {
      if (!newPicker.selected.size) {
        event.preventDefault();
        alert("Please select at least one guard.");
      }
    });

  document
    .getElementById("editShiftForm")
    .addEventListener("submit", (event) => {
      if (!editPicker.selected.size) {
        event.preventDefault();
        alert("Please select at least one guard.");
      }
    });
</script>

