<%- include("../includes/header"); -%>
<div class="main-content app-content"><div class="container-fluid">
  <div class="my-4 d-flex justify-content-between align-items-center">
    <div><h1 class="page-title fw-medium fs-18 mb-1"><%= company.companyName || "Company" %></h1><p class="text-muted mb-0">Company control, users, subscription and reports</p></div>
    <a href="/platform-admin" class="btn btn-light">Back</a>
  </div>

  <div class="row">
    <div class="col-xl-4"><div class="card custom-card"><div class="card-header"><div class="card-title">Company Control</div></div><div class="card-body">
      <p><strong>Company:</strong> <%= company.companyName || "-" %></p>
      <p><strong>Status:</strong> <span id="companyStatus" class="badge <%= company.isBlocked ? 'bg-danger' : 'bg-success' %>"><%= company.isBlocked ? 'Blocked' : 'Active' %></span></p>
      <div class="form-check form-switch"><input class="form-check-input admin-toggle" type="checkbox" data-url="/platform-admin/company/<%= company._id %>/toggle-block" <%= company.isBlocked ? 'checked' : '' %>><label class="form-check-label">Block company</label></div>
    </div></div></div>

    <div class="col-xl-4"><div class="card custom-card"><div class="card-header"><div class="card-title">Subscription</div></div><div class="card-body">
      <p><strong>Plan:</strong> <%= subscription ? subscription.planName : '-' %></p>
      <p><strong>Cycle:</strong> <%= subscription ? subscription.billingCycle : '-' %></p>
      <p><strong>Status:</strong> <%= subscription ? subscription.subscriptionStatus : '-' %></p>
      <% if (subscription) { %><div class="form-check form-switch"><input class="form-check-input admin-toggle" type="checkbox" data-url="/platform-admin/subscription/<%= subscription._id %>/toggle-block" <%= subscription.isBlocked ? 'checked' : '' %>><label class="form-check-label">Block subscription</label></div><% } %>
    </div></div></div>

    <div class="col-xl-4"><div class="card custom-card"><div class="card-header"><div class="card-title">Summary</div></div><div class="card-body">
      <p>Admins: <strong><%= companyAdmins.length %></strong></p><p>Clients: <strong><%= clients.length %></strong></p><p>Guards: <strong><%= guards.length %></strong></p><p>Reports: <strong><%= reports.length %></strong></p>
    </div></div></div>
  </div>

  <% function userTable(title, rows) { %>
  <div class="card custom-card"><div class="card-header"><div class="card-title"><%= title %></div></div><div class="card-body"><div class="table-responsive"><table class="table table-bordered align-middle">
    <thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Block</th></tr></thead><tbody>
    <% if (!rows.length) { %><tr><td colspan="4" class="text-center text-muted">No records</td></tr><% } %>
    <% rows.forEach(function(item){ %><tr><td><%= item.fullname || '-' %></td><td><%= item.email || item.username || '-' %></td><td><span class="badge <%= item.isBlocked ? 'bg-danger' : 'bg-success' %>"><%= item.isBlocked ? 'Blocked' : 'Active' %></span></td><td><div class="form-check form-switch"><input class="form-check-input admin-toggle" type="checkbox" data-url="/platform-admin/user/<%= item._id %>/toggle-block" <%= item.isBlocked ? 'checked' : '' %>></div></td></tr><% }) %>
    </tbody></table></div></div></div>
  <% } %>
  <% userTable('Company Administrators', companyAdmins); %>
  <% userTable('Clients', clients); %>
  <% userTable('Guards', guards); %>

  <div class="card custom-card"><div class="card-header"><div class="card-title">Reports by Date</div></div><div class="card-body"><div class="table-responsive"><table class="table table-bordered align-middle">
    <thead><tr><th>Date</th><th>Title</th><th>Category</th><th>Submitted By</th><th>Status</th></tr></thead><tbody>
    <% if (!reports.length) { %><tr><td colspan="5" class="text-center text-muted">No reports found</td></tr><% } %>
    <% reports.forEach(function(report){ %><tr><td><%= new Date(report.createdAt).toLocaleString() %></td><td><%= report.title || '-' %></td><td><%= report.category || '-' %></td><td><%= report.fullname || report.userId || '-' %></td><td><%= report.status ? 'Reviewed' : 'Open' %></td></tr><% }) %>
    </tbody></table></div></div></div>
</div></div>
<script>
document.querySelectorAll('.admin-toggle').forEach(function(toggle){toggle.addEventListener('change',async function(){const desired=this.checked;try{const response=await fetch(this.dataset.url,{method:'POST',headers:{'Accept':'application/json'}});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.message||'Update failed');location.reload();}catch(error){this.checked=!desired;alert(error.message);}});});
</script>
