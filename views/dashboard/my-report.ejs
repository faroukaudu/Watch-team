<%- include("../includes/header", {user:userInfo}); -%>

<style>
  .cursor-pointer { cursor: pointer; }
</style>
         <!-- Start::app-content -->
        <div class="main-content app-content">
            <div class="container-fluid">

                <!-- Start::page-header -->
                <div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <h1 class="page-title fw-medium fs-18 mb-2">Report Count</h1>
                        <div class="">
                            <nav>
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item"><a href="javascript:void(0);">report</a></li>
                                    <!-- <li class="breadcrumb-item"><a href="javascript:void(0);">CRM</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">Deals</li> -->
                                </ol>
                            </nav>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="d-flex gap-2">
                            <div class="position-relative">
                                <button class="btn btn-primary btn-wave" type="button"
                                    id="dropdownMenuClickableInside" data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside" aria-expanded="false">
                                    Filter By <i class="ri-arrow-down-s-fill ms-1"></i>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuClickableInside">
                                    <li><a class="dropdown-item" href="javascript:void(0);">Today</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Yesterday</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Last 7 Days</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Last 30 Days</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Last 6 Months</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Last Year</a></li>
                                </ul>
                            </div>
                            <button class="btn btn-secondary btn-icon btn-wave" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Download">
                                <i class="ti ti-download"></i>
                            </button>
                            <button class="btn btn-success btn-icon btn-wave" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Share">
                                <i class="ti ti-share-3"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <!-- End::page-header -->

               

                <!-- Start::row-2 -->
                 <h4>All Reports</h4>
                 
<hr>

<div class="row g-3">

  <div class="col-xxl-2 col-md-4">
    <form action="/reports-web" method="POST" class="m-0">
      <input type="hidden" name="category" value="general">
      <button type="submit" class="btn p-0 border-0 bg-transparent w-100 text-start">
        <div class="card custom-card cursor-pointer">
          <div class="card-body p-3">
            <div class="d-flex align-items-top flex-wrap justify-content-between">
              <div>
                <div class="fw-medium fs-15 mb-1 lead-discovered">General Report</div>
                <span class="badge bg-primary">View all General Report by Guards</span>
              </div>
              <div>
                <span class="text-primary fw-medium"><%=generalCount%></span>
                
              </div>
            </div>
          </div>
        </div>
      </button>
    </form>
  </div>

  <div class="col-xxl-2 col-md-4">
    <form action="/reports-web" method="POST" class="m-0">
      <input type="hidden" name="category" value="incident">
      <button type="submit" class="btn p-0 border-0 bg-transparent w-100 text-start">
        <div class="card custom-card cursor-pointer">
          <div class="card-body p-3">
            <div class="d-flex align-items-top flex-wrap justify-content-between">
              <div>
                <div class="fw-medium fs-15 mb-1 lead-qualified">Incident Reports</div>
                <span class="badge bg-secondary">View All Incident reported by Guards</span>
              </div>
              <div>
                <span class="text-warning fw-medium"><%=incidentsCount%></span>
              </div>
            </div>
          </div>
        </div>
      </button>
    </form>
  </div>

  <div class="col-xxl-2 col-md-4">
    <form action="/reports-web" method="POST" class="m-0">
      <input type="hidden" name="category" value="standard">
      <button type="submit" class="btn p-0 border-0 bg-transparent w-100 text-start">
        <div class="card custom-card cursor-pointer">
          <div class="card-body p-3">
            <div class="d-flex align-items-top flex-wrap justify-content-between">
              <div>
                <div class="fw-medium fs-15 mb-1 contact-initiated">Standard Report</div>
                <span class="badge bg-success">View Standard Reports</span>
              </div>
              <div>
                <span class="text-success fw-medium"><%= standardCount%></span>
              </div>
            </div>
          </div>
        </div>
      </button>
    </form>
  </div>

  <div class="col-xxl-2 col-md-4">
    <form action="/reports-web" method="POST" class="m-0">
      <input type="hidden" name="category" value="log">
      <button type="submit" class="btn p-0 border-0 bg-transparent w-100 text-start">
        <div class="card custom-card cursor-pointer">
          <div class="card-body p-3">
            <div class="d-flex align-items-top flex-wrap justify-content-between">
              <div>
                <div class="fw-medium fs-15 mb-1 need-identified">Log Reports</div>
                <span class="badge bg-pink">View all Logs</span>
              </div>
              <div>
                <span class="text-info fw-medium"><%=logCount%></span>
              </div>
            </div>
          </div>
        </div>
      </button>
    </form>
  </div>

  <div class="col-xxl-2 col-md-4">
    <form action="/reports-web" method="POST" class="m-0">
      <input type="hidden" name="category" value="nfc">
      <button type="submit" class="btn p-0 border-0 bg-transparent w-100 text-start">
        <div class="card custom-card cursor-pointer">
          <div class="card-body p-3">
            <div class="d-flex align-items-top flex-wrap justify-content-between">
              <div>
                <div class="fw-medium fs-15 mb-1 negotiation">NFC Report</div>
                <span class="badge bg-info">View NFC Logs</span>
              </div>
              <div>
                <span class="text-danger fw-medium"><%=logCount%></span>
              </div>
            </div>
          </div>
        </div>
      </button>
    </form>
  </div>

  <div class="col-xxl-2 col-md-4">
    <form action="/reports-web" method="POST" class="m-0">
      <input type="hidden" name="category" value="all">
      <button type="submit" class="btn p-0 border-0 bg-transparent w-100 text-start">
        <div class="card custom-card cursor-pointer">
          <div class="card-body p-3">
            <div class="d-flex align-items-top flex-wrap justify-content-between">
              <div>
                <div class="fw-medium fs-15 mb-1 deal-finalized">All Report</div>
                <span class="badge bg-warning">View All Report</span>
              </div>
              <div>
                <span class="text-secondary fw-medium"><%= reports.length%></span>
              </div>
            </div>
          </div>
        </div>
      </button>
    </form>
  </div>

</div>

                <!-- End::row-2 -->
                 

               

            </div>
        </div>
        <!-- End::app-content -->


        <!-- Footer Start -->
        <%- include("../includes/footer"); -%>
