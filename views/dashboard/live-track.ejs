      <script>
const companyId = <%- JSON.stringify(String(userInfo.assignedCompanyID || "")) %>;
const currentUserName = <%- JSON.stringify(userInfo.fullname || userInfo.username || "Current User") %>;
const rawUserType = <%- JSON.stringify(userInfo.userType || "User") %>;

function displayUserType(value) {
  const normalized = String(value || "").trim().toLowerCase().replace(/[_-]+/g, " ");
  if (normalized === "super admin") return "Super Admin";
  if (normalized === "platform admin") return "Platform Admin";
  if (normalized === "client" || normalized === "clients") return "Client";
  return value || "User";
}

const currentUserType = displayUserType(rawUserType);
const statusText = document.getElementById("statusText");
const setStatus = (text) => { statusText.textContent = text; };

const map = L.map("liveMap", { zoomControl: true }).setView([9.0765, 7.3986], 14);
const satellite = L.tileLayer(
  "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
  { maxZoom: 19, attribution: "Tiles © Esri" }
).addTo(map);
const dark = L.tileLayer(
  "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
  { maxZoom: 20, attribution: "&copy; OpenStreetMap &copy; CARTO" }
);
L.control.layers({ Satellite: satellite, Dark: dark }).addTo(map);
setTimeout(() => map.invalidateSize(), 250);

const guardMarkers = new Map();
let currentUserMarker = null;
let currentAccuracyCircle = null;
let hasCenteredOnUser = false;
let currentUserWatchId = null;
let lastAcceptedUserLocation = null;

function escapeHtml(value) {
  return String(value ?? "").replace(/[&<>'"]/g, (char) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    "'": "&#39;",
    '"': "&quot;"
  })[char]);
}

const CURRENT_USER_ICON = L.divIcon({
  className: "",
  html: `
    <div class="current-user-marker">
      <span class="marker-label">${escapeHtml(currentUserType)}</span>
      <span class="current-user-pulse"></span>
      <span class="current-user-pin"><i class="ri-user-location-fill"></i></span>
    </div>`,
  iconSize: [52, 62],
  iconAnchor: [26, 56],
  popupAnchor: [0, -54],
});

    function guardIcon(label) {
      const safeLabel = escapeHtml(label || "Guard");

      return L.divIcon({
        className: "",
        html: `
          <div class="lf-wrap">
            <span class="guard-label">${safeLabel}</span>
            <div
              class="lf-pulse"
              style="
                background: rgba(255,138,0,.34);
                box-shadow: 0 0 0 8px rgba(255,138,0,.18);
              "
            ></div>
            <!-- CHANGE THE POLICE/GUARD ICON CLASS ON THE NEXT LINE. -->
            <span class="guard-police-pin" aria-hidden="true">
              <i class="ri-shield-user-fill"></i>
            </span>
          </div>
        `,
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [0, -36]
      });
    }

        function updateDashboardStatus() {
      const count = guardMarkers.size;
      const guardText = `${count} checked-in guard${count === 1 ? "" : "s"}`;

      if (currentUserMarker) {
        setStatus(`showing your location and ${guardText}`);
      } else {
        setStatus(`showing ${guardText}`);
      }
    }

function updateCurrentUserLocation(position) {
  const latitude = Number(position.coords.latitude);
  const longitude = Number(position.coords.longitude);
  const accuracy = Number(position.coords.accuracy || 0);

  if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
    return;
  }

  const latlng = L.latLng(latitude, longitude);

  /*
   * Laptop/Wi-Fi location readings can shift slightly even when the user
   * is stationary. Keep the existing marker and ignore movements below
   * two metres so the pointer does not jump or flicker.
   */
  if (lastAcceptedUserLocation) {
    const movedMetres = lastAcceptedUserLocation.distanceTo(latlng);
    if (movedMetres < 2) {
      if (currentAccuracyCircle) {
        currentAccuracyCircle.setRadius(Math.max(accuracy, 8));
      }
      return;
    }
  }

  lastAcceptedUserLocation = latlng;

  /*
   * Create the current-user marker only once. Every later location result
   * simply moves the existing marker, preserving the current marker style.
   */
  if (!currentUserMarker) {
    currentUserMarker = L.marker(latlng, {
      icon: CURRENT_USER_ICON,
      zIndexOffset: 2000,
      title: `${currentUserName} - ${currentUserType}`,
      keyboard: true,
      riseOnHover: true,
    }).addTo(map);

    currentUserMarker.bindPopup(`
      <div style="min-width:180px">
        <strong>${escapeHtml(currentUserName)}</strong><br>
        <span>${escapeHtml(currentUserType)}</span><br>
        <small>Your current browser location</small>
      </div>
    `);
  } else {
    currentUserMarker.setLatLng(latlng);
  }

  if (!currentAccuracyCircle) {
    currentAccuracyCircle = L.circle(latlng, {
      radius: Math.max(accuracy, 8),
      weight: 1,
      opacity: .7,
      fillOpacity: .08,
      interactive: false,
    }).addTo(map);
  } else {
    currentAccuracyCircle.setLatLng(latlng);
    currentAccuracyCircle.setRadius(Math.max(accuracy, 8));
  }

  /*
   * The first successful location result immediately moves the map to
   * the user's current location. Later updates do not keep recentering
   * the map while the user is viewing checked-in guards.
   */
  if (!hasCenteredOnUser) {
    map.flyTo(latlng, 17, {
      animate: true,
      duration: 1.1,
    });
    hasCenteredOnUser = true;
  }

  setStatus(
    `showing your location and ${guardMarkers.size} checked-in guard${guardMarkers.size === 1 ? "" : "s"}`
  );
}

function handleLocationError(error) {
  const messages = {
    1: "Location permission denied. Allow location access in your browser.",
    2: "Your current location is unavailable.",
    3: "Location request timed out.",
  };

  /*
   * Do not remove the last known marker during a temporary location error.
   * Keeping it visible prevents the pointer from disappearing and returning.
   */
  if (currentUserMarker) {
    setStatus(
      `${messages[error.code] || "Location update failed."} Showing your last known location.`
    );
    return;
  }

  setStatus(messages[error.code] || "Could not load your current location.");
}

function beginContinuousLocationUpdates() {
  if (currentUserWatchId !== null) {
    return;
  }

  currentUserWatchId = navigator.geolocation.watchPosition(
    updateCurrentUserLocation,
    handleLocationError,
    {
      enableHighAccuracy: true,
      timeout: 20000,
      maximumAge: 5000,
    }
  );
}

function startCurrentUserTracking() {
  if (!navigator.geolocation) {
    setStatus("This browser does not support location services.");
    return;
  }

  setStatus("requesting your current location...");

  /*
   * getCurrentPosition triggers the permission prompt and supplies the
   * first location. Once permission is accepted, the map immediately
   * loads and centers on the user's current position.
   */
  navigator.geolocation.getCurrentPosition(
    (position) => {
      updateCurrentUserLocation(position);
      beginContinuousLocationUpdates();
    },
    (error) => {
      handleLocationError(error);

      /*
       * Start watching after a non-permission error so the page can recover
       * automatically when location becomes available.
       */
      if (error.code !== 1) {
        beginContinuousLocationUpdates();
      }
    },
    {
      enableHighAccuracy: true,
      timeout: 20000,
      maximumAge: 0,
    }
  );
}

window.addEventListener("beforeunload", () => {
  if (currentUserWatchId !== null && navigator.geolocation) {
    navigator.geolocation.clearWatch(currentUserWatchId);
  }
});

function getGuardId(payload) {
  return String(payload.guardId || payload.guardID || payload.userId || payload._id || "");
}

function upsertGuardMarker(payload) {
  const guardId = getGuardId(payload);
  const lat = Number(payload.lat ?? payload.latitude);
  const lng = Number(payload.lng ?? payload.long ?? payload.longitude);
  if (!guardId || Number.isNaN(lat) || Number.isNaN(lng)) return;

  const guardName = payload.guardName || payload.fullname || payload.name || `Guard ${guardId.slice(-4)}`;
  const latlng = [lat, lng];

  if (!guardMarkers.has(guardId)) {
    const marker = L.marker(latlng, {
      icon: guardIcon(guardName),
      zIndexOffset: 1000,
      title: guardName,
    }).addTo(map);
    marker.bindPopup(`<strong>${guardName}</strong><br><span>Checked-in Guard</span>`);
    guardMarkers.set(guardId, marker);
  } else {
    const marker = guardMarkers.get(guardId);
    marker.setLatLng(latlng);
    marker.setIcon(guardIcon(guardName));
    marker.setPopupContent(`<strong>${guardName}</strong><br><span>Checked-in Guard</span>`);
  }

  setStatus(`showing your location and ${guardMarkers.size} checked-in guard${guardMarkers.size === 1 ? "" : "s"}`);
}

function removeGuardMarker(guardId) {
  const id = String(guardId || "");
  const marker = guardMarkers.get(id);
  if (marker) {
    map.removeLayer(marker);
    guardMarkers.delete(id);
  }
  setStatus(`showing your location and ${guardMarkers.size} checked-in guard${guardMarkers.size === 1 ? "" : "s"}`);
}

const socket = io();
socket.on("connect", () => {
  socket.emit("join", { companyId });
  setStatus("connected - loading locations...");
});
socket.on("guard:location", upsertGuardMarker);
socket.on("guard:online", ({ guardName }) => {
  setStatus(`${guardName || "A guard"} checked in - waiting for GPS...`);
});
socket.on("guard:offline", ({ guardId }) => removeGuardMarker(guardId));
socket.on("disconnect", () => setStatus("live connection interrupted - reconnecting..."));


let latestCurrentPosition = null;
let lastWebLocationSavedAt = 0;

function formatTrackingTime(value) {
  if (!value) return "—";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "—";
  return date.toLocaleString([], {
    month: "short", day: "numeric", year: "numeric",
    hour: "2-digit", minute: "2-digit", second: "2-digit"
  });
}

function renderTrackingRows(rows) {
  const body = document.getElementById("liveTrackingRows");
  if (!body) return;
  if (!Array.isArray(rows) || rows.length === 0) {
    body.innerHTML = '<tr><td colspan="5" class="tracking-empty">No tracking activity has been recorded yet.</td></tr>';
    return;
  }

  body.innerHTML = rows.map((row) => {
    const status = row.status === "online" ? "online" : "offline";
    const source = row.source === "guard" ? "Guard App" : "Web Dashboard";
    const icon = row.source === "guard" ? "ri-shield-user-line" : "ri-computer-line";
    const location = row.locationLabel || (
      Number.isFinite(Number(row.latitude)) && Number.isFinite(Number(row.longitude))
        ? `${Number(row.latitude).toFixed(6)}, ${Number(row.longitude).toFixed(6)}`
        : "Location unavailable"
    );
    return `
      <tr>
        <td>
          <div class="tracking-user">
            <span class="tracking-avatar"><i class="${icon}"></i></span>
            <div><div class="tracking-name">${escapeHtml(row.userName || "User")}</div><div class="tracking-role">${escapeHtml(row.userType || "User")}</div></div>
          </div>
        </td>
        <td>${source}</td>
        <td><span class="tracking-status ${status}"><span></span>${status}</span></td>
        <td><div class="tracking-location" title="${escapeHtml(location)}">${escapeHtml(location)}</div></td>
        <td>${formatTrackingTime(row.recordedAt)}</td>
      </tr>`;
  }).join("");
}

async function loadCurrentTracking() {
  try {
    const response = await fetch("/api/tracking/current", {
      headers: { Accept: "application/json" },
      cache: "no-store",
    });
    const data = await response.json();

    if (response.ok && data.ok) {
      const rows = Array.isArray(data.rows) ? data.rows : [];
      renderTrackingRows(rows);

      // Rebuild checked-in guard markers from MongoDB after every page refresh.
      // Previously, saved guard coordinates were only displayed in the table,
      // while the map waited for a new Socket.IO GPS event.
      const onlineGuardIds = new Set();

      rows.forEach((row) => {
        if (row.source !== "guard" || row.status !== "online") return;

        const guardId = getGuardId(row);
        const lat = Number(row.latitude ?? row.lat);
        const lng = Number(row.longitude ?? row.lng ?? row.long);

        if (!guardId || !Number.isFinite(lat) || !Number.isFinite(lng)) return;

        onlineGuardIds.add(guardId);
        upsertGuardMarker({
          ...row,
          guardId,
          guardName: row.userName || row.guardName || row.fullname || "Guard",
          lat,
          lng,
        });
      });

      // Remove markers whose latest saved record is checkout/offline.
      for (const guardId of Array.from(guardMarkers.keys())) {
        if (!onlineGuardIds.has(String(guardId))) {
          removeGuardMarker(guardId);
        }
      }
    }
  } catch (error) {
    console.error("Current tracking load failed:", error);
  }
}

async function saveWebLocation(position) {
  const now = Date.now();
  if (now - lastWebLocationSavedAt < 20000) return;
  lastWebLocationSavedAt = now;
  latestCurrentPosition = position;

  try {
    await fetch("/api/tracking/web-location", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        latitude: position.coords.latitude,
        longitude: position.coords.longitude,
        accuracy: position.coords.accuracy,
      }),
    });
  } catch (error) {
    console.error("Web location history save failed:", error);
  }
}

const originalUpdateCurrentUserLocation = updateCurrentUserLocation;
updateCurrentUserLocation = function(position) {
  originalUpdateCurrentUserLocation(position);
  latestCurrentPosition = position;
  saveWebLocation(position);
};

socket.on("tracking:changed", loadCurrentTracking);
socket.on("web-user:location", loadCurrentTracking);
setInterval(loadCurrentTracking, 30000);
loadCurrentTracking();

window.addEventListener("pagehide", () => {
  const coords = latestCurrentPosition && latestCurrentPosition.coords;
  const payload = JSON.stringify({
    latitude: coords ? coords.latitude : null,
    longitude: coords ? coords.longitude : null,
    accuracy: coords ? coords.accuracy : null,
  });
  navigator.sendBeacon("/api/tracking/web-offline", new Blob([payload], { type: "application/json" }));
});

startCurrentUserTracking();
</script>
       
