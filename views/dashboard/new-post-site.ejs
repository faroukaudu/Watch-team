<%- include("../includes/header", {user:userInfo}); -%>

<style>
    .iti {
        width: 100% !important;
    }

    .iti input {
        width: 100% !important;
    }

    .address-find-btn {
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 5;
        white-space: nowrap;
    }

    #postSiteMap {
        height: 420px;
        width: 100%;
        border-radius: 10px;
    }
</style>

<div class="main-content app-content">
    <div class="container-fluid">

        <div class="d-flex align-items-center justify-content-between my-3 page-header-breadcrumb flex-wrap gap-2">
            <div>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/dashboard">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">New Post Sites</li>
                </ol>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Post Site
                        </div>
                    </div>

                    <form action="/create-post-site" method="post">
                        <div class="card-body">
                            <div class="row gy-4">

                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                                    <div class="form-floating">
                                        <select name="clientInformation" class="form-select" id="floatingSelect"
                                            aria-label="Floating label select example" required>
                                            <option value="" disabled selected></option>

                                            <% clientToSite.forEach(function(client){ %>
                                                <option value="<%= client.id + '&' + client.fullname %>">
                                                    <%= client.fullname %>
                                                </option>
                                            <% }) %>
                                        </select>

                                        <label for="floatingSelect" style="font-size:12px;">Assign Client</label>
                                    </div>
                                </div>

                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                                    <div class="form-floating">
                                        <input type="text" class="form-control" name="siteName" id="siteName" required>
                                        <label for="siteName">Post Site*</label>
                                    </div>
                                </div>

                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                    <div class="form-floating position-relative">
                                        <input type="text" class="form-control pe-5" name="address" id="siteAddress" required>
                                        <label for="siteAddress">Address*</label>

                                        <button
                                            type="button"
                                            id="findLocationBtn"
                                            class="btn btn-sm btn-primary position-absolute address-find-btn">
                                            Find Location
                                        </button>
                                    </div>
                                </div>

                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                                    <label for="siteLat" class="form-label"></label>
                                    <input type="text" name="lat" class="form-control" id="siteLat" placeholder="Latitude" required>
                                </div>

                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                                    <label for="siteLong" class="form-label"></label>
                                    <input type="text" name="long" class="form-control" id="siteLong" placeholder="Longitude" required>
                                </div>

                            </div>

                            <div style="margin-top: 40px;" class="accordion" id="accordionExample">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#collapseOne"
                                            aria-expanded="false" aria-controls="collapseOne">
                                            More Infomation
                                        </button>
                                    </h2>

                                    <div id="collapseOne" class="accordion-collapse collapse"
                                        aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                        <div class="accordion-body">
                                            <div class="row gy-4">

                                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                                                    <label class="form-label"></label>
                                                    <input type="text" class="form-control" placeholder="Fax">
                                                </div>

                                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12">
                                                    <label class="form-label"></label>
                                                    <input type="text" class="form-control" placeholder="Website">
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <button type="submit"
                            class="btn btn-primary-light btn-wave col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            Add New Post Site
                        </button>
                    </form>

                    <div class="card-footer d-none border-top-0"></div>
                </div>
            </div>
        </div>

    </div>
</div>

<%- include("../includes/footer"); -%>

<div class="modal fade" id="locationMapModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Find Post Site Location</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" id="mapSearchInput" class="form-control" placeholder="Search location">
                    <button type="button" id="mapSearchBtn" class="btn btn-primary">Search</button>
                </div>

                <div id="postSiteMap"></div>

                <small class="text-muted d-block mt-2">
                    You can drag the marker or click anywhere on the map to adjust the location.
                </small>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="useLocationBtn" class="btn btn-success">Use This Location</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="header-responsive-search" tabindex="-1" aria-labelledby="header-responsive-search"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <div class="input-group">
                    <input type="text" class="form-control border-end-0" placeholder="Search Anything ..."
                        aria-label="Search Anything ..." aria-describedby="button-addon2">
                    <button class="btn btn-primary" type="button" id="button-addon2">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="scrollToTop">
    <span class="arrow lh-1">
        <i class="ri-rocket-line align-middle fs-18"></i>
    </span>
</div>

<div id="responsive-overlay"></div>

<script src="assets/libs/@popperjs/core/umd/popper.min.js"></script>
<script src="assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="assets/js/defaultmenu.min.js"></script>
<script src="assets/libs/node-waves/waves.min.js"></script>
<script src="assets/js/sticky.js"></script>
<script src="assets/libs/simplebar/simplebar.min.js"></script>
<script src="assets/js/simplebar.js"></script>
<script src="assets/libs/@tarekraafat/autocomplete.js/autoComplete.min.js"></script>
<script src="assets/libs/@simonwep/pickr/pickr.es5.min.js"></script>
<script src="assets/libs/flatpickr/flatpickr.min.js"></script>
<script src="assets/libs/apexcharts/apexcharts.min.js"></script>
<script src="assets/js/sales-dashboard.js"></script>
<script src="assets/js/custom-switcher.min.js"></script>

<script src="https://maps.google.com/maps/api/js?key=AIzaSyASbZIITafeYZViSsD0PqqPcUVaX_dabm8"></script>
<script src="assets/js/google-maps.js"></script>
<script src="assets/libs/intl-tel-input/build/js/intlTelInput.min.js"></script>
<script src="assets/js/form-advanced.js"></script>

<script>
    let postSiteMap;
    let postSiteMarker;
    let selectedLatLng;
    let geocoder;

    const defaultLocation = {
        lat: 9.0765,
        lng: 7.3986
    };

    function initializePostSiteMap(location = defaultLocation) {
        geocoder = new google.maps.Geocoder();

        postSiteMap = new google.maps.Map(document.getElementById("postSiteMap"), {
            center: location,
            zoom: 15
        });

        postSiteMarker = new google.maps.Marker({
            position: location,
            map: postSiteMap,
            draggable: true
        });

        selectedLatLng = location;

        postSiteMarker.addListener("dragend", function () {
            const position = postSiteMarker.getPosition();

            selectedLatLng = {
                lat: position.lat(),
                lng: position.lng()
            };
        });

        postSiteMap.addListener("click", function (event) {
            selectedLatLng = {
                lat: event.latLng.lat(),
                lng: event.latLng.lng()
            };

            postSiteMarker.setPosition(event.latLng);
        });
    }

    function searchMapLocation(address) {
        if (!address) {
            alert("Please enter an address first.");
            return;
        }

        if (!geocoder) {
            geocoder = new google.maps.Geocoder();
        }

        geocoder.geocode({ address: address }, function (results, status) {
            if (status === "OK" && results[0]) {
                const location = results[0].geometry.location;

                selectedLatLng = {
                    lat: location.lat(),
                    lng: location.lng()
                };

                postSiteMap.setCenter(location);
                postSiteMap.setZoom(17);
                postSiteMarker.setPosition(location);
            } else {
                alert("Location not found. Please refine the address.");
            }
        });
    }

    document.getElementById("findLocationBtn").addEventListener("click", function (e) {
        e.preventDefault();

        const address = document.getElementById("siteAddress").value.trim();
        const modalElement = document.getElementById("locationMapModal");
        const modal = new bootstrap.Modal(modalElement);

        modal.show();

        setTimeout(function () {
            if (!postSiteMap) {
                initializePostSiteMap();
            }

            google.maps.event.trigger(postSiteMap, "resize");

            if (address) {
                document.getElementById("mapSearchInput").value = address;
                searchMapLocation(address);
            }
        }, 400);
    });

    document.getElementById("mapSearchBtn").addEventListener("click", function () {
        const searchValue = document.getElementById("mapSearchInput").value.trim();
        searchMapLocation(searchValue);
    });

    document.getElementById("mapSearchInput").addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();
            document.getElementById("mapSearchBtn").click();
        }
    });

    document.getElementById("useLocationBtn").addEventListener("click", function () {
        if (!selectedLatLng) {
            alert("Please select a location first.");
            return;
        }

        document.getElementById("siteLat").value = selectedLatLng.lat;
        document.getElementById("siteLong").value = selectedLatLng.lng;

        const modalElement = document.getElementById("locationMapModal");
        const modalInstance = bootstrap.Modal.getInstance(modalElement);

        if (modalInstance) {
            modalInstance.hide();
        }
    });
</script>

<script src="assets/js/custom.js"></script>

</body>
</html>