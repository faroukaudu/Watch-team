<%- include("../includes/header", { user: userInfo }); -%>
<div class="main-content app-content">
  <div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between my-4 flex-wrap gap-2">
      <div><h1 class="page-title fw-semibold fs-20 mb-1">Notifications</h1><p class="text-muted mb-0">Your latest Watch Team updates.</p></div>
      <button id="markAllNotificationsRead" class="btn btn-outline-primary btn-sm">Mark all as read</button>
    </div>
    <div class="card custom-card">
      <div class="card-body p-0">
        <% if (notifications && notifications.length) { %>
          <div class="list-group list-group-flush">
          <% notifications.forEach(function(n) { %>
            <a href="/notifications/<%= n._id %>/open" class="list-group-item list-group-item-action p-3 <%= n.isRead ? '' : 'bg-primary-transparent' %>">
              <div class="d-flex gap-3 align-items-start">
                <span class="avatar avatar-md rounded-circle <%= n.type === 'new_message' ? 'bg-info-transparent' : n.type === 'report_submitted' ? 'bg-primary-transparent' : n.type === 'subscription' ? 'bg-warning-transparent' : 'bg-success-transparent' %>">
                  <i class="<%= n.type === 'new_message' ? 'ri-chat-3-line' : n.type === 'report_submitted' ? 'ri-file-list-3-line' : n.type === 'subscription' ? 'ri-bank-card-line' : 'ri-user-location-line' %> fs-18"></i>
                </span>
                <div class="flex-fill"><div class="d-flex justify-content-between gap-2"><strong><%= n.title %></strong><small class="text-muted"><%= timeAgo(n.createdAt) %></small></div><p class="mb-0 text-muted"><%= n.message %></p></div>
                <% if (!n.isRead) { %><span class="badge bg-pink rounded-pill">New</span><% } %>
              </div>
            </a>
          <% }) %>
          </div>
        <% } else { %><div class="text-center py-5 text-muted"><i class="ri-notification-off-line fs-36"></i><p class="mt-2 mb-0">No notifications yet.</p></div><% } %>
      </div>
    </div>
  </div>
</div>
<script>
document.getElementById('markAllNotificationsRead')?.addEventListener('click', async function(){
 await fetch('/api/notifications/mark-all-read',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}); location.reload();
});
</script>
