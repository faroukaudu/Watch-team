<%- include("../includes/header", {user:userInfo}); -%>

<div class="main-content app-content">
  <div class="container-fluid">

    <!-- Page Header -->
    <div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h1 class="page-title fw-medium fs-18 mb-2">My Subscription</h1>
        <div>
          <nav>
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
              <li class="breadcrumb-item active" aria-current="page">My Subscription</li>
            </ol>
          </nav>
        </div>
      </div>
      <div class="btn-list">
        <a href="/pricing" class="btn btn-primary-light btn-wave me-2">
          <i class="ri-price-tag-3-line align-middle"></i> Change Plan
        </a>
        <a href="/dashboard" class="btn btn-light btn-wave">
          <i class="ri-arrow-left-line align-middle"></i> Back to Dashboard
        </a>
      </div>
    </div>

    <% if (typeof subscriptionNotice !== "undefined" && subscriptionNotice) { %>
      <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="ri-information-line me-1"></i> <%= subscriptionNotice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (!subscription) { %>
      <div class="row justify-content-center">
        <div class="col-xl-8">
          <div class="card custom-card">
            <div class="card-body text-center py-5">
              <div class="mb-3">
                <i class="ri-vip-crown-2-line fs-1 text-primary"></i>
              </div>
              <h4 class="fw-semibold mb-2">No active subscription found</h4>
              <p class="text-muted mb-4">
                Choose a plan to activate premium features and billing access.
              </p>
              <a href="/pricing" class="btn btn-primary btn-wave">
                Go to Pricing
              </a>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>

      <div class="row">
        <div class="col-xxl-4 col-xl-5">
          <div class="card custom-card overflow-hidden">
            <div class="card-body p-0">
              <div class="p-4 text-white" style="background: linear-gradient(135deg, #1d4ed8, #1e3a8a); min-height: 230px; position: relative;">
                <div style="position:absolute; top:-25px; right:-25px; width:110px; height:110px; border-radius:50%; background: rgba(255,255,255,0.08);"></div>
                <div style="position:absolute; bottom:-20px; left:-20px; width:90px; height:90px; border-radius:50%; background: rgba(255,255,255,0.06);"></div>

                <div class="d-flex justify-content-between align-items-start position-relative">
                  <div>
                    <span class="badge bg-light text-dark mb-3">
                      <%= subscription.planName || "Subscription" %>
                    </span>
                    <h4 class="fw-semibold text-white mb-1"><%= subscription.planName || "-" %></h4>
                    <p class="mb-0 text-white-50 text-capitalize">
                      <%= subscription.billingCycle || "-" %> Plan
                    </p>
                  </div>
                  <div class="text-end">
                    <% if (subscription.isActive) { %>
                      <span class="badge bg-success">Active</span>
                    <% } else { %>
                      <span class="badge bg-danger">Inactive</span>
                    <% } %>
                  </div>
                </div>

                <div class="mt-5 position-relative">
                  <div class="fs-13 text-white-50 mb-1">Gateway</div>
                  <div class="fs-5 fw-semibold text-uppercase"><%= subscription.gateway || "-" %></div>
                </div>

                <div class="d-flex justify-content-between mt-4 position-relative">
                  <div>
                    <div class="fs-12 text-white-50">Started</div>
                    <div class="fw-medium">
                      <%= subscription.startsAt ? new Date(subscription.startsAt).toLocaleDateString() : "-" %>
                    </div>
                  </div>
                  <div class="text-end">
                    <div class="fs-12 text-white-50">Expires</div>
                    <div class="fw-medium">
                      <%= subscription.expiresAt ? new Date(subscription.expiresAt).toLocaleDateString() : "-" %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="p-4">
                <div class="d-flex justify-content-between py-2 border-bottom">
                  <span class="text-muted">Username</span>
                  <span class="fw-medium"><%= subscription.username || "-" %></span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                  <span class="text-muted">Email</span>
                  <span class="fw-medium text-break text-end"><%= subscription.email || "-" %></span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                  <span class="text-muted">Plan Code</span>
                  <span class="fw-medium"><%= subscription.planCode || "-" %></span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                  <span class="text-muted">Subscription Status</span>
                  <span class="badge bg-success-transparent">
                    <%= subscription.subscriptionStatus || "-" %>
                  </span>
                </div>
                <div class="d-flex justify-content-between py-2">
                  <span class="text-muted">Amount</span>
                  <span class="fw-medium">
                    <%= subscription.amount ? `${subscription.currency || "USD"} ${subscription.amount}` : "-" %>
                  </span>
                </div>

                <div class="d-grid gap-2 mt-4">
                  <a href="/billing/payment-method" class="btn btn-primary btn-wave">
                    <i class="ri-bank-card-line me-1"></i> Manage Payment Method
                  </a>

                  <% if (subscription.gateway === "stripe") { %>
                    <form action="/billing/stripe/portal" method="POST">
                      <button type="submit" class="btn btn-light btn-wave w-100">
                        <i class="ri-settings-3-line me-1"></i> Manage Card / Billing
                      </button>
                    </form>
                  <% } %>

                  <% if (subscription.gateway === "paypal") { %>
                    <a href="/billing/paypal/manage" class="btn btn-warning btn-wave">
                      <i class="ri-paypal-line me-1"></i> Manage PayPal Subscription
                    </a>
                  <% } %>

                  <% if (subscription.isActive) { %>
                    <button
                      type="button"
                      class="btn btn-danger-light btn-wave w-100"
                      data-bs-toggle="modal"
                      data-bs-target="#cancelSubscriptionModal"
                    >
                      <i class="ri-close-circle-line me-1"></i> Cancel Subscription
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-xxl-8 col-xl-7">
          <div class="card custom-card">
            <div class="card-header">
              <div class="card-title">Included Features</div>
            </div>
            <div class="card-body">
              <div class="row g-3">

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Dashboard</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.dashboard ? "Enabled" : "Disabled" %></p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Activity</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.activity ? "Enabled" : "Disabled" %></p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Clients</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.clients ? "Enabled" : "Disabled" %></p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Security Team</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.securityTeam ? "Enabled" : "Disabled" %></p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Time Clock</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.timeClock ? "Enabled" : "Disabled" %></p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Messenger</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.messenger ? "Enabled" : "Disabled" %></p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Reporting</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.reportingDays || 0 %> Days</p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">GPS Tracking</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.gpsTrackingDays || 0 %> Days</p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Geofence</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.geofenceDays || 0 %> Days</p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Site Tour</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.siteTourDays || 0 %> Days</p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Task</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.taskDays || 0 %> Days</p>
                  </div>
                </div>

                <div class="col-md-6 col-xl-4">
                  <div class="border rounded p-3 h-100">
                    <h6 class="fw-semibold mb-2">Checklist</h6>
                    <p class="text-muted mb-0"><%= subscription.features?.checklistDays || 0 %> Days</p>
                  </div>
                </div>

              </div>
            </div>
          </div>

          <div class="card custom-card">
            <div class="card-header">
              <div class="card-title">Billing Access</div>
            </div>
            <div class="card-body">
              <p class="text-muted mb-3">
                Your billing and payment methods are managed securely through your payment gateway. Use the buttons below to manage card details, billing information, or subscription actions.
              </p>

              <div class="d-flex gap-2 flex-wrap">
                <a href="/billing/payment-method" class="btn btn-outline-primary btn-wave">
                  <i class="ri-bank-card-line me-1"></i> Payment Method
                </a>

                <% if (subscription.gateway === "stripe") { %>
                  <form action="/billing/stripe/portal" method="POST">
                    <button type="submit" class="btn btn-primary btn-wave">
                      <i class="ri-settings-3-line me-1"></i> Stripe Billing Portal
                    </button>
                  </form>
                <% } %>

                <% if (subscription.gateway === "paypal") { %>
                  <a href="/billing/paypal/manage" class="btn btn-warning btn-wave">
                    <i class="ri-paypal-line me-1"></i> PayPal Manage
                  </a>
                <% } %>

                <% if (subscription.isActive) { %>
                  <button
                    type="button"
                    class="btn btn-outline-danger btn-wave"
                    data-bs-toggle="modal"
                    data-bs-target="#cancelSubscriptionModal"
                  >
                    <i class="ri-close-circle-line me-1"></i> Cancel Subscription
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

    <% } %>
  </div>
</div>

<% if (subscription && subscription.isActive) {
     const expiryTime = subscription.expiresAt ? new Date(subscription.expiresAt).getTime() : Date.now();
     const remainingMs = Math.max(0, expiryTime - Date.now());
     const remainingDays = Math.ceil(remainingMs / (1000 * 60 * 60 * 24));
%>
<div class="modal fade" id="cancelSubscriptionModal" tabindex="-1" aria-labelledby="cancelSubscriptionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title" id="cancelSubscriptionModalLabel">Cancel Subscription?</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning mb-3">
          <i class="ri-alert-line me-1"></i>
          You still have <strong><%= remainingDays %> day<%= remainingDays === 1 ? "" : "s" %></strong> remaining on your current subscription.
        </div>
        <p class="mb-2">
          Cancelling now will render your current subscription <strong>void immediately</strong>.
        </p>
        <p class="text-muted mb-0">
          You will lose access to the features included in this plan, even though time remains in the current billing period. This action cannot be undone.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Keep Subscription</button>
        <form action="/billing/cancel-subscription" method="POST" class="m-0">
          <button type="submit" class="btn btn-danger">
            Yes, Cancel Subscription
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
<% } %>

<%- include("../includes/footer"); -%>

       <div class="modal fade" id="header-responsive-search" tabindex="-1" aria-labelledby="header-responsive-search" aria-hidden="true">
    <div class="modal-dialog">
