        <script>
            document.getElementById('alert-confirm').onclick = function () {
                // alert("deleting");

                Swal.fire({
                    title: 'Are you sure this Guard?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#db061a',
                    cancelButtonColor: '#db061a',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire(
                            'Deleted!',
                            '<%= guardInfo.fullname %> has been deleted.',
                            'success'
                        )
                        setTimeout(() => {
                            // runs after 2 seconds
                            document.getElementById('deleting-guard').requestSubmit();
                        }, 2000);

                    }
                })
            }

            document.getElementById('block-guard').onclick = function () {

                // Convert EJS variable into a JS boolean safely
                const isBlocked = "<%= guardInfo.status %>" === "true";

                // Dynamic text and button based on status
                const actionText = isBlocked ? "block" : "unblock";
                const confirmColor = isBlocked ? "#28a745" : "#db061a"; // green for unblock, red for block

                Swal.fire({
                    title: `Are you sure you want to ${actionText} this Guard?`,
                    text: isBlocked ? "You can block again later 👍." : "You can revert this 👍.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: confirmColor,
                    cancelButtonColor: '#d33',
                    confirmButtonText: `Yes, ${actionText} this guard!`
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire(
                            `${isBlocked ? 'Blocked' : 'Unblocked'}!`,
                            `<%= guardInfo.fullname %> has been ${isBlocked ? 'Blocked' : 'unblocked'}.`,
                            'success'
                        );

                        setTimeout(() => {
                            document.getElementById('blocking-guard').requestSubmit();
                        }, 2000);
                    }
                });
            }
        </script>


