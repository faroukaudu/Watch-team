                                </span> to a New PostSite</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body px-4">

                            <div class="tab-pane show active text-muted" id="pills-home" role="tabpanel"
                                aria-labelledby="pills-home-tab" tabindex="0">

                                <form action="/new-guard-postSite" method="post" class="row gy-4 assign-form">

                                    <div class="col-xl-6 col-lg-6 col-md-4 col-sm-12">
                                        <div class="form-floating">
                                            <select id="clientSelect-2" class="form-select clientSelect"
                                                name="clientId">
                                                <option value="">-- Select Client --</option>
                                                <% myClients.forEach(c=> { %>
                                                    <option value="<%= c._id %>">
                                                        <%= c.fullname %>
                                                    </option>
                                                    <% }) %>
                                                        <!-- <option value="EFCC">EFCC</option>
                                                                <option value="POLICE">POLICE</option> -->
                                            </select>
                                            <label for="clientSelect-2">Select Clients</label>
                                        </div>
                                    </div>
                                    <input type="hidden" name="guard_id" value="<%= guardInfo._id%>">
                                    <div class="col-xl-6 col-lg-6 col-md-4 col-sm-12 mb-4">
                                        <div class="form-floating">
                                            <select id="siteSelect-2" class="form-select siteSelect" name="siteId"
                                                disabled>
                                                <option value="">-- Select a client first --</option>
                                            </select>
                                            <label for="siteSelect-2">Assign Post</label>
                                        </div>

                                    </div>

                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-light"
                                            data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary-light btn-wave">Assign to New
                                            PostSite</button>

                                        <!-- <button type="button" class="btn btn-primary" id="submitTaskBtn">Add Task</button> -->
                                    </div>


                                </form>
                                <script>
                                    document.addEventListener('change', async (e) => {
                                        if (!e.target.matches('.clientSelect')) return;

                                        const form = e.target.closest('.assign-form');     // scope to the correct pair
                                        const siteSelect = form.querySelector('.siteSelect');
                                        const clientId = e.target.value;

                                        // reset target dropdown
                                        siteSelect.innerHTML = '<option value="">-- Select a client first --</option>';
                                        siteSelect.disabled = true;

                                        if (!clientId) return;

                                        try {
                                            const res = await fetch(`/api/clients/${encodeURIComponent(clientId)}/sites`, {
                                                headers: { 'Accept': 'application/json' }
                                            });
                                            if (!res.ok) throw new Error('Failed to load sites');

                                            // Expecting { sites: [...] }. If your server does res.send(sites), handle both:
                                            const data = await res.json();
                                            const sites = Array.isArray(data) ? data : (data.sites || []);

                                            if (!sites.length) {
                                                siteSelect.innerHTML = '<option value="">No sites for this client</option>';
                                                return;
                                            }

                                            siteSelect.innerHTML = '<option value="">-- Select Site --</option>';
                                            sites.forEach(s => {
                                                const opt = document.createElement('option');
                                                opt.value = s._id || s.siteId || s.value || s.siteName;  // adjust to your schema
                                                opt.textContent = s.siteName || s.name || String(opt.value);
                                                siteSelect.appendChild(opt);
                                            });
                                            siteSelect.disabled = false;
                                        } catch (err) {
                                            console.error(err);
                                            siteSelect.innerHTML = '<option value="">Error loading sites</option>';
                                        }
                                    });
                                </script>

                            </div>



