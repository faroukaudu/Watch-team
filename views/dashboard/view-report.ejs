<%- include("../includes/header", {user:userInfo}); -%>
    <link rel="stylesheet" href="assets/libs/glightbox/css/glightbox.min.css">
    <!-- Plyr CSS -->
    <!-- <link rel="stylesheet" href="assets/libs/plyr/plyr.css"> -->
    <style>
        .cursor-pointer {
            cursor: pointer;
        }

        .myVideo {
            width: 280px;
            /* change to what you want */
            height: 280px;
            /* change to what you want */
            object-fit: cover;
            /* or "contain" if you don't want cropping */
        }
    </style>
    <!-- Start::app-content -->
    <div class="main-content app-content">
        <div class="container-fluid">

            <!-- Page Header -->
            <div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h1 class="page-title fw-medium fs-18 mb-2">Report Overview</h1>
                    <div class="">
                        <nav>
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
                                <li class="breadcrumb-item"><a href="/my-report">all report</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Projects Overview</li>
                            </ol>
                        </nav>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="d-flex gap-2">
                        <div class="position-relative">
                            <button class="btn btn-primary btn-wave" type="button" id="dropdownMenuClickableInside"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                Filter By <i class="ri-arrow-down-s-fill ms-1"></i>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuClickableInside">
                                <li><a class="dropdown-item" href="javascript:void(0);">Today</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Yesterday</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Last 7 Days</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Last 30 Days</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Last 6 Months</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Last Year</a></li>
                            </ul>
                        </div>
                        <button class="btn btn-secondary btn-icon btn-wave" data-bs-toggle="tooltip"
                            data-bs-placement="top" data-bs-title="Download">
                            <i class="ti ti-download"></i>
                        </button>
                        <button class="btn btn-success btn-icon btn-wave" data-bs-toggle="tooltip"
                            data-bs-placement="top" data-bs-title="Share">
                            <i class="ti ti-share-3"></i>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Page Header Close -->

            <!-- Start::row-1 -->
            <div class="row">
                <div class="col-xl-4">
                    <div class="card custom-card overflow-hidden">
                        <div class="card-header justify-content-between">
                            <div class="card-title">
                                Project Team
                            </div>
                            <!-- <div>
                                <button class="btn btn-light btn-sm btn-wave">Send Report <i
                                        class="ri-send-plane-2-line align-middle me-1 fw-medium"></i></button>
                            </div> -->
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table text-nowrap">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Designation</th>
                                            <!-- <th>Actions</th> -->
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="me-2 lh-1">
                                                        <span class="avatar avatar-xs avatar-rounded">
                                                            <img src="../assets/images/faces/2.jpg" alt="">
                                                        </span>
                                                    </div>
                                                    <div class="fw-medium fs-13">
                                                        <%=companyInfo.postSite[0].clientName %>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary-transparent">Client Name</span>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="me-2 lh-1">
                                                        <span class="avatar avatar-xs avatar-rounded">
                                                            <img src="../assets/images/faces/8.jpg" alt="">
                                                        </span>
                                                    </div>
                                                    <div class="fw-medium fs-13">
                                                        <%= reports.fullname%>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-pink-transparent">Security Guard</span>
                                            </td>

                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="card custom-card ">
                        <div class="card-header justify-content-between ">
                            <div class="card-title">Guard Signature</div>

                            <!-- <div class="btn btn-sm btn-light btn-wave"><i
                                    class="ri-add-line align-middle me-1 fw-medium"></i>Add Goal</div> -->
                        </div>
                        <div class="card-body ">
                            <% reports.attachments.forEach(function(att){ %>
                                <% if(att.kind==='signature' ){ %>
                                    <div class="mt-3 text-center">
                                        <img src="<%=att.secureUrl %>" height="100px" alt="signature"
                                            style="align-items: center;">
                                    </div>
                                    <% } %>
                                        <% }) %>

                                            <div class="mt-3 text-center">
                                                <span class="badge bg-success-transparent">Authenticated</span>

                                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-xl-8">
                    <div class="card custom-card">
                        <div class="card-footer">
                            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                <div>
                                    <span class="d-block text-muted fs-12">Client Name</span>
                                    <div class="d-flex align-items-center">
                                        <div class="me-2 lh-1">
                                            <span class="avatar avatar-xs avatar-rounded">
                                                <img src="../assets/images/faces/13.jpg" alt="">
                                            </span>
                                        </div>
                                        <span class="d-block fs-14 fw-medium">
                                            <%=companyInfo.postSite[0].clientName %>
                                        </span>
                                    </div>
                                </div>
                                <div>
                                    <span class="d-block text-muted fs-12">Guard Name</span>
                                    <span class="d-block fs-14 fw-medium">
                                        <%= reports.fullname%>
                                    </span>
                                </div>
                                <div>
                                    <span class="d-block text-muted fs-12">Date Incident</span>
                                    <span class="d-block fs-14 fw-medium">
                                        <%= reports.createdAt.toLocaleString('en-US', { year: 'numeric' , month: 'short'
                                            , day: '2-digit' , hour: '2-digit' , minute: '2-digit' })%>
                                    </span>
                                </div>

                                <div>
                                    <span class="d-block text-muted fs-12">Status</span>
                                    <% if(reports.status==true){ %>
                                        <span class="d-block fs-14 fw-medium"><span
                                                class="badge bg-success-transparent">Approved Report</span></span>
                                        <% }else{ %>
                                            <span class="d-block"><span class="badge bg-primary-transparent">pending
                                                    approval</span></span>
                                            <% } %>
                                </div>
                                <!-- <div>
                                    <span class="d-block text-muted fs-12">Priority</span>
                                    <span class="d-block fs-14 fw-medium"><span
                                            class="badge bg-success-transparent">Low</span></span>
                                </div> -->
                            </div>
                            <hr>
                        </div>
                        <div class="card-header justify-content-between">
                            <div class="card-title">
                                Report Details
                            </div>
                            <% if(reports.status==false){ %>
                                <div>
                                    <a href="/approve-report/<%=reports._id%>" class="btn btn-sm btn-primary btn-wave"
                                        onclick="approveReport('<%= reports._id %>')">
                                        <i class="ri-verified-badge-line align-middle me-1 fw-medium"></i>Approve
                                        Report</a>
                                </div>
                                <% }else{ %>
                                    <div>
                                        <button class="btn btn-sm btn-dark btn-wave" disabled>
                                            <i class="ri-checkbox-circle-line align-middle me-1 fw-medium"></i> Approved
                                        </button>
                                    </div>
                                    <% } %>
                        </div>
                        <script>
                            async function approveReport(id) {
                                const res = await fetch(`/approve-report/${id}`, { method: "GET" });

                                let data = null;
                                try { data = await res.json(); } catch (_) { }

                                if (!res.ok) {
                                    console.log("Approve failed:", res.status, data);
                                    alert(data?.msg || `Failed to approve (${res.status})`);
                                    return;
                                }

                                location.reload();
                            }
                        </script>

                        <div class="card-body">
                            <h5 class="fw-medium mb-4 task-title">
                                <%= reports.title%>
                            </h5>

                            <ul class="list-unstyled mb-0">
                                <% Object.entries(reports.fields || {}).forEach(([k, v])=> { %>
                                    <div class="fs-15 fw-medium mb-2">
                                        <%= k%> :
                                    </div>
                                    <p class="text-muted task-description">
                                        <% if (k==="postSiteId" && reports.fields.postSiteName) { %>
                                            <%= reports.fields.postSiteName %>
                                                <% } else { %>
                                                    <%= v %>
                                                        <% } %>
                                    </p>
                                    <!-- <div class="fs-15 fw-medium mb-2">Key tasks :</div> -->
                                    <p>

                                        <% }) %>
                            </ul>
                            </p>
                            <!-- <div class="mb-3">
                                <ul class="task-details-key-tasks mb-0">
                                    <li>Assess the current inventory management system to identify pain points,
                                        limitations, and areas in need of improvement.</li>
                                    <li>Redesign the user interface for improved user experience, making it more
                                        intuitive and user-friendly.</li>
                                    <li>Optimize the database structure and performance for faster data retrieval and
                                        storage.</li>
                                    <li>Implement barcode scanning functionality to expedite product entry and tracking.
                                    </li>
                                    <li>Develop an automated reorder system that alerts staff when inventory levels
                                        reach predefined thresholds.</li>
                                    <li> Create reporting and analytics capabilities to provide insights into inventory
                                        turnover and forecasting.</li>
                                </ul>
                            </div>
                            <div class="fs-15 fw-medium mb-2">Skills :</div>
                            <div>
                                <span class="badge bg-light text-default border">Teamwork</span>
                                <span class="badge bg-light text-default border">Graphic Design</span>
                                <span class="badge bg-light text-default border">Responsive Design</span>
                                <span class="badge bg-light text-default border">Web Accessibility</span>
                                <span class="badge bg-light text-default border">Front-End Build Tools</span>
                                <span class="badge bg-light text-default border">RESTful APIs</span>
                                <span class="badge bg-light text-default border">Performance Testing</span>
                                <span class="badge bg-light text-default border">Angular</span>
                                <span class="badge bg-light text-default border">Vue.js</span>
                            </div> -->
                        </div>

                    </div>
                    <div class="card custom-card">
                        <div class="card-header">
                            <h5 class="fw-medium  task-title">
                                Attachments
                            </h5>

                        </div>
                        <div class="card-body">
                            <div class="card-title"> Report Audio</div>

                        </div>
                        <div class="card-footer">
                            <div class="row">
                                <% reports.attachments.forEach(function(attach){ %>
                                    <% if(attach.kind==="audio" ){ %>
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                                            <audio id="player2" controls>
                                                <source src="<%= attach.secureUrl%>" type="audio/mp3">
                                            </audio>
                                        </div>
                                        <% } %>
                                            <% }) %>

                            </div>
                        </div>
                        <div class="card-body">
                            <div class="card-title"> Report Images</div>

                        </div>
                        <div class="card-footer">
                            <div class="row">
                                <% reports.attachments.forEach(function(attach){ %>
                                    <% if(attach.kind==="image" ){ %>
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                                            <a href="<%= attach.secureUrl%>" class="glightbox card"
                                                data-gallery="gallery1">
                                                <img src="<%= attach.secureUrl%>" alt="image">
                                            </a>
                                        </div>
                                        <% } %>
                                            <% }) %>

                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="card-title"> Report Videos</div>

                        </div>
                        <div class="card-footer">
                            <div class="row">
                                <% reports.attachments.forEach(function(attach){ %>
                                    <% if(attach.kind==="video" ){ %>
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                                            <video id="player" class="myVideo" playsinline controls
                                                data-poster="https://cdn.plyr.io/static/demo/View_From_A_Blue_Moon_Trailer-HD.jpg">
                                                <source src="<%= attach.secureUrl%>" type="video/mp4">
                                                <!-- <source src="https://cdn.plyr.io/static/demo/View_From_A_Blue_Moon_Trailer-720p.mp4" type="video/mp4" >
                                    <source src="https://cdn.plyr.io/static/demo/View_From_A_Blue_Moon_Trailer-1080p.mp4" type="video/mp4" > -->
                                            </video>
                                        </div>

                                        <% } %>
                                            <% }) %>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!--End::row-1 -->

        </div>
    </div>
