    <style>
        /* Scroll container */
        .payroll-scroll {
            max-height: 420px;
            overflow-y: auto;
        }

        /* Chrome, Edge, Safari */
        .payroll-scroll::-webkit-scrollbar {
            width: 8px;
        }

        .payroll-scroll::-webkit-scrollbar-track {
            background: #a10a0a;
            border-radius: 10px;
        }

        .payroll-scroll::-webkit-scrollbar-thumb {
            background: #8d0952;
            border-radius: 10px;
        }

        .payroll-scroll::-webkit-scrollbar-thumb:hover {
            background: #0cbe29;
        }

        /* Firefox */
        .payroll-scroll {
            scrollbar-width: thin;
            scrollbar-color: #465b77 #040d1a;
        }

        .payroll-scroll {
            max-height: 420px;
            /* adjust height for ~8 rows */
            overflow-y: scroll;
        }

        /* Make table header sticky */
        .payroll-scroll thead th {
            position: sticky;
            top: 0;
            /* background: white; */
            z-index: 2;
        }
    </style>


