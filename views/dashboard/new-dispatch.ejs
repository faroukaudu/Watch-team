<%- include("../includes/header", {user:userInfo}); -%>

<div class="main-content app-content">
  <div class="container-fluid">

    <div class="d-flex align-items-center justify-content-between my-3 page-header-breadcrumb flex-wrap gap-2">
      <div>
        <h1 class="page-title fw-medium fs-18 mb-2">
          <%= dispatchInfo ? 'Edit Dispatch' : 'New Dispatch' %>
        </h1>
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
          <li class="breadcrumb-item"><a href="/dispatch">Dispatch</a></li>
          <li class="breadcrumb-item active"><%= dispatchInfo ? 'Edit' : 'Create' %></li>
        </ol>
      </div>

      <a href="/dispatch" class="btn btn-light">
        <i class="ri-arrow-left-line me-1"></i> Back
      </a>
    </div>

    <form action="<%= dispatchInfo ? '/update-dispatch' : '/create-dispatch' %>" method="POST">
      <% if (dispatchInfo) { %>
        <input type="hidden" name="dispatchId" value="<%= dispatchInfo._id %>">
      <% } %>

      <div class="row">

        <div class="col-xl-12">
          <div class="card custom-card">
            <div class="card-header">
              <div class="card-title">Dispatch Information</div>
            </div>

            <div class="card-body">
              <div class="row gy-3">

                <div class="col-md-4">
                  <label class="form-label">Client</label>
                  <select class="form-select" name="clientInfo" id="clientSelect" required>
                    <option value="">Select Client</option>
                    <% clients.forEach(function(client){ %>
                      <option value="<%= client._id %>&<%= client.fullname %>"
                        <%= dispatchInfo && dispatchInfo.clientId == client._id ? 'selected' : '' %>>
                        <%= client.fullname %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Post Site</label>
                  <select class="form-select" name="postSiteInfo" id="postSiteSelect" required>
                    <option value="">Select Post Site</option>
                    <% postSites.forEach(function(site){ %>
                      <option 
                        value="<%= site._id %>&<%= site.siteName %>&<%= site.clientID %>"
                        data-client-id="<%= site.clientID %>"
                        <%= dispatchInfo && dispatchInfo.postSiteId == site._id ? 'selected' : '' %>>
                        <%= site.siteName %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Assign Guard</label>
                  <select class="form-select" name="guardInfo">
                    <option value="">Select Guard</option>
                    <% guards.forEach(function(guard){ %>
                      <option value="<%= guard._id %>&<%= guard.fullname %>"
                        <%= dispatchInfo && dispatchInfo.guardId == guard._id ? 'selected' : '' %>>
                        <%= guard.fullname %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Priority</label>
                  <select class="form-select" name="priority" required>
                    <option value="">Select Priority</option>
                    <option value="High" <%= dispatchInfo && dispatchInfo.priority === 'High' ? 'selected' : '' %>>High</option>
                    <option value="Medium" <%= dispatchInfo && dispatchInfo.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
                    <option value="Low" <%= dispatchInfo && dispatchInfo.priority === 'Low' ? 'selected' : '' %>>Low</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Caller Type</label>
                  <select class="form-select" name="callerType" required>
                    <option value="">Select Caller Type</option>
                    <option value="Client" <%= dispatchInfo && dispatchInfo.callerType === 'Client' ? 'selected' : '' %>>Client</option>
                    <option value="Guard" <%= dispatchInfo && dispatchInfo.callerType === 'Guard' ? 'selected' : '' %>>Guard</option>
                    <option value="Tenant" <%= dispatchInfo && dispatchInfo.callerType === 'Tenant' ? 'selected' : '' %>>Tenant</option>
                    <option value="Other" <%= dispatchInfo && dispatchInfo.callerType === 'Other' ? 'selected' : '' %>>Other</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Caller Name</label>
                  <input type="text" class="form-control" name="callerName"
                    value="<%= dispatchInfo ? dispatchInfo.callerName : '' %>" required>
                </div>

              </div>
            </div>
          </div>
        </div>

        <div class="col-xl-12">
          <div class="card custom-card">
            <div class="card-header">
              <div class="card-title">Incident Details</div>
            </div>

            <div class="card-body">
              <div class="row gy-3">

                <div class="col-md-6">
                  <label class="form-label">Incident Location</label>
                  <input type="text" class="form-control" name="incidentLocation"
                    value="<%= dispatchInfo ? dispatchInfo.incidentLocation : '' %>" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Incident Type</label>
                  <select class="form-select" name="incidentType" required>
                    <% const selectedType = dispatchInfo ? dispatchInfo.incidentType : ''; %>
                    <option value="">Select Incident Type</option>
                    <option value="Abandoned Vehicle" <%= selectedType === 'Abandoned Vehicle' ? 'selected' : '' %>>Abandoned Vehicle</option>
                    <option value="Accident" <%= selectedType === 'Accident' ? 'selected' : '' %>>Accident</option>
                    <option value="Arson" <%= selectedType === 'Arson' ? 'selected' : '' %>>Arson</option>
                    <option value="Assault" <%= selectedType === 'Assault' ? 'selected' : '' %>>Assault</option>
                    <option value="Break In" <%= selectedType === 'Break In' ? 'selected' : '' %>>Break In</option>
                    <option value="Collision" <%= selectedType === 'Collision' ? 'selected' : '' %>>Collision</option>
                  </select>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Incident Date & Time</label>
                  <input type="datetime-local" class="form-control" name="incidentDateTime"
                    value="<%= dispatchInfo && dispatchInfo.incidentDateTime ? new Date(dispatchInfo.incidentDateTime).toISOString().slice(0,16) : '' %>" required>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Attachments</label>
                  <input type="file" class="form-control" name="attachments" multiple>
                </div>

                <div class="col-md-12">
                  <label class="form-label">Incident Details</label>
                  <textarea class="form-control" name="incidentDetails" rows="4" required><%= dispatchInfo ? dispatchInfo.incidentDetails : '' %></textarea>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Action Taken</label>
                  <textarea class="form-control" name="actionTaken" rows="4"><%= dispatchInfo ? dispatchInfo.actionTaken : '' %></textarea>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Internal Notes</label>
                  <textarea class="form-control" name="internalNotes" rows="4"><%= dispatchInfo ? dispatchInfo.internalNotes : '' %></textarea>
                </div>

              </div>
            </div>
          </div>
        </div>

        <div class="col-xl-12 text-end mb-4">
          <a href="/dispatch" class="btn btn-light me-2">Cancel</a>
          <button type="submit" class="btn btn-primary">
            <%= dispatchInfo ? 'Update Dispatch' : 'Save Dispatch' %>
          </button>
        </div>

      </div>
    </form>

  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const clientSelect = document.getElementById("clientSelect");
    const postSiteSelect = document.getElementById("postSiteSelect");
    const allPostOptions = Array.from(postSiteSelect.querySelectorAll("option"));

    function filterPostSites() {
      const selectedClient = clientSelect.value;
      const clientId = selectedClient ? selectedClient.split("&")[0] : "";

      postSiteSelect.innerHTML = "";

      allPostOptions.forEach(option => {
        if (!option.value) {
          postSiteSelect.appendChild(option.cloneNode(true));
          return;
        }

        if (option.getAttribute("data-client-id") === clientId) {
          postSiteSelect.appendChild(option.cloneNode(true));
        }
      });
    }

    clientSelect.addEventListener("change", filterPostSites);

    <% if (!dispatchInfo) { %>
      filterPostSites();
    <% } %>
  });
</script>

