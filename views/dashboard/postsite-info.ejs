    <style>
        .rotate-icon {
            transition: transform 0.3s ease;
        }

        tr[aria-expanded="true"] .rotate-icon {
            transform: rotate(180deg);
        }

        .accordion-toggle {
            background-color: #f8f9fa;
            transition: background-color 0.3s ease;
        }

        .accordion-toggle:hover {
            background-color: #e9ecef;
        }

        .accordion-body {
            background-color: #f5f5f5;
            padding: 1rem;
            color: #333;
        }

        .rotate-icon {
            transition: transform 0.3s ease;
        }

        tr[aria-expanded="true"] .rotate-icon {
            transform: rotate(180deg);
        }

        .custom-accordion-primary {
            border-left: 4px solid #0d6efd;
        }

        .custom-accordion-secondary {
            border-left: 4px solid #6f42c1;
        }

        .custom-accordion-danger {
            border-left: 4px solid #dc3545;
        }
    </style>

    <script>
        document.querySelectorAll('.accordion-toggle').forEach(row => {
            row.addEventListener('click', function () {
                // Toggle aria-expanded
                const isExpanded = this.getAttribute('aria-expanded') === 'true';
                this.setAttribute('aria-expanded', !isExpanded);
            });
        });
    </script>

    <script>
        document.querySelectorAll('.dropdown-toggle, .dropdown-item').forEach(element => {
            element.addEventListener('click', function (e) {
                e.stopPropagation(); // Prevents the accordion from toggling
            });
        });
    </script>

