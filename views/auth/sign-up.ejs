    <script>
document.addEventListener("DOMContentLoaded", function () {
  const password = document.getElementById("password");
  const cpassword = document.getElementById("cpassword");
  const bar = document.getElementById("passwordStrengthBar");
  const text = document.getElementById("passwordStrengthText");
  const matchText = document.getElementById("passwordMatchText");
  const submitBtn = document.querySelector('button[type="submit"]');

  function checkStrength(value) {
    let score = 0;

    if (value.length >= 8) score++;
    if (/[A-Z]/.test(value)) score++;
    if (/[a-z]/.test(value)) score++;
    if (/[0-9]/.test(value)) score++;
    if (/[^A-Za-z0-9]/.test(value)) score++;

    if (!value) {
      bar.style.width = "0%";
      bar.className = "progress-bar bg-danger";
      text.textContent = "Password strength";
      text.className = "text-danger fw-semibold";
      return false;
    }

    if (score <= 2) {
      bar.style.width = "33%";
      bar.className = "progress-bar bg-danger";
      text.textContent = "Weak password";
      text.className = "text-danger fw-semibold";
      return false;
    }

    if (score === 3 || score === 4) {
      bar.style.width = "66%";
      bar.className = "progress-bar";
      bar.style.backgroundColor = "#8B4513";
      text.textContent = "Normal password";
      text.className = "fw-semibold";
      text.style.color = "#8B4513";
      return false;
    }

    bar.style.width = "100%";
    bar.className = "progress-bar bg-success";
    text.textContent = "Strong password";
    text.className = "text-success fw-semibold";
    return true;
  }

  function checkMatch() {
    if (!cpassword.value) {
      matchText.textContent = "";
      return false;
    }

    if (password.value === cpassword.value) {
      matchText.textContent = "✓ Passwords match";
      matchText.className = "text-success fw-semibold";
      return true;
    }

    matchText.textContent = "✗ Passwords do not match";
    matchText.className = "text-danger fw-semibold";
    return false;
  }

  function validateForm() {
    const strong = checkStrength(password.value);
    const match = checkMatch();

    if (submitBtn) {
      submitBtn.disabled = !(strong && match);
    }
  }

  password.addEventListener("input", validateForm);
  cpassword.addEventListener("input", validateForm);

  validateForm();
});
</script>

</body>

