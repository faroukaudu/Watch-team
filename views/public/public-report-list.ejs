<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= batch.title || "Reports" %></title>
  <link rel="stylesheet" href="/assets/libs/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css">
  <style>
    body {
      background: #0b1220;
      color: #e5edf7;
      font-family: Arial, Helvetica, sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 40px 16px;
    }
    .wrap { max-width: 900px; margin: 0 auto; }
    .cardx {
      background: #111827;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }
    .item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: #172033;
      border: 1px solid rgba(255,255,255,.06);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 12px;
    }
    .item h6 { margin: 0 0 6px; }
    .item p { margin: 0; color: #94a3b8; }
    .open-btn {
      background: #3b82f6;
      color: #fff;
      text-decoration: none;
      border-radius: 10px;
      padding: 10px 14px;
      white-space: nowrap;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="cardx">
      <h3 class="mb-3"><%= batch.title || "Reports" %></h3>
      <p class="text-secondary mb-4">Select a report to view.</p>

      <% reports.forEach(function(report){ %>
        <div class="item">
          <div>
            <h6><%= report.title || "Untitled Report" %></h6>
            <p>
              <strong>Type:</strong> <%= report.category || "general" %> |
              <strong>Date:</strong> <%= report.createdAt ? new Date(report.createdAt).toLocaleString() : "N/A" %>
            </p>
          </div>

          <a class="open-btn" href="/public/report/item/<%= report._id %>?token=<%= batch.token %>">
            Open Report
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>