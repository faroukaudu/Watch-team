<script>
window.currentUserId = <%- JSON.stringify(user && user._id ? String(user._id) : "") %>;
(function(){
  document.addEventListener('DOMContentLoaded', function(){
    if (typeof io !== 'function' || !window.currentUserId) return;
    const notificationSocket = io({auth:{userId:String(window.currentUserId)}});
    notificationSocket.on('notification:new', function(payload){
      const count = Number(payload && payload.unreadCount || 0);
      const bubble=document.getElementById('notificationBellCount');
      const label=document.getElementById('notificationUnreadLabel');
      if(bubble){bubble.textContent=count>99?'99+':count;bubble.classList.toggle('d-none',count<1);bubble.classList.toggle('has-notifications',count>0)}
      if(label) label.textContent=count+' Unread';
      // Deliberately no audio playback.
    });
  });
})();
</script>
