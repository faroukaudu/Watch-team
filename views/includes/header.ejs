            <!-- menu higligh -->
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const currentPath = window.location.pathname;
                    let activeLink = null;

                    document.querySelectorAll(".side-menu__item").forEach(function (link) {
                        const href = link.getAttribute("href");

                        if (!href || href === "javascript:void(0);") return;

                        if (href === currentPath) {
                            activeLink = link;

                            link.classList.add("active");

                            const parentSlide = link.closest(".slide");
                            if (parentSlide) {
                                parentSlide.classList.add("active");
                            }

                            const parentSubMenu = link.closest(".slide-menu");
                            if (parentSubMenu) {
                                parentSubMenu.classList.add("open");
                                parentSubMenu.style.display = "block";

                                const parentHasSub = parentSubMenu.closest(".has-sub");
                                if (parentHasSub) {
                                    parentHasSub.classList.add("active", "open");

                                    const parentMenuItem = parentHasSub.querySelector(":scope > .side-menu__item");
                                    if (parentMenuItem) {
                                        parentMenuItem.classList.add("active");
                                    }
                                }
                            }
                        }
                    });

                    if (activeLink) {
                        setTimeout(function () {
                            activeLink.scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });
                        }, 400);
                    }
                });
            </script>
            <!-- end -->


            <script>

                (function () {
                    const companyId = "<%= user && user.assignedCompanyID ? user.assignedCompanyID : '' %>";
                    const viewerId = "<%= user && user._id ? user._id : '' %>";
                    const list = document.getElementById('header-notification-scroll');
                    const badge = document.getElementById('notifiation-data');
                    let lastUnread = 0;

                    function playNotificationSound() {
                        try {
                            const audio = new Audio('/assets/sounds/notification.wav');
                            audio.play().catch(function () { });
                        } catch (e) { }
                    }

                    async function loadHeaderNotifications() {
                        if (!companyId || !list || !badge) return;
                        try {
                            const res = await fetch(`/api/notifications?companyId=${companyId}&viewerId=${viewerId}`);
                            const data = await res.json();
                            const items = data.notifications || [];
                            const unread = data.unread || 0;
                            badge.innerText = `${unread} Unread`;
                            if (unread > lastUnread) playNotificationSound();
                            lastUnread = unread;
                            list.innerHTML = items.length ? items.map(function (n) {
                                return `<li class="dropdown-item"><div class="d-flex align-items-center gap-3"><span class="avatar avatar-md flex-shrink-0 bg-primary-transparent"><i class="ri-notification-3-line fs-18 lh-1 align-middle"></i></span><div class="flex-grow-1"><div class="fs-13 text-muted"><span class="fw-medium text-default">${n.name || 'System'}</span> ${n.message || n.type || 'activity'}</div><div class="text-muted fw-normal fs-12">${n.email || ''}</div></div></div></li>`;
                            }).join('') : `<li class="dropdown-item text-center text-muted">No New Notifications</li>`;
                        } catch (e) { }
                    }

                    const notificationDrop = document.getElementById('messageDropdown');
                    if (notificationDrop) {
                        notificationDrop.addEventListener('click', async function () {
                            await loadHeaderNotifications();
                            if (companyId && viewerId) {
                                fetch('/api/notifications/clear', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ companyId, viewerId }) }).then(function () {
                                    lastUnread = 0;
                                    if (badge) badge.innerText = '0 Unread';
                                }).catch(function () { });
                            }
                        });
                    }
                    loadHeaderNotifications();
                    setInterval(loadHeaderNotifications, 30000);
                })();
            </script>