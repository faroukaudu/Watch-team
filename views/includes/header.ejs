    typeof user !== "undefined" && user
        ? user
        : typeof userInfo !== "undefined" && userInfo
            ? userInfo
            : null;

/*
 * Menu visibility is role-based only.
 *
 * Super Admin can see every available menu, even when the current
 * subscription does not include that feature. The protected route
 * will display the upgrade popup when necessary.
 *
 * Client-specific menus remain hidden according to the Client rules.
 * Platform Admin retains access to everything.
 */
const canViewWatchModeMenu = Boolean(
    currentUser &&
    currentUser.userType !== "Client"
);
