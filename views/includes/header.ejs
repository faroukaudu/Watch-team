            <script>
                document.addEventListener("click", function (e) {
                    const item = e.target.closest(".set-lang");
                    if (!item) return;

                    const lang = item.getAttribute("data-lang");
                    localStorage.setItem("watchteam_lang", lang);

                    alert("Language saved. Full translation will be enabled in the next update.");
                });
