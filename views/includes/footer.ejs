<% if (typeof accessModal !== "undefined" && accessModal) { %>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  const accessModal = <%- JSON.stringify(accessModal) %>;
  const options = {
    icon: accessModal.type === "upgrade" ? "info" : "warning",
    title: accessModal.title || "Access Restricted",
    text: accessModal.message || "You do not have permission to view this page.",
    confirmButtonText: accessModal.confirmText || "Okay",
    allowOutsideClick: false,
    allowEscapeKey: false
  };

  if (accessModal.cancelText) {
    options.showCancelButton = true;
    options.cancelButtonText = accessModal.cancelText;
  }

  Swal.fire(options).then(function (result) {
    if (result.isConfirmed && accessModal.confirmUrl) {
      window.location.href = accessModal.confirmUrl;
    }
  });
});
</script>
<% } %>
